ex:Q1 a ex:ResearchQuestion ;
    rdfs:label "Does increased connectivity add predictive information?" ;
    ex:resolution "Support within the evaluated datasets; causal mechanism and clinical utility unresolved." .

ex:Q3 a ex:ResearchQuestion ;
    rdfs:label "Can public CNP data support reusable standardized preprocessing?" .

