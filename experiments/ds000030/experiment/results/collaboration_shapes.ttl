@prefix sh:<http://www.w3.org/ns/shacl#>. @prefix ex:<urn:repronim:illustrative:>. @prefix prov:<http://www.w3.org/ns/prov#>. ex:ReviewShape a sh:NodeShape;sh:targetClass ex:EvidenceAssessment;sh:property [sh:path prov:wasAttributedTo;sh:minCount 1;sh:class prov:Person];sh:property [sh:path prov:wasGeneratedBy;sh:minCount 1;sh:class prov:Activity];sh:property [sh:path ex:target;sh:minCount 1];sh:property [sh:path prov:wasDerivedFrom;sh:minCount 1];sh:property [sh:path ex:verdict;sh:minCount 1].