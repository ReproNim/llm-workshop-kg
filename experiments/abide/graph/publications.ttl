@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <urn:repronim:abide:> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:repronim:abide:abstract/ohbm2026/1217/claim/0> a ex:AbstractClaim ;
    rdfs:label "Major depressive disorder is a devastating psychiatric condition that frequently proves refractory to conventional treatments, such as antidepressant medications and psychotherapy." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Major depressive disorder is a devastating psychiatric condition that frequently proves refractory to conventional treatments, such as antidepressant medications and psychotherapy." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1217> .

<urn:repronim:abide:abstract/ohbm2026/1217/claim/1> a ex:AbstractClaim ;
    rdfs:label "The subcallosal cingulate area is the most-studied DBS target for treatment-resistant depression." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "with the subcallosal cingulate area (SCC) constituting the most-studied DBS target for this purpose." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1217> .

<urn:repronim:abide:abstract/ohbm2026/1217/claim/10> a ex:AbstractClaim ;
    rdfs:label "Acquired fMRI data were preprocessed using BRANT, a Statistical Parametric Mapping-based rsfMRI toolbox." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Acquired fMRI data were preprocessed using BRANT (http://brant.brainnetome.org/), a Statistical Parametric Mapping (SPM)-based rsfMRI toolbox." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1217> .

<urn:repronim:abide:abstract/ohbm2026/1217/claim/11> a ex:AbstractClaim ;
    rdfs:label "Two seed-based functional connectivity analyses were performed." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Two seed-based functional connectivity analyses were performed to understand the potential impact of SCC-DBS on functional brain architecture." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1217> .

<urn:repronim:abide:abstract/ohbm2026/1217/claim/12> a ex:AbstractClaim ;
    rdfs:label "A total of 16 SCC-DBS patients were scanned with 3T fMRI under active and inactive stimulation conditions." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "A total of 16 SCC-DBS patients were scanned with 3T fMRI under active and inactive stimulation conditions (age: 42.9±12.9 years; sex: 94% female; disease duration: 17.7±8.3 years; surgery-to-scan interval: 7.3±4.7 years; proportion of responders: 69%)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1217> .

<urn:repronim:abide:abstract/ohbm2026/1217/claim/13> a ex:AbstractClaim ;
    rdfs:label "Active stimulation was associated with increased connectivity between SCC and rostral ACC, orbitofrontal cortex, insula, and frontal operculum." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Specifically, participants tended to exhibit increased connectivity between SCC and rostral ACC, orbitofrontal cortex, insula, and frontal operculum in the DBS-ON state," ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1217> .

<urn:repronim:abide:abstract/ohbm2026/1217/claim/14> a ex:AbstractClaim ;
    rdfs:label "Participants tended to exhibit decreased connectivity between SCC and right middle frontal gyrus and superior and inferior parietal lobule in the DBS-ON state." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "while showing decreased connectivity between SCC and right middle frontal gyrus and superior and inferior parietal lobule (Figure 2)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1217> .

<urn:repronim:abide:abstract/ohbm2026/1217/claim/15> a ex:AbstractClaim ;
    rdfs:label "DBS responders and non-responders differed with respect to the extent of stimulation-linked salience network change." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "However, DBS responders and non-responders did significantly differ with respect to the extent of stimulation-linked salience network change (t = -2.35, p = 0.034)," ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1217> .

<urn:repronim:abide:abstract/ohbm2026/1217/claim/16> a ex:AbstractClaim ;
    rdfs:label "Responders generally exhibited salience network contraction with active stimulation." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "with responders (mean relative salience network change from DBS-OFF: -13.7±25.1%) but not non-responders (mean relative salience network change from DBS-OFF: 24.7±42.9%) generally exhibiting salience network contraction with active stimulation." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1217> .

<urn:repronim:abide:abstract/ohbm2026/1217/claim/17> a ex:AbstractClaim ;
    rdfs:label "The extent of reduction in salience network size was associated with relative HAMD-17 reduction from baseline and HAMD-17 score at 12 months follow-up." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "the extent of reduction in salience network size was associated with both relative HAMD-17 reduction from baseline (R = -0.52, R2 = 0.27, p = 0.039) and HAMD-17 score itself (R = 0.57, R2 = 0.32, p =0.022) at 12 months follow-up;" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1217> .

<urn:repronim:abide:abstract/ohbm2026/1217/claim/18> a ex:AbstractClaim ;
    rdfs:label "The salience network has previously been shown to be aberrantly enlarged in depression." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "The salience network has previously been shown to be aberrantly enlarged in depression." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1217> .

<urn:repronim:abide:abstract/ohbm2026/1217/claim/2> a ex:AbstractClaim ;
    rdfs:label "High-frequency SCC-DBS can produce clinically meaningful and durable clinical improvement in roughly 60% of treated patients." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Decades of research indicate that high-frequency SCC-DBS is able to bring about clinically meaningful and durable clinical improvement in roughly 60% of treated patients." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1217> .

<urn:repronim:abide:abstract/ohbm2026/1217/claim/3> a ex:AbstractClaim ;
    rdfs:label "Active SCC-DBS decreased activity within the dorsal ACC, posterior cingulate cortex, and precuneus." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "In particular, active SCC-DBS decreased activity within the dorsal ACC, posterior cingulate cortex, and precuneus." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1217> .

<urn:repronim:abide:abstract/ohbm2026/1217/claim/4> a ex:AbstractClaim ;
    rdfs:label "This study interrogated the impact of SCC-DBS on functional connectivity within the brain using fMRI." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "This study interrogated the impact of SCC-DBS on functional connectivity within the brain using fMRI." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1217> .

<urn:repronim:abide:abstract/ohbm2026/1217/claim/5> a ex:AbstractClaim ;
    rdfs:label "Active SCC-DBS may reduce the footprint of the salience network." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "we specifically hypothesized that active SCC-DBS may reduce the footprint of this RSN." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1217> .

<urn:repronim:abide:abstract/ohbm2026/1217/claim/6> a ex:AbstractClaim ;
    rdfs:label "Toronto Western Hospital patients with implanted SCC-DBS devices were recruited for fMRI scanning." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Toronto Western Hospital patients who were actively using implanted SCC-DBS devices were recruited for fMRI scanning under the umbrella of institutional REB approval (UHN: #14-8255)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1217> .

<urn:repronim:abide:abstract/ohbm2026/1217/claim/7> a ex:AbstractClaim ;
    rdfs:label "Participants underwent a single 3 Tesla MRI scanning session." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Participants underwent a single 3 Tesla MRI (General Electric Signa HDxt) scanning session," ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1217> .

<urn:repronim:abide:abstract/ohbm2026/1217/claim/8> a ex:AbstractClaim ;
    rdfs:label "One rsfMRI scan was obtained with the DBS device turned off and the other with the device turned on at clinically determined optimal settings." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "One rsfMRI scan was obtained with the participant’s DBS device turned off (DBS-OFF), the other with their device turned on at clinically determined optimal settings (DBS-ON)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1217> .

<urn:repronim:abide:abstract/ohbm2026/1217/claim/9> a ex:AbstractClaim ;
    rdfs:label "A 5-min washout period was observed between each DBS setting change and the initiation of the related rsfMRI scan." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "A 5-min washout period was observed between each DBS setting change and the initiation of the related rsfMRI scan." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1217> .

<urn:repronim:abide:abstract/ohbm2026/15/claim/0> a ex:AbstractClaim ;
    rdfs:label "T1-weighted images from 175 ADHD patients (mean age=11.77) and 178 TD subjects (mean age=11.78) from the ADHD-200 dataset were processed using FreeSurfer." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "T1-weighted images from 175 ADHD patients (mean age=11.77) and 178 TD subjects (mean age=11.78) from the ADHD-200 dataset were processed using FreeSurfer." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/15> .

<urn:repronim:abide:abstract/ohbm2026/15/claim/1> a ex:AbstractClaim ;
    rdfs:label "Resting-state fMRI preprocessing included skull stripping, slice-time correction, nuisance regression, and bandpass filtering." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Resting-state fMRI was performed with C-PAC and included skull stripping, slice-time correction, nuisance regression (motion, white matter, CSF), and bandpass filtering (0.01–0.1 Hz)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/15> .

<urn:repronim:abide:abstract/ohbm2026/15/claim/10> a ex:AbstractClaim ;
    rdfs:label "Effective connectivity was bidirectional and distributed, suggesting atypical reciprocal coupling across subcortical hubs." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Effective connectivity was bidirectional and distributed, suggesting atypical reciprocal coupling across subcortical hubs." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/15> .

<urn:repronim:abide:abstract/ohbm2026/15/claim/11> a ex:AbstractClaim ;
    rdfs:label "ASD and ADHD exhibit distinct modes of subcortico–cortical dysconnectivity." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "ASD and ADHD exhibit distinct modes of subcortico–cortical dysconnectivity." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/15> .

<urn:repronim:abide:abstract/ohbm2026/15/claim/12> a ex:AbstractClaim ;
    rdfs:label "ADHD is characterized by unidirectional communication, whereas ASD shows broad reciprocal reorganization." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "ADHD is characterized by unidirectional communication, whereas ASD shows broad reciprocal reorganization." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/15> .

<urn:repronim:abide:abstract/ohbm2026/15/claim/13> a ex:AbstractClaim ;
    rdfs:label "These findings extend prior models of disrupted hierarchical control and highlight candidate biomarkers for differential diagnosis and circuit-specific intervention strategies in neurodevelopmental disorders." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "These findings extend prior models of disrupted hierarchical control and highlight candidate biomarkers for differential diagnosis and circuit-specific intervention strategies in neurodevelopmental disorders." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/15> .

<urn:repronim:abide:abstract/ohbm2026/15/claim/14> a ex:AbstractClaim ;
    rdfs:label "The first author does not meet the eligibility requirements and will not apply for the award." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000352> ;
    ex:sourceQuote "No - the first author does not meet the eligibility requirements and will not apply for the award." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/15> .

<urn:repronim:abide:abstract/ohbm2026/15/claim/2> a ex:AbstractClaim ;
    rdfs:label "The thalamus and basal ganglia were subdivided using the Tian atlas." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "The thalamus and basal ganglia were subdivided using the Tian atlas (8 and 10 subdivisions per hemisphere)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/15> .

<urn:repronim:abide:abstract/ohbm2026/15/claim/3> a ex:AbstractClaim ;
    rdfs:label "Group differences in functional connectivity were first assessed at the whole-structure level and then refined using dominance analysis." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Group differences in FC were first assessed at the whole-structure level and then refined using dominance analysis to identify subdivisions driving the effects (Fig. 1a)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/15> .

<urn:repronim:abide:abstract/ohbm2026/15/claim/4> a ex:AbstractClaim ;
    rdfs:label "Directional influences were estimated using rDCM among key cortical-subcortical nodes." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Directional influences were estimated using rDCM among key cortical-subcortical nodes. (Fig. 2a)" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/15> .

<urn:repronim:abide:abstract/ohbm2026/15/claim/5> a ex:AbstractClaim ;
    rdfs:label "In ADHD, FC showed mixed alterations with increases in lateral prefrontal and parietal regions and decreases in medial prefrontal and temporal areas." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "In ADHD, FC showed mixed alterations: increases in lateral prefrontal and parietal regions and decreases in medial prefrontal and temporal areas." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/15> .

<urn:repronim:abide:abstract/ohbm2026/15/claim/6> a ex:AbstractClaim ;
    rdfs:label "ADHD basal ganglia-cortical circuits exhibited hyperconnectivity in lateral frontal and insular regions and hypoconnectivity in the posterior cingulate and occipital cortex." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Basal ganglia–cortical circuits exhibited hyperconnectivity in lateral frontal and insular regions and hypoconnectivity in the posterior cingulate and occipital cortex." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/15> .

<urn:repronim:abide:abstract/ohbm2026/15/claim/7> a ex:AbstractClaim ;
    rdfs:label "Dominance analysis identified the dorsal caudate and putamen as primary drivers of these abnormalities." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Dominance analysis identified the dorsal caudate and putamen as primary drivers of these abnormalities (Fig. 1b, c)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/15> .

<urn:repronim:abide:abstract/ohbm2026/15/claim/8> a ex:AbstractClaim ;
    rdfs:label "ADHD was characterized by a unidirectional bias: projections from the dorsal thalamus to the cortex and from the cortex to the basal ganglia were preserved." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "ADHD was characterized by a unidirectional bias: projections from the dorsal thalamus to the cortex and from the cortex to the basal ganglia were preserved (Fig. 2b, c)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/15> .

<urn:repronim:abide:abstract/ohbm2026/15/claim/9> a ex:AbstractClaim ;
    rdfs:label "In ASD, connectivity alterations were more widespread, showing robust increases linking the thalamus and basal ganglia with dorsomedial/dorsolateral prefrontal, parietal, and temporal cortices, together with focal decreases in ventromedial prefrontal and occipitotemporal regions." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "In ASD, connectivity alterations were more widespread, showing robust increases linking the thalamus and basal ganglia with dorsomedial/dorsolateral prefrontal, parietal, and temporal cortices, together with focal decreases in ventromedial prefrontal and occipitotemporal regions (Fig. 1b, c)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/15> .

<urn:repronim:abide:abstract/ohbm2026/1673/claim/0> a ex:AbstractClaim ;
    rdfs:label "Autism spectrum disorders are a group of neurodevelopmental disorders characterized by persistent deficits in social interaction and communication, as well as restricted and repetitive patterns of behavior." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Autism spectrum disorders (ASD) are a group of neurodevelopmental disorders characterized by persistent deficits in social interaction and communication, as well as restricted and repetitive patterns of behavior (RRB)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1673> .

<urn:repronim:abide:abstract/ohbm2026/1673/claim/1> a ex:AbstractClaim ;
    rdfs:label "The study used data from the ABIDE I and ABIDE II datasets." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The data used in this study were drawn from the ABIDE I and ABIDE II datasets^(2)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1673> .

<urn:repronim:abide:abstract/ohbm2026/1673/claim/2> a ex:AbstractClaim ;
    rdfs:label "The sample included 455 individuals with ASD and 442 typically developing controls between 5 and 25 years old." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "455 individuals with ASD and 442 typically developing controls (TDC) between 5 and 25 years of old remained for the analysis." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1673> .

<urn:repronim:abide:abstract/ohbm2026/1673/claim/3> a ex:AbstractClaim ;
    rdfs:label "The study found robust cross-validated age-prediction correlations in the training samples for both ASD and TDC." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Cross‑validated correlations between predicted and chronological age were robust in the training samples (ASD: r = 0.7733 ± 0.0445; TDC: r = 0.6943 ± 0.0807)" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1673> .

<urn:repronim:abide:abstract/ohbm2026/1673/claim/4> a ex:AbstractClaim ;
    rdfs:label "The study found moderate cross-validated age-prediction correlations in the test samples for both ASD and TDC." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "and remained moderate in the test samples (ASD: r = 0.5027 ± 0.0630; TDC: r = 0.4854 ± 0.0641)" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1673> .

<urn:repronim:abide:abstract/ohbm2026/1673/claim/5> a ex:AbstractClaim ;
    rdfs:label "In TDC, developmental sensitivity was strongly modularized." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In TDCs, developmental sensitivity was strongly modularized:" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1673> .

<urn:repronim:abide:abstract/ohbm2026/1673/claim/6> a ex:AbstractClaim ;
    rdfs:label "In ASD, the sensitivity between DAN and other networks was significantly diminished." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The sensitivity between DAN and other networks was significantly diminished." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1673> .

<urn:repronim:abide:abstract/ohbm2026/1673/claim/7> a ex:AbstractClaim ;
    rdfs:label "More accelerated brain age was associated with lower autism symptom severity." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "we observed that more accelerated brain age was associated with lower autism symptom severity:" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1673> .

<urn:repronim:abide:abstract/ohbm2026/1673/claim/8> a ex:AbstractClaim ;
    rdfs:label "BAG showed negative associations with ADOS_GOTHAM_RRB scores." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "BAG showed negative associations with ADOS_GOTHAM_RRB scores (left; r = -0.143, p = 0.0191, n = 270)" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1673> .

<urn:repronim:abide:abstract/ohbm2026/1674/claim/0> a ex:AbstractClaim ;
    rdfs:label "Autism Spectrum Disorder is a complex neurodevelopmental condition characterized by widely reported abnormalities in brain network connectivity." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Autism Spectrum Disorder (ASD) is a complex neurodevelopmental condition characterized by widely reported abnormalities in brain network connectivity." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1674> .

<urn:repronim:abide:abstract/ohbm2026/1674/claim/1> a ex:AbstractClaim ;
    rdfs:label "Dynamic functional connectivity analysis has revealed that connectivity alterations in ASD exhibit distinct patterns across different connectivity states." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "In recent years, advances in dynamic functional connectivity analysis have revealed that connectivity alterations in ASD exhibit distinct patterns across different connectivity states." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1674> .

<urn:repronim:abide:abstract/ohbm2026/1674/claim/2> a ex:AbstractClaim ;
    rdfs:label "Dynamic phase synchronization analysis provides a framework for investigating brain function abnormalities in ASD." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Against this backdrop, dynamic phase synchronization analysis provides a powerful framework for investigating brain function abnormalities in ASD." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1674> .

<urn:repronim:abide:abstract/ohbm2026/1674/claim/3> a ex:AbstractClaim ;
    rdfs:label "LEiDA extracts the leading eigenvector from each time point's phase synchronization matrix." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Leading Eigenvector Dynamics Analysis (LEiDA)^(1) extracts the leading eigenvector from each time point's phase synchronization matrix, representing the dominant global pattern, and then clustering these eigenvectors to identify several recurring brain states." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1674> .

<urn:repronim:abide:abstract/ohbm2026/1674/claim/4> a ex:AbstractClaim ;
    rdfs:label "The study analyzed resting-state fMRI data from 264 male subjects across 7 sites in ABIDE II." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Data: We analyzed resting-state fMRI data of 264 male subjects (132 ASD, 132 healthy controls (CON)) from 7 sites of the ABIDE II dataset,^(2) with full IQ higher than 80 and age/IQ matching within each site." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1674> .

<urn:repronim:abide:abstract/ohbm2026/1674/claim/5> a ex:AbstractClaim ;
    rdfs:label "There were 184 subjects with Social Responsiveness Scale T scores." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "There were 184 subjects (92 ASD, 92 CON) having records of Social Responsiveness Scale (SRS) T scores." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1674> .

<urn:repronim:abide:abstract/ohbm2026/1674/claim/6> a ex:AbstractClaim ;
    rdfs:label "The SC-LEiDA method was applied to IMF2, IMF3, IMF4, and IMF5." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The SC-LEiDA was applied to the IMF2 (0.059 ± 0.005Hz), IMF3 (0.031 ± 0.004Hz), IMF4 (0.017 ± 0.002Hz) and IMF5 (0.011 ± 0.002Hz), as the frequency ranges of these IMFs fall within the conventional bandwidth used for computing functional connectivity." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1674> .

<urn:repronim:abide:abstract/ohbm2026/1674/claim/7> a ex:AbstractClaim ;
    rdfs:label "The distance between two time points in the similarity graph is defined as the absolute value of the Pearson correlation coefficient between their corresponding leading eigenvectors." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "The distance between two time points in the similarity graph is defined as the absolute value of the Pearson correlation coefficient between their corresponding leading eigenvectors." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1674> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/0> a ex:AbstractClaim ;
    rdfs:label "The discovery cohort included resting-state fMRI data and clinical measurements from 1227 autism individuals and 326 typically developing individuals." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The discovery cohort included resting-state fMRI data and clinical measurements from 1227 autism individuals and 326 typically developing (TD) individuals," ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/1> a ex:AbstractClaim ;
    rdfs:label "The early childhood group consisted of 929 autism individuals and 147 typically developing individuals." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The early childhood group consisted of 929 autism individuals (768 males, mean age ± SD = 3.67 ± 1.13 years) and 147 TD individuals (68 males, mean age ± SD = 3.94 ± 1.37 years)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/10> a ex:AbstractClaim ;
    rdfs:label "Left-lateralized DCLS abnormalities in autism were significant during later childhood but not during early childhood." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Hemispheric comparison further revealed left-lateralized DCLS abnormalities in autism, which were significant during the later childhood (_t_(122)=4.05, _PFDR_ =4.4e-05, Fig. 2b), but not during early childhood (_t_(122)=1.85,_PFDR_ =0.067, Fig. 2a)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/11> a ex:AbstractClaim ;
    rdfs:label "In the validation sample, both the effect size brain map and the left-lateralized DCLS abnormalities observed in later childhood were successfully reproduced." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In the validation sample (ABIDE cohort), both the effect size brain map and the left-lateralized DCLS abnormalities observed in later childhood were successfully reproduced, showing a high spatial correlation (_r_=0.421, _p_=5.2e-12) and significant left-lateralization (_t_(122)=5.14, _p_=1.0e-06)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/12> a ex:AbstractClaim ;
    rdfs:label "Significant group difference on lnVR was observed in only one brain region during early childhood." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Significant group difference on lnVR was observed in only one brain region during early childhood (middle temporal gyrus, MTG, lnVR=0.252, 95%CI=[0.004, 0.499], Fig. 2c)," ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/13> a ex:AbstractClaim ;
    rdfs:label "During later childhood, 14 regions showed higher DCLS variability in autism compared with TD individuals." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "During later childhood, this pattern became more widespread, with 14 regions showing higher (largest lnVR: left parahippocampal gyrus=0.414, 95%CI=[0.153, 0.680])" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/14> a ex:AbstractClaim ;
    rdfs:label "During later childhood, 6 regions showed lower DCLS variability in autism compared with TD individuals." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "and 6 regions showing lower (smallest lnVR: right orbital gyrus=-0.337, 95%CI=[-0.600, -0.073]) DCLS variability in autism compared with TD individuals" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/15> a ex:AbstractClaim ;
    rdfs:label "Autism individuals showed comparable DCLS variability to TD individuals during early childhood." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "At the network level, autism individuals showed comparable DCLS variability to TD individuals during early childhood (|mean lnVR values|<0.1, Fig. 2c)," ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/16> a ex:AbstractClaim ;
    rdfs:label "Autism individuals exhibited greater DCLS variability during later childhood, particularly in the left hemisphere within the VAN and LIM." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "but exhibited greater variability during later childhood, particularly in the left hemisphere within the VAN (mean lnVR=0.175) and LIM (mean lnVR=0.183) (Fig. 2d)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/17> a ex:AbstractClaim ;
    rdfs:label "The lnVR map showed a significant spatial correlation with the effect size map of case-control DCLS differences during early childhood." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Moreover, the lnVR map showed a significant spatial correlation with the effect size map of case–control DCLS differences across the whole-brain during later childhood (_r_=0.026, _PFDR_ =0.686, Fig. 2f), but not during early childhood (_r_=0.277, _PFDR_ =2.0e-05, Fig. 2e)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/18> a ex:AbstractClaim ;
    rdfs:label "The lnVR map did not show a significant spatial correlation with the effect size map of case-control DCLS differences during later childhood." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Moreover, the lnVR map showed a significant spatial correlation with the effect size map of case–control DCLS differences across the whole-brain during later childhood (_r_=0.026, _PFDR_ =0.686, Fig. 2f), but not during early childhood (_r_=0.277, _PFDR_ =2.0e-05, Fig. 2e)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/19> a ex:AbstractClaim ;
    rdfs:label "Inter-subject similarity of whole-brain DCLS deviations among autism individuals increased significantly with age during later childhood." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We further calculated the inter-subject similarity of whole-brain DCLS deviations among autism individuals, which increased significantly with age during later childhood (_r_=0.294, _PFDR_=4.9e-09, Fig. 2g)," ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/2> a ex:AbstractClaim ;
    rdfs:label "The later childhood group consisted of 298 autism individuals and 179 typically developing individuals." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The later childhood group consisted of 298 autism individuals (245 males, mean age ± SD = 7.93 ± 1.68 years) and 179 TD individuals (70 males, mean age ± SD = 8.72 ± 1.79 years)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/20> a ex:AbstractClaim ;
    rdfs:label "Inter-subject similarity of whole-brain DCLS deviations among autism individuals did not increase significantly with age during early childhood." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "but not during early childhood (_r_=0.054, _PFDR_=0.10)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/3> a ex:AbstractClaim ;
    rdfs:label "An independent cohort of later childhood participants was selected from six sites of Autism Brain Imaging Data Exchange (ABIDE)-I and II as validation cohort." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "An independent cohort of later childhood participants (6 < age ≤ 14 years; 56 autism: mean age ± SD = 10.77 ± 1.82 years and 97 TD: mean age ± SD = 10.75 ± 1.82 years) was selected from six sites of Autism Brain Imaging Data Exchange (ABIDE)-I and II as validation cohort." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/4> a ex:AbstractClaim ;
    rdfs:label "Dynamic conditional correlation was applied to calculate the dynamic connectome matrices for each time point." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Thereafter, dynamic conditional correlation (DCC) was applied to calculate the dynamic connectome matrixes for each time point," ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/5> a ex:AbstractClaim ;
    rdfs:label "The DCLS index was subsequently calculated to quantify the degree of lateralization at the hemispheric connectome-scale for each brain region." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "and the DCLS index was subsequently calculated to quantify the degree of lateralization at the hemispheric connectome-scale for each brain region." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/6> a ex:AbstractClaim ;
    rdfs:label "Compared with TD controls, autism individuals exhibited significantly greater DCLS values in 20 regions during early childhood." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Compared with TD controls, autism individuals exhibited significantly greater DCLS valuesin 20 regions during early childhood" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/7> a ex:AbstractClaim ;
    rdfs:label "Compared with TD controls, autism individuals exhibited significantly greater DCLS values in 46 regions during later childhood." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "and 46 regions during later childhood" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/8> a ex:AbstractClaim ;
    rdfs:label "During early childhood, increased DCLS was mainly observed in the left FPN and right DMN." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "increased DCLS was mainly observed in the left FPN and right DMN" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1693/claim/9> a ex:AbstractClaim ;
    rdfs:label "During later childhood, higher DCLS was found in the left DMN, DAN, VAN, and FPN, as well as in the right DMN." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "whereas during later childhood group, higher DCLS was found in the left DMN, DAN, VAN, and FPN, as well as in the right DMN" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1693> .

<urn:repronim:abide:abstract/ohbm2026/1696/claim/0> a ex:AbstractClaim ;
    rdfs:label "The study utilized a large multi-site dataset from the Autism Brain Imaging Data Exchange (ABIDE) initiative." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The study utilized a large multi-site dataset from the Autism Brain Imaging Data Exchange (ABIDE) initiative." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1696> .

<urn:repronim:abide:abstract/ohbm2026/1696/claim/1> a ex:AbstractClaim ;
    rdfs:label "We compiled a Typically Developing (TD) cohort (N=412) for model training and testing, and an independent ASD cohort (N=345) for clinical application." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We compiled a Typically Developing (TD) cohort (N=412) for model training and testing, and an independent ASD cohort (N=345) for clinical application." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1696> .

<urn:repronim:abide:abstract/ohbm2026/1696/claim/10> a ex:AbstractClaim ;
    rdfs:label "The Potential Unfulfilled group had a significantly higher median FIQ (117.9) than the Effective Compensation group (66.8; p < 0.001, FDR-corrected)." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The \"Potential Unfulfilled\" (Over-predicted) group had a significantly higher median FIQ (117.9) compared to the \"Effective Compensation\" (Under-predicted) group (66.8; p < 0.001, FDR-corrected), validating the grouping strategy." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1696> .

<urn:repronim:abide:abstract/ohbm2026/1696/claim/11> a ex:AbstractClaim ;
    rdfs:label "The Effective Compensation group showed significantly greater surface area in the Left Entorhinal Cortex." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Surface Area Expansion (Under > Over):** The Effective Compensation group showed significantly greater surface area in limbic and prefrontal regions (p < 0.05, uncorrected), including the **Left Entorhinal Cortex** (p=0.036), a hub for memory; the **Left Medial Orbitofrontal** (p=0.008) and **Right Lateral Orbitofrontal Cortex** (p=0.036), implicating decision-making circuits; and the **Left Frontal Pole** (p=0.038)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1696> .

<urn:repronim:abide:abstract/ohbm2026/1696/claim/12> a ex:AbstractClaim ;
    rdfs:label "The Effective Compensation group showed significantly greater thickness in the Left Superior Frontal Gyrus." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Cortical Thickness Preservation (Under > Over):** The Effective Compensation group displayed greater thickness in executive control regions, including the **Left Superior Frontal Gyrus** (p=0.004) and **Right Superior Frontal Gyrus** (p=0.049)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1696> .

<urn:repronim:abide:abstract/ohbm2026/1696/claim/13> a ex:AbstractClaim ;
    rdfs:label "The Right Pallidum was larger in the Effective Compensation group." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Subcortical Volume:** The **Right Pallidum** was larger in the Effective Compensation group (p=0.023)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1696> .

<urn:repronim:abide:abstract/ohbm2026/1696/claim/14> a ex:AbstractClaim ;
    rdfs:label "The Potential Unfulfilled group showed greater thickness only in the Right Isthmus Cingulate." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Inverse Pattern:** Conversely, the \"Potential Unfulfilled\" group showed greater thickness only in the **Right Isthmus Cingulate** (p=0.007)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1696> .

<urn:repronim:abide:abstract/ohbm2026/1696/claim/2> a ex:AbstractClaim ;
    rdfs:label "We employed Gaussian Process Regression (GPR) with an exponential kernel to establish a normative model of the FreeSurfer-derived morphometric features (surface area, thickness, and volumes) based on 336 features." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We employed Gaussian Process Regression (GPR) with an exponential kernel to establish a normative model of the FreeSurfer-derived morphometric features (surface area, thickness, and volumes) based on 336 features." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1696> .

<urn:repronim:abide:abstract/ohbm2026/1696/claim/3> a ex:AbstractClaim ;
    rdfs:label "The model was trained on 247 TD subjects using 5-fold cross-validation and validated on an independent TD test set (N = 165)." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The model was trained on 247 TD subjects using 5-fold cross-validation and validated on an independent TD test set (N = 165)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1696> .

<urn:repronim:abide:abstract/ohbm2026/1696/claim/4> a ex:AbstractClaim ;
    rdfs:label "A linear bias correction using polynomial fitting was applied to the predicted scores." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "a linear bias correction (using polynomial fitting) was applied to the predicted scores." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1696> .

<urn:repronim:abide:abstract/ohbm2026/1696/claim/5> a ex:AbstractClaim ;
    rdfs:label "The prediction error was defined as Predicted FIQ - Actual FIQ." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "the prediction error, which is the difference between the predicted and actual FIQ values, Predicted FIQ - Actual FIQ." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1696> .

<urn:repronim:abide:abstract/ohbm2026/1696/claim/6> a ex:AbstractClaim ;
    rdfs:label "The overall standard deviation of the pooled prediction errors was 0.1944." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "the overall standard deviation of the pooled prediction errors (Overall SD), which was determined to be 0.1944." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1696> .

<urn:repronim:abide:abstract/ohbm2026/1696/claim/7> a ex:AbstractClaim ;
    rdfs:label "The Potential Unfulfilled group consisted of 11 individuals." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "This subgroup consisted of N = 11 individuals." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1696> .

<urn:repronim:abide:abstract/ohbm2026/1696/claim/8> a ex:AbstractClaim ;
    rdfs:label "The Effective Compensation group consisted of 34 individuals." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "This subgroup consisted of N = 34 individuals." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1696> .

<urn:repronim:abide:abstract/ohbm2026/1696/claim/9> a ex:AbstractClaim ;
    rdfs:label "The remaining 300 individuals were categorized as the Typical-predict group." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The remaining N = 300 individuals, whose prediction errors fell within the range, were categorized as the Typical-predict group." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1696> .

<urn:repronim:abide:abstract/ohbm2026/1719/claim/0> a ex:AbstractClaim ;
    rdfs:label "Autism is a neurodevelopmental disorder characterized by social interaction and communication difficulties, as well as restrictive and/or repetitive behaviors or interests (RRBI)." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Autism is a neurodevelopmental disorder characterized by social interaction and communication difficulties, as well as restrictive and/or repetitive behaviors or interests (RRBI)" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1719> .

<urn:repronim:abide:abstract/ohbm2026/1719/claim/1> a ex:AbstractClaim ;
    rdfs:label "The habenula plays a crucial role in motivation and emotion." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "the habenula (Hb), a small epithalamic structure that plays a crucial role in motivation and emotion" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1719> .

<urn:repronim:abide:abstract/ohbm2026/1719/claim/2> a ex:AbstractClaim ;
    rdfs:label "The habenula is enlarged structurally among autistic individuals." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "the habenula (Hb), a small epithalamic structure that plays a crucial role in motivation and emotion^(3)[](https://www.zotero.org/google-docs/?gVfUXO), is enlarged structurally among autistic individuals" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1719> .

<urn:repronim:abide:abstract/ohbm2026/1719/claim/3> a ex:AbstractClaim ;
    rdfs:label "The habenula is barely larger than a single voxel in many neuroimaging studies." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:sourceQuote "the habenula is barely larger than a single voxel in many neuroimaging studies (i.e., ~27mm^(3) per hemisphere)" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1719> .

<urn:repronim:abide:abstract/ohbm2026/1719/claim/4> a ex:AbstractClaim ;
    rdfs:label "The atlas-based Hb analysis included 1,586 participants, with 705 diagnosed with ASD." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The atlas-based Hb analysis included 1,586 participants, with 705 diagnosed with autism spectrum disorder (ASD; mean age = 13.88 ± 8.15 years)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1719> .

<urn:repronim:abide:abstract/ohbm2026/1719/claim/5> a ex:AbstractClaim ;
    rdfs:label "The manually-delineated, subject-specific Hb analysis included 1,060 participants, with 475 ASD." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The manually-delineated, subject-specific Hb analysis included 1,060 participants (N = 475 ASD; mean age = 15.97 ± 8.40 years)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1719> .

<urn:repronim:abide:abstract/ohbm2026/1719/claim/6> a ex:AbstractClaim ;
    rdfs:label "Positive Hb connectivity was most pronounced in the thalamus and extended through the substantia nigra, anterior cingulate cortex, and striatal regions." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "positive Hb connectivity was most pronounced in the thalamus and extended through the substantia nigra (SN), anterior cingulate cortex (ACC, BA 31), and striatal regions" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1719> .

<urn:repronim:abide:abstract/ohbm2026/1719/claim/7> a ex:AbstractClaim ;
    rdfs:label "Compared to NTs, autistic participants exhibited significantly increased Hb connectivity within the auditory cortex." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Compared to NTs, autistic participants exhibited significantly increased Hb connectivity within the auditory cortex." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1719> .

<urn:repronim:abide:abstract/ohbm2026/1727/claim/0> a ex:AbstractClaim ;
    rdfs:label "Schizophrenia-spectrum disorders (SSD) and bipolar disorder (BD) show substantial overlap across multiple clinical domains, including psychotic, cognitive, negative, and mood symptoms, that cut across traditional disease categories." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Schizophrenia-spectrum disorders (SSD) and bipolar disorder (BD) show substantial overlap across multiple clinical domains, including psychotic, cognitive, negative, and mood symptoms, that cut across traditional disease categories." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1727> .

<urn:repronim:abide:abstract/ohbm2026/1727/claim/1> a ex:AbstractClaim ;
    rdfs:label "Large-scale brain networks can be further described along principal axes of cortical organization using functional gradients, which reduce high-dimensional connectivity profiles to continuous axes capturing dominant modes of cortical variation across the cortex." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Large-scale brain networks can be further described along principal axes of cortical organization using functional gradients, which reduce high-dimensional connectivity profiles to continuous axes capturing dominant modes of cortical variation across the cortex." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1727> .

<urn:repronim:abide:abstract/ohbm2026/1727/claim/10> a ex:AbstractClaim ;
    rdfs:label "Gradient 2 values averaged within the frontoparietal network correlated positively with depression/anxiety severity." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Gradient 2 values averaged within the frontoparietal network correlated positively with depression/anxiety severity (ρ = 0.11, pFDR < 0.05; Figure 2B), implying that functional shifts toward anterior, segregated profiles accompany heightened affective dysregulation." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1727> .

<urn:repronim:abide:abstract/ohbm2026/1727/claim/11> a ex:AbstractClaim ;
    rdfs:label "Posterior displacement of default mode regions along Gradients 2 and 3 correlated negatively with cognitive disorganization." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Conversely, posterior displacement of default mode regions along Gradients 2 and 3 correlated negatively with cognitive disorganization (Gradient 2: ρ = −0.11, pFDR < 0.05; Gradient 3: ρ = −0.18, pFDR < 0.05; Figure 1D), indicating that DMN regression toward sensory-like profiles may undermine higher-order integrative processes." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1727> .

<urn:repronim:abide:abstract/ohbm2026/1727/claim/12> a ex:AbstractClaim ;
    rdfs:label "Stronger Gradient 3 integration of the visual network was associated with positive symptom expression." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Notably, stronger Gradient 3 integration of the visual network was associated with positive symptom expression (ρ = 0.11, pFDR < 0.05, Figure 1D), suggesting an aberrant recruitment of task-positive sensory systems into task-negative associative circuits underlying perceptual distortions." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1727> .

<urn:repronim:abide:abstract/ohbm2026/1727/claim/2> a ex:AbstractClaim ;
    rdfs:label "Study I included the publicly available UCLA Consortium for Neuropsychiatric Phenomics dataset." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Study I, included preprocessed and parcellated data derived from the publicly available UCLA Consortium for Neuropsychiatric Phenomics (UCLA-CNP) dataset (SSD = 37, BD = 40, HC = 110)1 and described in a prior publication2." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1727> .

<urn:repronim:abide:abstract/ohbm2026/1727/claim/3> a ex:AbstractClaim ;
    rdfs:label "Study II utilized the Bipolar–Schizophrenia Network on Intermediate Phenotypes dataset." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Study II utilized the Bipolar–Schizophrenia Network on Intermediate Phenotypes (B-SNIP) dataset (SSD = 256, BD = 68, HC = 60)3 and was processed with Micapipe and parcellated using the Glasser atlas." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1727> .

<urn:repronim:abide:abstract/ohbm2026/1727/claim/4> a ex:AbstractClaim ;
    rdfs:label "Diffusion map embedding was used to derive gradients from whole-brain affinity matrices." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Interregional similarity was quantified using cosine distance, producing whole-brain affinity matrices from which gradients were derived through diffusion map embedding4." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1727> .

<urn:repronim:abide:abstract/ohbm2026/1727/claim/5> a ex:AbstractClaim ;
    rdfs:label "Across both cohorts, the first three gradients recapitulated canonical cortical axes, with some cohort-specific variations." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Across both cohorts, the first three gradients (G1–G3) recapitulated canonical cortical axes, with some cohort-specific variations (Figure 1A)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1727> .

<urn:repronim:abide:abstract/ohbm2026/1727/claim/6> a ex:AbstractClaim ;
    rdfs:label "In UCLA-CNP, the first two gradients together captured the principal axis of cortical organization." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "In UCLA-CNP, the first two gradients together captured the principal axis of cortical organization, though their order was reversed relative to canonical results previously reported5." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1727> .

<urn:repronim:abide:abstract/ohbm2026/1727/claim/7> a ex:AbstractClaim ;
    rdfs:label "No significant group differences emerged along G1." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "No significant group differences emerged along G1." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1727> .

<urn:repronim:abide:abstract/ohbm2026/1727/claim/8> a ex:AbstractClaim ;
    rdfs:label "G2 revealed higher values in the frontoparietal control network and lower values in somatomotor regions among patients." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "G2, spanning sensory to associative areas, revealed opposing shifts across its poles: higher values in the frontoparietal control network ( t = 3.1, pFDR < 0.05) and lower values in somatomotor regions (t = -2.5, pFDR < 0.05) among patients (Figure 1B)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1727> .

<urn:repronim:abide:abstract/ohbm2026/1727/claim/9> a ex:AbstractClaim ;
    rdfs:label "Gradient 3 showed higher somatomotor values in patients." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Moreover, Gradient 3 showed higher somatomotor values in patients (t = 4,1, pFDR < 0.05; Figure 1B), indicating stronger integration of task-positive signals within typically task-negative associative domains." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1727> .

<urn:repronim:abide:abstract/ohbm2026/1740/claim/0> a ex:AbstractClaim ;
    rdfs:label "Resting-state functional magnetic resonance imaging scans were obtained from 19 datasets for 4,029 patients and 3,564 healthy controls." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Resting-state functional magnetic resonance imaging (rs-fMRI) scans were obtained from 19 datasets for 4,029 patients and 3,564 healthy controls." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1740> .

<urn:repronim:abide:abstract/ohbm2026/1740/claim/1> a ex:AbstractClaim ;
    rdfs:label "Functional connectivity was extracted for each subject, harmonized across datasets, and used to conduct a mega-analysis." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Functional connectivity was extracted for each subject, harmonized across datasets, and used to conduct a mega-analysis." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1740> .

<urn:repronim:abide:abstract/ohbm2026/1740/claim/10> a ex:AbstractClaim ;
    rdfs:label "The functional connectome undergoes both disorder-specific and transdiagnostic changes." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "In conclusion, the functional connectome undergoes both disorder-specific and transdiagnostic changes." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1740> .

<urn:repronim:abide:abstract/ohbm2026/1740/claim/2> a ex:AbstractClaim ;
    rdfs:label "Disorder-specific effects were estimated by comparing each diagnostic cohort to healthy controls and other cohorts." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Disorder-specific effects were estimated by comparing each diagnostic cohort to healthy controls and other cohorts." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1740> .

<urn:repronim:abide:abstract/ohbm2026/1740/claim/3> a ex:AbstractClaim ;
    rdfs:label "Transdiagnostic overlap was estimated by taking connections that were consistently altered (same direction and significant) in several disorders." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Transdiagnostic overlap was estimated by taking connections that were consistently altered (same direction and significant) in several disorders." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1740> .

<urn:repronim:abide:abstract/ohbm2026/1740/claim/4> a ex:AbstractClaim ;
    rdfs:label "ASD-specific hypoconnectivity was observed in the default-mode network." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "ASD-specific hypoconnectivity was observed in the default-mode network (Cohen’s _d_ = -0.43 to -0.12; Figure 1A)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1740> .

<urn:repronim:abide:abstract/ohbm2026/1740/claim/5> a ex:AbstractClaim ;
    rdfs:label "MDD-specific hypoconnectivity was observed between the right ventromedial and ventrolateral prefrontal cortex." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "MDD-specific hypoconnectivity was observed between the right ventromedial and ventrolateral prefrontal cortex (_d_ = -0.13 to -0.11)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1740> .

<urn:repronim:abide:abstract/ohbm2026/1740/claim/6> a ex:AbstractClaim ;
    rdfs:label "SZ-specific alterations consisted of hypoconnectivity within the visual network, altered connectivity around the putamen, and altered connectivity of the somatomotor network." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "SZ-specific alterations consisted of hypoconnectivity within the visual network (_d_ = -0.39 to -0.24), altered connectivity around the putamen (_d_ = -0.58 to 0.4) and altered connectivity of the somatomotor network (_d_ = -0.42 to 0.37)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1740> .

<urn:repronim:abide:abstract/ohbm2026/1740/claim/7> a ex:AbstractClaim ;
    rdfs:label "ADHD showed no significantly altered connectivity." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "ADHD showed no significantly altered connectivity." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1740> .

<urn:repronim:abide:abstract/ohbm2026/1740/claim/8> a ex:AbstractClaim ;
    rdfs:label "Cross-disorder overlap was observed between ASD, MDD and SZ and was characterized by hypoconnectivity within the somatomotor network and thalamo-somatomotor hyperconnectivity." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Cross-disorder overlap was observed between ASD, MDD and SZ (Figure 1B) and was characterized by hypoconnectivity within the somatomotor network (_d_ = -0.26 to -0.16) and thalamo-somatomotor hyperconnectivity (_d_ = 0.23 to 0.34)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1740> .

<urn:repronim:abide:abstract/ohbm2026/1740/claim/9> a ex:AbstractClaim ;
    rdfs:label "Assessment within the second disorder set revealed that the observed cross-disorder involvement generalized well, as evidenced by a significant correspondence." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Assessment within the second disorder set revealed that the observed cross-disorder involvement generalized well, as evidenced by a significant correspondence (_r_ = 0.37, _p_ < 0.0001)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/1740> .

<urn:repronim:abide:abstract/ohbm2026/2/claim/0> a ex:AbstractClaim ;
    rdfs:label "Atypical neural connectivity has long been proposed as a convergent neurobiological explanation behind the many ‘autisms’." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Atypical neural connectivity has long been proposed as a convergent neurobiological explanation behind the many ‘autisms’." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2> .

<urn:repronim:abide:abstract/ohbm2026/2/claim/1> a ex:AbstractClaim ;
    rdfs:label "Autism is characterized by alterations in whole-brain connectivity gradients, idiosyncratic connectivity profiles, mosaic patterns of hypo- and hyper-connectivity, and distance-dependent effects." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "autism is characterized by alterations in whole-brain connectivity gradients, idiosyncratic connectivity profiles, mosaic patterns of hypo- and hyper-connectivity, and distance-dependent effects." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2> .

<urn:repronim:abide:abstract/ohbm2026/2/claim/2> a ex:AbstractClaim ;
    rdfs:label "Resting-state fMRI exhibits intrinsic non-stationarities, or ‘dynamics’, requiring analysis of how dynamic connectivity patterns emerge and change over time." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "rsfMRI exhibits intrinsic non-stationarities, or ‘dynamics’, requiring analysis of how dynamic connectivity patterns emerge and change over time." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2> .

<urn:repronim:abide:abstract/ohbm2026/2/claim/3> a ex:AbstractClaim ;
    rdfs:label "Turbulence can be viewed as the spatiotemporal extension of metastability." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
