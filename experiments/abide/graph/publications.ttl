<urn:repronim:abide:abstract/ohbm2026/25/claim/2> a ex:AbstractClaim ;
    rdfs:label "Prior work indicates that the reward circuitry of the brain contributes to core symptoms observed in autism, and of these reward regions, the ventral striatum (VS) has been notably implicated in autism pathophysiology." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Prior work indicates that the reward circuitry of the brain contributes to core symptoms observed in autism, and of these reward regions, the ventral striatum (VS) has been notably implicated in autism pathophysiology." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/25> .

<urn:repronim:abide:abstract/ohbm2026/25/claim/3> a ex:AbstractClaim ;
    rdfs:label "Regions that compose the dopaminergic reward system, including the VS are regulated by the habenula (Hb), a small pair of functionally distinct epithalamic nuclei." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Regions that compose the dopaminergic reward system, including the VS are regulated by the habenula (Hb), a small pair of functionally distinct epithalamic nuclei." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/25> .

<urn:repronim:abide:abstract/ohbm2026/25/claim/4> a ex:AbstractClaim ;
    rdfs:label "Acting as a node, the habenula has also been acknowledged for mediating neural systems, including emotional behaviors between the forebrain and midbrain regions and modulating dopaminergic and serotonergic systems." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Acting as a node, the habenula has also been acknowledged for mediating neural systems, including emotional behaviors between the forebrain and midbrain regions and modulating dopaminergic and serotonergic systems." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/25> .

<urn:repronim:abide:abstract/ohbm2026/25/claim/5> a ex:AbstractClaim ;
    rdfs:label "We propose that further investigation of altered Hb resting state functional connectivity (rsFC) may elucidate underlying mechanisms inherent to autism symptom manifestation." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Thus, we propose that further investigation of altered Hb resting state functional connectivity (rsFC) may elucidate underlying mechanisms inherent to autism symptom manifestation." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/25> .

<urn:repronim:abide:abstract/ohbm2026/25/claim/6> a ex:AbstractClaim ;
    rdfs:label "Here, we posit that data-driven subgroups of autistic individuals may be distinguished by different patterns of whole-brain Hb rsFC." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Here, we posit that data-driven subgroups of autistic individuals may be distinguished by different patterns of whole-brain Hb rsFC." ;
