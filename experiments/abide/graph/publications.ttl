    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/20> a ex:AbstractClaim ;
    rdfs:label "The healthy training cohort established a normative physiological baseline for gBOLD-CSF coupling." ;
