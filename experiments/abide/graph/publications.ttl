<urn:repronim:abide:abstract/ohbm2026/25/claim/12> a ex:AbstractClaim ;
    rdfs:label "Produced by successive k value merge heights, the greatest linkage distance jump (ΔLD=0.278) of the eight cluster groups (k=[2, 9]) was observed at _k_=3." ;
