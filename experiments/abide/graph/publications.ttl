<urn:repronim:abide:abstract/ohbm2026/2782/claim/0> a ex:AbstractClaim ;
    rdfs:label "The glymphatic system facilitates brain-wide clearance of metabolic waste through coordinated exchange between cerebrospinal fluid (CSF) and interstitial spaces." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "The glymphatic system facilitates brain-wide clearance of metabolic waste through coordinated exchange between cerebrospinal fluid (CSF) and interstitial spaces." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/1> a ex:AbstractClaim ;
    rdfs:label "Resting-state fMRI offers a non-invasive approach to probing this process, where coupling between CSF inflow and global BOLD (gBOLD) fluctuations serves as a functional proxy for interpreting glymphatic dynamics." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Resting-state fMRI offers a non-invasive approach to probing this process, where coupling between CSF inflow and global BOLD (gBOLD) fluctuations serves as a functional proxy for interpreting glymphatic dynamics." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/10> a ex:AbstractClaim ;
    rdfs:label "The averaged signal from cortical and subcortical grey matter masks was treated as the global BOLD signal." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "to generate precise cortical and subcortical masks grey matter masks from which the averaged signal was treated as the global BOLD signal." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/11> a ex:AbstractClaim ;
    rdfs:label "The most inferior slice with >95% brainstem coverage was identified and an automated seed-based region-growing procedure was applied to extract the CSF signal." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "To extract the CSF signal, we identified the most inferior slice with >95% brainstem coverage and applied an automated seed-based region-growing procedure targeting the bright voxels surrounding the brainstem boundary." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/12> a ex:AbstractClaim ;
    rdfs:label "The study used three metrics to quantify coupling between the gBOLD signal and CSF inflow." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We used three complementary metrics to quantify coupling between the gBOLD signal and CSF inflow." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/13> a ex:AbstractClaim ;
    rdfs:label "The canonical lag was identified from the population-averaged cross-correlation curve and each participant’s coupling index was defined as the correlation at that lag." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Following prior work,^(2) we identified a canonical negative lag from the population-averaged curve and defined each participant’s coupling index (CI) as the correlation at this lag." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/14> a ex:AbstractClaim ;
    rdfs:label "Mutual information was estimated by discretizing signals into 30 bins and averaging over 50 bootstrapped temporal windows matched to the HC cohort’s minimum scan length." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "we assessed non-linear dependencies using Mutual Information (MI) discretizing signals into 30 bins to estimate the joint probability distribution; to mitigate time length bias, MI was averaged over 50 bootstrapped temporal windows matched to the HC cohort’s minimum scan length." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/15> a ex:AbstractClaim ;
    rdfs:label "Temporal alignment stability was characterized with Dynamic Time Warping, and the normalized alignment cost was computed as the total Euclidean distance along the optimal warp path divided by its length." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "temporal alignment stability was characterized with Dynamic Time Warping (DTW), where the normalized alignment cost was computed as the total Euclidean distance along the optimal warp path divided by its length." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/16> a ex:AbstractClaim ;
    rdfs:label "The normative models used GAMLSS with a 4-parameter SHASH distribution." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "we employed Generalized Additive Models for Location, Scale, and Shape (GAMLSS). Each metric was modelled using 4-parameter SHASH distribution" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/17> a ex:AbstractClaim ;
    rdfs:label "Location and scale parameters were modeled as smooth age functions using penalized B-splines, and models were stratified by sex." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "location and scale parameters were modelled as smooth age functions using penalized B-splines, with models stratified by sex." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/18> a ex:AbstractClaim ;
    rdfs:label "Scanner identity was included as a random intercept in both the μ and σ components to control site-specific variability across 98 sites." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Site-specific variability across the 98 sites was rigorously controlled by including scanner identity as a random intercept in both the μ and σ components." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/19> a ex:AbstractClaim ;
    rdfs:label "For each clinical subject, individual deviations were computed as Z-scores from age- and sex-matched normative estimates." ;
