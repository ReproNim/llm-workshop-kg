    ex:sourceQuote "We identified a population-level \"canonical\" lag of +3.80 seconds, at which the negative correlation between global BOLD and CSF signals was maximal (mean r=−0.24)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/22> a ex:AbstractClaim ;
    rdfs:label "GAMLSS modeling of the coupling index revealed a robust non-linear lifespan trajectory with p<0.001." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "GAMLSS modelling of the CI revealed a robust non-linear lifespan trajectory (p<0.001), aligning with established findings, ^(4) this profile was characterized by stability throughout early and mid-adulthood followed by a progressive decline in magnitude around age 50." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/23> a ex:AbstractClaim ;
    rdfs:label "Autism Spectrum Disorder, Depression, and ADHD showed significant reductions in coupling strength relative to age- and sex-matched expectations." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "disorders with prominent neurodevelopmental or affective components exhibited significant reductions in coupling strength relative to age and sex-matched expectations." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/24> a ex:AbstractClaim ;
    rdfs:label "ASD showed the most pronounced mean deviation, followed by Depression and ADHD." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Autism Spectrum Disorder (ASD) displayed the most pronounced mean deviation (Mean Z=−0.16, p<0.001), followed by Depression (Mean Z=−0.10, p=0.039) and ADHD (Mean Z=−0.09, p=0.005)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/25> a ex:AbstractClaim ;
    rdfs:label "MI analysis showed a profound reduction in shared information content in ASD." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "MI analysis corroborated these linear findings, revealing a profound reduction in shared information content in ASD (Mean Z=−0.25, p<0.001)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/26> a ex:AbstractClaim ;
    rdfs:label "The ASD cohort had a higher prevalence of extreme MI values than controls, with 9.4% versus 5.6% and odds ratio 1.75." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "This was driven by a disproportionate burden of pathologically extreme MI values in the ASD cohort (9.4% prevalence vs 5.6% in controls; Odd’s Ratio=1.75, p<0.001), indicating a subset of individuals with markedly impaired non-linear coupling." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/27> a ex:AbstractClaim ;
    rdfs:label "Dementia/AD and Schizophrenia did not show significant shifts in mean coupling magnitude." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "In surprising contrast, neither Dementia/AD nor Schizophrenia demonstrated significant shifts in mean coupling magnitude (Mean Z≈0, p>0.05), suggesting preservation of average amplitude-based synchrony in these cohorts." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/28> a ex:AbstractClaim ;
    rdfs:label "Across all diagnostic groups, mean normalized DTW alignment cost did not deviate from the normative reference." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Across all diagnostic groups, mean normalized alignment cost did not deviate from the normative reference (all group means Z ≈ 0)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/29> a ex:AbstractClaim ;
    rdfs:label "Dementia/AD exhibited increased biological heterogeneity and the highest prevalence of extreme dysynchrony outliers." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "However, Dementia/AD exhibited a striking increase in biological heterogeneity (Variance Ratio=1.48, p<0.001) and the highest prevalence of extreme dysynchrony outliers (10.4%; OR=2.23, p<0.001)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/3> a ex:AbstractClaim ;
    rdfs:label "The healthy cohort included 11,139 participants and the clinical cohort included 4,168 participants." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0006055> ;
    ex:sourceQuote "The sample included a substantial healthy cohort (N=11139) and a transdiagnostic clinical cohort (N=4168)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/30> a ex:AbstractClaim ;
    rdfs:label "Significant variance inflation was also observed in Depression and ASD." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Significant variance inflation was also observed in Depression (Variance Ratio=1.32, p<0.001) and ASD (Variance Ratio=1.17, p=0.003)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/31> a ex:AbstractClaim ;
    rdfs:label "This study establishes a normative framework for quantifying the gBOLD-CSF interaction at scale." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "This study establishes a normative framework for quantifying the gBOLD-CSF interaction in a principled manner that captures linear and non-linear dynamics at scale." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/32> a ex:AbstractClaim ;
    rdfs:label "The study identified a pathophysiological dissociation in which neurodevelopmental conditions are characterized by reduced coupling strength and neurodegenerative conditions by temporal instability." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "By referencing individual patients against a massive multi-site dataset (N>15,000), we identified a distinct pathophysiological dissociation: neurodevelopmental conditions (particularly ASD) are characterized by a generalized reduction in coupling strength, whereas neurodegenerative conditions (Dementia/Alzheimer’s) manifest as temporal instability." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/33> a ex:AbstractClaim ;
    rdfs:label "The findings suggest that the gBOLD-CSF axis could reflect distinct failure modes, including dampened arousal-fluid dynamics in impaired development and a dysregulated neurovascular response in aging populations." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "These findings suggest that the gBOLD-CSF axis could reflect distinct failure modes: dampened arousal-fluid dynamics in impaired development versus a dysregulated neurovascular response in aging populations." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/4> a ex:AbstractClaim ;
    rdfs:label "Healthy participants were divided into a training set of 8,873 participants and a held-out test set of 2,266 participants." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0006055> ;
    ex:sourceQuote "Healthy participants were divided into a training set (N=8873; 49.6% female) for learning normative trajectories and a held-out test set (N=2266; 48.0% female) for validation." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/5> a ex:AbstractClaim ;
    rdfs:label "All datasets were preprocessed with fMRIPrep including slice-timing correction, motion correction, susceptibility-distortion correction, and skull stripping." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "All datasets were preprocessed with fMRIPrep including slice-timing correction, motion correction, susceptibility-distortion correction, and skull stripping." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/6> a ex:AbstractClaim ;
    rdfs:label "The functional data were registered to each subject’s T1-weighted anatomical space to enable transfer of structural masks." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The functional data were registered to each subject’s T1-weighted anatomical space to enable transfer of structural masks." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/7> a ex:AbstractClaim ;
    rdfs:label "The analyses intentionally omitted regression of global signal, CSF signal, and motion parameters to retain physiological components relevant to the coupling phenomenon." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "In line with prior work, we intentionally omitted regression of global signal, CSF signal, and motion parameters to retain the physiological components relevant to the coupling phenomenon." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/8> a ex:AbstractClaim ;
    rdfs:label "The extracted time series were z-scored, detrended, and bandpass filtered (0.01–0.1 Hz)." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The extracted time series were z-scored, detrended, and bandpass filtered (0.01–0.1 Hz)" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/9> a ex:AbstractClaim ;
    rdfs:label "Structural segmentation was performed using the FreeSurfer v8 pipeline." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Structural segmentation was performed using the FreeSurfer v8 pipeline" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/4/claim/0> a ex:AbstractClaim ;
    rdfs:label "Autism is marked by substantial heterogeneity in clinical characteristics, neuroimaging and genetic profiles." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Autism is marked by substantial heterogeneity in clinical characteristics, neuroimaging and genetic profiles." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/4> .

<urn:repronim:abide:abstract/ohbm2026/42/claim/0> a ex:AbstractClaim ;
    rdfs:label "Artificial Intelligence combined with neuroimaging has demonstrated immense potential in characterizing Autism Spectrum Disorder, particularly in achieving high diagnostic accuracy through complex and high-dimensional features." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Artificial Intelligence (AI) combined with neuroimaging has demonstrated immense potential in characterizing the Autism Spectrum Disorder (ASD), particularly in achieving high diagnostic accuracy through complex and high-dimensional features(Chen et al., 2024; Pan et al., 2025; Wen et al., 2022)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/42> .

<urn:repronim:abide:abstract/ohbm2026/42/claim/1> a ex:AbstractClaim ;
    rdfs:label "Current AI models often function as black boxes lacking the localized interpretability required for targeted interventions such as Transcranial Magnetic Stimulation." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Current AI models often function as “black boxes,”(Haight & Eshaghi, 2023) lacking the localized interpretability required for targeted interventions such as Transcranial Magnetic Stimulation (TMS) (Fox et al., 2012)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/42> .

<urn:repronim:abide:abstract/ohbm2026/42/claim/2> a ex:AbstractClaim ;
    rdfs:label "The study selected 646 participants from ABIDE I, including 298 ASD and 348 TD participants, after exclusions." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We selected 646 participants (298 ASD, 348 TD) from the ABIDE I dataset (14 sites) after excluding subjects with missing data, head motion >3mm/3°, poor image quality, or IQ <70." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/42> .

<urn:repronim:abide:abstract/ohbm2026/42/claim/3> a ex:AbstractClaim ;
    rdfs:label "The study used a composite atlas of 416 ROIs consisting of Schaefer 400 cortical and Harvard-Oxford subcortical regions." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We used a composite atlas of 416 ROIs (Schaefer 400-cortical + Harvard-Oxford subcortical) resampled to 3×3×3 mm³ MNI space." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/42> .

<urn:repronim:abide:abstract/ohbm2026/42/claim/4> a ex:AbstractClaim ;
    rdfs:label "Granger causality analysis used linear vector autoregressive modeling with lag order 1." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Granger causality analysis (GCA) quantified effective connectivity using linear vector autoregressive modeling (lag order 1)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/42> .

<urn:repronim:abide:abstract/ohbm2026/42/claim/5> a ex:AbstractClaim ;
    rdfs:label "The right superior temporal gyrus ROI_236 achieved the highest classification performance with an AUC of 0.72." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The cortically accessible ROI_236 (the right superior temporal gyrus) achieved the highest classification performance with an AUC of 0.72 (Figure 2C), significantly exceeding the average performance of 0.52 observed across other regions and demonstrated robust discriminative power." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/42> .

<urn:repronim:abide:abstract/ohbm2026/42/claim/6> a ex:AbstractClaim ;
    rdfs:label "Connections from ROI_236 to ROI_142, ROI_294, and ROI_328 exhibited negative SHAP values." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Specifically, connections to ROI_142, ROI_294, and ROI_328 exhibited negative SHAP values, corresponding to a reduced causal influence in ASD compared to TD." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/42> .

<urn:repronim:abide:abstract/ohbm2026/42/claim/7> a ex:AbstractClaim ;
    rdfs:label "Connections from ROI_236 to ROI_371 and ROI_301 exhibited positive SHAP values." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "In contrast, projections to ROI_371 and ROI_301 displayed positive SHAP values, corresponding to an increased causal influence in ASD compared to TD." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/42> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/0> a ex:AbstractClaim ;
    rdfs:label "Large-scale neuroimaging studies often collect data from multiple scanners across different sites, where variations in scanners, scanning procedures, and other conditions across sites can introduce artificial site effects." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:sourceQuote "Large-scale neuroimaging studies often collect data from multiple scanners across different sites, where variations in scanners, scanning procedures, and other conditions across sites can introduce artificial site effects." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/1> a ex:AbstractClaim ;
    rdfs:label "These effects are known to bias functional connectivity derived from functional magnetic resonance imaging (fMRI) ^1." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "These effects are known to bias functional connectivity derived from functional magnetic resonance imaging (fMRI) ^1." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/10> a ex:AbstractClaim ;
    rdfs:label "The final sample comprises 845 subjects across 19 sites." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The final sample comprises 845 subjects across 19 sites." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/11> a ex:AbstractClaim ;
    rdfs:label "We compared the harmonization performance of SLACC with ComBat." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:sourceQuote "We compared the harmonization performance of SLACC with ComBat available at [https://github.com/andy1764/ComBatFamily](https://github.com/andy1764/ComBatFamily)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/12> a ex:AbstractClaim ;
    rdfs:label "We used 6 covariates in all methods: age, age², sex, diagnosis (autism), age × sex, and age × diagnosis." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We use 6 covariates to be included in all these methods: age, age², sex, diagnosis (autism), age × sex, and age × diagnosis." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/13> a ex:AbstractClaim ;
    rdfs:label "Our model identified L=46 unique sparse latent patterns." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Our model identified _L_=46 unique sparse latent patterns, as shown in Figure (a)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/14> a ex:AbstractClaim ;
    rdfs:label "Approximately 48% of the entries were shrunk to 0." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Overall, approximately 48% of the entries were shrunk to 0." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/15> a ex:AbstractClaim ;
    rdfs:label "SLACC effectively mitigates site effects in latent subject scores by shrinking high F statistics close to 1." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "We see that a few latent patterns that were noticeably high (e.g., _F_ > 4) before harmonization were shrunk close to 1, demonstrating that SLACC effectively mitigates site effects in latent subject scores." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/16> a ex:AbstractClaim ;
    rdfs:label "The median F statistics for mean and variance heterogeneities were 1.39 and 1.10 for SLACC, and 1.25 and 1.19 for ComBat." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The median _F_ statistics for mean and variance heterogeneities were 1.39 and 1.10, respectively, for SLACC, and 1.25 and 1.19 for ComBat, suggesting that ComBat might be more beneficial for addressing mean heterogeneity in univariate analysis, and SLACC might be more useful in reducing variance heterogeneity." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/17> a ex:AbstractClaim ;
    rdfs:label "In the harmonized test data, ComBat had roughly 1.79% significant p-values and SLACC had 1.62%." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In the harmonized test data, ComBat had roughly 1.79% that were significant, and SLACC had 1.62%." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/18> a ex:AbstractClaim ;
    rdfs:label "The residual variance had a very high negative correlation with scan duration, r = -0.66, p = 0.002." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In Figure (d), there was a very high correlation (_r_ = -0.66, _p_ = 0.002)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/19> a ex:AbstractClaim ;
    rdfs:label "The software is publicly available as an R package." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:sourceQuote "We have made software publicly available as an R package: [https://github.com/junjypark/SLACC](https://github.com/junjypark/SLACC)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/2> a ex:AbstractClaim ;
    rdfs:label "We propose Sparse Latent Covariate-driven Connectome factorization (SLACC), a novel method that explicitly embeds covariate effects on means and variances of latent connectivity patterns." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:sourceQuote "In our work, we propose Sparse Latent Covariate-driven Connectome factorization (SLACC), a novel method that explicitly embeds covariate effects on means and variances of latent connectivity patterns." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/3> a ex:AbstractClaim ;
    rdfs:label "We applied SLACC to the Autism Brain Imaging Data Exchange (ABIDE) dataset to evaluate whether it effectively harmonizes site effects while preserving biologically relevant associations." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We applied SLACC to the Autism Brain Imaging Data Exchange (ABIDE) dataset to evaluate whether it effectively harmonizes site effects while preserving biologically relevant associations." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/4> a ex:AbstractClaim ;
    rdfs:label "Each subject’s FC matrix is modeled by a set of subject scores and residual noise." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:sourceQuote "Each subject’s FC matrix is modeled by (i) a set of subject scores, each corresponding to the sparse rank-1 latent patterns, and (ii) residual noise." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/5> a ex:AbstractClaim ;
    rdfs:label "The latent subject scores are modeled with covariate effects, site effects in means, and site effects in variances." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:sourceQuote "The latent subject scores (i.e., part (i)) are modeled with covariate effects, site effects in means, and site effects in variances." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/6> a ex:AbstractClaim ;
    rdfs:label "Residual noises are modeled by site-specific variances." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:sourceQuote "Residual noises (i.e., part (ii)) are modeled by site-specific variances." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/7> a ex:AbstractClaim ;
    rdfs:label "The model uses a penalized expectation-maximization (EM) algorithm and the penalty is derived naturally by the Bayesian Information Criterion (BIC)." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:sourceQuote "To achieve this goal, we adopt a penalized expectation-maximization (EM) algorithm, and the penalty is derived naturally by the Bayesian Information Criterion (BIC)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/8> a ex:AbstractClaim ;
    rdfs:label "The ABIDE dataset was preprocessed by CPAC, which includes slice-timing correction, motion realignment, and intensity normalization." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We used the ABIDE dataset preprocessed by the Configurable Pipeline for the Analysis of Connectomes (CPAC), which includes slice-timing correction, motion realignment, and intensity normalization." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/506/claim/9> a ex:AbstractClaim ;
    rdfs:label "The functional connectivity was computed as Pearson correlation of time series and Fisher-transformed." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The FC is obtained by the Pearson correlation of time series and Fisher-transformed." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/506> .

<urn:repronim:abide:abstract/ohbm2026/546/claim/0> a ex:AbstractClaim ;
    rdfs:label "Prior work demonstrated that caricaturing resting-state data prior to constructing connectomes can improve prediction accuracy by leveraging data typically ignored in connectome construction." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Prior work has demonstrated that caricaturing resting-state data—in other words, removing task-relevant, dominant co-activation patterns—prior to constructing connectomes can improve prediction accuracy by leveraging data typically ignored in connectome construction." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/546> .

<urn:repronim:abide:abstract/ohbm2026/546/claim/1> a ex:AbstractClaim ;
    rdfs:label "The manuscript applies caricaturing to a transdiagnostic resting-state dataset with 28 cognitive measures." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000352> ;
    ex:sourceQuote "Here, we apply caricaturing to a transdiagnostic resting-state dataset with 28 cognitive measures, which were previously predicted using CPM with varying degrees of success." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/546> .

<urn:repronim:abide:abstract/ohbm2026/546/claim/2> a ex:AbstractClaim ;
    rdfs:label "The YaleNeuroConnect dataset includes participants with diverse psychiatric backgrounds who were scanned 8 times in various conditions." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Briefly, it includes participants with diverse psychiatric backgrounds who were scanned 8 times in various conditions." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/546> .

<urn:repronim:abide:abstract/ohbm2026/546/claim/3> a ex:AbstractClaim ;
    rdfs:label "After quality assurance, the data comprised 317 resting-state scans from unique participants." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "After quality assurance measures2 were satisfied, the data comprised 317 resting-state scans from unique participants." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/546> .

<urn:repronim:abide:abstract/ohbm2026/546/claim/4> a ex:AbstractClaim ;
    rdfs:label "Feature selection was performed by considering only edges significantly correlated with the behavior, controlling for age and sex via partial correlation." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Feature selection was performed by considering only edges that were significantly correlated (p < 0.05) with the behavior, controlling for age and sex via partial correlation." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/546> .

<urn:repronim:abide:abstract/ohbm2026/546/claim/5> a ex:AbstractClaim ;
    rdfs:label "Models were built with linear regression." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Models were built with linear regression." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/546> .

<urn:repronim:abide:abstract/ohbm2026/546/claim/6> a ex:AbstractClaim ;
    rdfs:label "Caricatured models show numerically greater performance on 19 out of the 28 measures compared to Standard models." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Caricatured models show numerically greater performance on 19 out of the 28 measures compared to Standard models." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/546> .

<urn:repronim:abide:abstract/ohbm2026/546/claim/7> a ex:AbstractClaim ;
    rdfs:label "The three measures for which the Combined model was superior were the initial abstraction score, the color-word interference condition 3 inhibition score, and the trail making condition 4 number-letter sequencing score." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The three measures for which the Combined model was superior were from Delis-Kapan Executive Function Scale, namely the initial abstraction score (Combined vs Standard pFDR = 1.00 X 10-7; Combined vs Caricatured pFDR = 0.0024), the color-word interference condition 3 i.e. inhibition (Combined vs Standard pFDR = 2.41 X 10-6; Combined vs Caricatured pFDR = 2.88 X 10-12), and the trail making condition 4 i.e. number-letter sequencing (Combined vs Standard pFDR = 0.022; Combined vs Caricatured pFDR = 2.26 X 10-16)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/546> .

<urn:repronim:abide:abstract/ohbm2026/546/claim/8> a ex:AbstractClaim ;
    rdfs:label "Combining the Standard and Caricatured data did not always improve predictive modeling." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "In other words, at least in this analysis, combining data types does not always improve predictive modeling." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/546> .

<urn:repronim:abide:abstract/ohbm2026/559/claim/0> a ex:AbstractClaim ;
    rdfs:label "Graph Neural Networks have become increasingly influential in the analysis of brain graphs." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Graph Neural Networks1 (GNNs) have become increasingly influential in the analysis of brain graphs, offering a flexible framework for modeling complex patterns of connectivity." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/559> .

<urn:repronim:abide:abstract/ohbm2026/559/claim/1> a ex:AbstractClaim ;
    rdfs:label "The ABIDE dataset includes more than 2,000 participants." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We used the publicly available ABIDE dataset (https://fcon_1000.projects.nitrc.org/indi/abide/), which includes more than 2,000 participants." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/559> .

<urn:repronim:abide:abstract/ohbm2026/559/claim/2> a ex:AbstractClaim ;
    rdfs:label "Only male subjects aged 5–35 with open-eyes resting-state fMRI scans were selected." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "To reduce heterogeneity, only male subjects aged 5–35 with open-eyes resting-state fMRI scans were selected." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/559> .

<urn:repronim:abide:abstract/ohbm2026/559/claim/3> a ex:AbstractClaim ;
    rdfs:label "The study extracted morphological features from structural MRI and time-series from resting-state fMRI using the Destrieux atlas." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "From each subject, morphological features from structural MRI (sMRI) and time-series from resting-state fMRI (rs-fMRI) were extracted using the Destrieux atlas." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/559> .

<urn:repronim:abide:abstract/ohbm2026/559/claim/4> a ex:AbstractClaim ;
    rdfs:label "Functional connectivity was computed via Pearson correlation matrices." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "These features formed the basis of graph-structured brain representations in which nodes corresponded to anatomical regions and edges reflected functional connectivity computed via Pearson correlation matrices." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/559> .

<urn:repronim:abide:abstract/ohbm2026/559/claim/5> a ex:AbstractClaim ;
    rdfs:label "The problem was framed as an atlas-based binary whole-graph classification task to distinguish ASD from typically developing individuals." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The problem was framed as an atlas-based binary whole-graph classification task to distinguish ASD from typically developing (TD) individuals." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/559> .

<urn:repronim:abide:abstract/ohbm2026/591/claim/0> a ex:AbstractClaim ;
    rdfs:label "CNN has been widely used to extract aging-related features from brain MRI for age prediction." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Convolutional neural network (CNN) has been widely used to extract aging-related features from brain MRI for age prediction." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/591> .

<urn:repronim:abide:abstract/ohbm2026/591/claim/1> a ex:AbstractClaim ;
    rdfs:label "A positive PAD has been associated with various neurodegenerative or neuropsychiatric diseases." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "A positive PAD, indicating a higher predicted age, has been associated with various neurodegenerative or neuropsychiatric diseases." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/591> .

<urn:repronim:abide:abstract/ohbm2026/591/claim/2> a ex:AbstractClaim ;
    rdfs:label "The study proposes a 3D U-Net to achieve a 1-mm isotropic brain age map directly from structural MRI without cropping into patches or blocks." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361>,
        <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "With recent advances in computation power, we propose to develop a 3D U-Net^(4) with increased network depth to achieve 1-mm isotropic brain age map directly from structural MRI, without cropping into patches or blocks." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/591> .

<urn:repronim:abide:abstract/ohbm2026/591/claim/3> a ex:AbstractClaim ;
    rdfs:label "To evaluate its feasibility, two frameworks, a non-deformed and a deformed model, were implemented." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "To evaluate its feasibility, two frameworks, a non-deformed and a deformed model, were implemented, and data collected from the OASIS-3 cohort were used to assess the PAD of patients with mild cognitive impairment and dementia." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/591> .

<urn:repronim:abide:abstract/ohbm2026/591/claim/4> a ex:AbstractClaim ;
    rdfs:label "T1WI of 4,171 healthy subjects aged 5-100 years were obtained from 7 databases." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "T1WI of 4,171 healthy subjects (age: 5-100 years) has been obtained from 7 databases, including IXI (n = 561), OASIS-1 (n = 316), FCP (n = 1080), ABIDE-I (n = 547), ABIDE-II (n = 571), NKI-RS (n = 411), and HCP-A (n = 685)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/591> .

<urn:repronim:abide:abstract/ohbm2026/591/claim/5> a ex:AbstractClaim ;
    rdfs:label "Non-brain tissues were removed by applying a deep-learning based software (TigerBX, available on [https://github.com/htylab/tigerbx](https://github.com/htylab/tigerbx))." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Non-brain tissues were removed by applying a deep-learning based software (TigerBX, available on [https://github.com/htylab/tigerbx](https://github.com/htylab/tigerbx))." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/591> .

<urn:repronim:abide:abstract/ohbm2026/591/claim/6> a ex:AbstractClaim ;
    rdfs:label "And CAT12 (available on [https://neuro-jena.github.io/cat/](https://neuro-jena.github.io/cat/)) was used for bias correction, global intensity normalization, image registration, and resampling." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "And CAT12 (available on [https://neuro-jena.github.io/cat/](https://neuro-jena.github.io/cat/)) was used for bias correction, global intensity normalization, image registration, and resampling." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/591> .

<urn:repronim:abide:abstract/ohbm2026/591/claim/7> a ex:AbstractClaim ;
    rdfs:label "In this study, a 3D U-Net with 23 convolutional layers and five max-pooling layers inserted in the contracting path was implemented." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In this study, a 3D U-Net with 23 convolutional layers and five max-pooling layers inserted in the contracting path was implemented." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/591> .

<urn:repronim:abide:abstract/ohbm2026/591/claim/8> a ex:AbstractClaim ;
    rdfs:label "Data were split into training (n = 3471), validation (n = 350), and test sets (n = 350)." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Data were split into training (n = 3471), validation (n = 350), and test sets (n = 350)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/591> .

<urn:repronim:abide:abstract/ohbm2026/591/claim/9> a ex:AbstractClaim ;
    rdfs:label "The model was trained to minimize the MAE loss by using Adam optimizer, learning rate = 10^(-5), decay = 10^(-6), and batch size = 2." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The model was trained to minimize the MAE loss by using Adam optimizer, learning rate = 10^(-5), decay = 10^(-6), and batch size = 2." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/591> .

<urn:repronim:abide:abstract/ohbm2026/6/claim/0> a ex:AbstractClaim ;
    rdfs:label "The study analyzed 3D dMRI brain scans from 768 participants aggregated across 17 publicly available sites." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We analyzed 3D dMRI brain scans from 768 participants aggregated across 17 publicly available sites, including sites from the NDA, ABIDE, HBN and POND." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/6> .

<urn:repronim:abide:abstract/ohbm2026/6/claim/1> a ex:AbstractClaim ;
    rdfs:label "The sample included 447 participants with autism and 321 neurotypical participants." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Our sample consisted of 447 participants with autism and 321 neurotypical participants, with age ranging from 3 to 24 years (age: 12.15 ± 3.71 years; 32.3% female)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/6> .

<urn:repronim:abide:abstract/ohbm2026/6/claim/2> a ex:AbstractClaim ;
    rdfs:label "TDF-derived FA and standard DTI metrics were computed at each voxel." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "A tensor distribution function-derived FA (FATDF) and standard DTI metrics – FA (FADTI), and mean (MD), radial (RD), and axial diffusivity (AD) – were computed at each voxel." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/6> .

<urn:repronim:abide:abstract/ohbm2026/6/claim/3> a ex:AbstractClaim ;
    rdfs:label "The study analyzed 13 major white matter tracts." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We analyzed 13 major white matter tracts:" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/6> .

<urn:repronim:abide:abstract/ohbm2026/6/claim/4> a ex:AbstractClaim ;
    rdfs:label "The autism group displayed lower FATDF in forceps minor and forceps major." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The autism group displayed lower FATDF in autism compared to the neurotypical in two commissural tracts, – forceps minor and forceps major – four association tracts, – AF, UF, IFOF, and ILF – and 3 projection tracts – CST, OPT, and OR." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/6> .

<urn:repronim:abide:abstract/ohbm2026/6/claim/5> a ex:AbstractClaim ;
    rdfs:label "The autism group showed higher RD in forceps minor, ILF, and UF." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Higher RD was found in autism in one commissural tract – forceps minor – and two association tracts –ILF and UF." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/6> .

<urn:repronim:abide:abstract/ohbm2026/6/claim/6> a ex:AbstractClaim ;
    rdfs:label "There were no significant results for diagnosis by age and diagnosis by sex." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "There were no significant results for diagnosis by age and diagnosis by sex." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/6> .

<urn:repronim:abide:abstract/ohbm2026/6/claim/7> a ex:AbstractClaim ;
    rdfs:label "A significant diagnosis-sex-age interaction was found for MD in the AF." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "A significant diagnosis-sex-age interaction was found for MD in the AF." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/6> .

<urn:repronim:abide:abstract/ohbm2026/6/claim/8> a ex:AbstractClaim ;
    rdfs:label "Higher autistic traits in the autism group were associated with lower FADTI, higher MD, and higher AD in association and projection tracts." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In the SRS subset analysis, higher autistic traits in the autism group were associated with lower FADTI, higher MD, and higher AD in association and projection tracts." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/6> .

<urn:repronim:abide:abstract/ohbm2026/6/claim/9> a ex:AbstractClaim ;
    rdfs:label "The global FDR proportion increased with sample size overall for all metrics." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "For the complementary analysis where we examined the sensitivity of each microstructure metric, we found that the global FDR proportion increased with sample size overall for all metrics (Figure 1, below)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/6> .

<urn:repronim:abide:abstract/ohbm2026/629/claim/0> a ex:AbstractClaim ;
    rdfs:label "The manuscript proposes a specialized AI engine rooted in functional connectomics methodology and organized around neuropsychometrics." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "To bridge this gap, we propose a specialized AI engine rooted in functional connectomics methodology and organized around neuropsychometrics." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/629> .

<urn:repronim:abide:abstract/ohbm2026/629/claim/1> a ex:AbstractClaim ;
    rdfs:label "The system is called deepCoRRseek." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "we developed **_deepCoRRseek_**" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/629> .

<urn:repronim:abide:abstract/ohbm2026/629/claim/2> a ex:AbstractClaim ;
    rdfs:label "deepCoRRseek is a localized, domain-specific knowledge base." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "we developed **_deepCoRRseek_**, a localized, domain-specific knowledge base that aligns modern AI capabilities with the rigor of connectomics, advancing the field toward a neuropsychometric-driven science." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/629> .

<urn:repronim:abide:abstract/ohbm2026/629/claim/3> a ex:AbstractClaim ;
    rdfs:label "The methodology has four stages: core-literature anchoring, citation-network expansion, structured knowledge extraction, and LLM-enhanced retrieval and generation." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "we employ a four-stage methodology: core-literature anchoring, citation-network expansion, structured knowledge extraction, and LLM-enhanced retrieval and generation." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/629> .

<urn:repronim:abide:abstract/ohbm2026/629/claim/4> a ex:AbstractClaim ;
    rdfs:label "The local corpus comprises 24,833 peer-reviewed articles." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "the system incorporates a rigorously curated corpus of 24,833 peer-reviewed articles," ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/629> .

<urn:repronim:abide:abstract/ohbm2026/629/claim/5> a ex:AbstractClaim ;
    rdfs:label "87.9% of the corpus explicitly address reliability assessment in functional connectomics." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "of which 87.9% (n = 21,832) explicitly address reliability assessment in functional connectomics." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/629> .

<urn:repronim:abide:abstract/ohbm2026/629/claim/6> a ex:AbstractClaim ;
    rdfs:label "The Schaeferatlas is employed in 78.2% of relevant studies." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "the Schaeferatlas is employed in 78.2% of relevant studies," ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/629> .

<urn:repronim:abide:abstract/ohbm2026/629/claim/7> a ex:AbstractClaim ;
    rdfs:label "Traditional sequential pipelines represent only 19.7% of usage." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "traditional sequential pipelines (e.g., SPM12 + DPABI + bandpass filtering) now represent only 19.7% of usage," ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/629> .

<urn:repronim:abide:abstract/ohbm2026/629/claim/8> a ex:AbstractClaim ;
    rdfs:label "Fully automated, best-practice frameworks account for 28.1% of usage." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "whereas fully automated, best-practice frameworks (e.g., fMRIPrep + ICA-AROMA + CompCor) account for 28.1%." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/629> .

<urn:repronim:abide:abstract/ohbm2026/629/claim/9> a ex:AbstractClaim ;
    rdfs:label "Privacy-preserving federated learning-enabled pipelines have achieved a 3.8% adoption rate." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "privacy-preserving federated learning–enabled pipelines (e.g., COINSTAC-based federated preprocessing) have achieved a 3.8% adoption rate," ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/629> .

<urn:repronim:abide:abstract/ohbm2026/633/claim/0> a ex:AbstractClaim ;
    rdfs:label "Cortical folding variability is increasingly recognized as a meaningful neuroanatomical signal, particularly in psychiatry and neurodevelopmental research." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Cortical folding variability is increasingly recognized as a meaningful neuroanatomical signal,particularly in psychiatry and neurodevelopmental research." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/633> .

<urn:repronim:abide:abstract/ohbm2026/633/claim/1> a ex:AbstractClaim ;
    rdfs:label "Classical neuroimaging pipelines tend to minimize cortical folding variability through template alignment." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "While classical neuroimaging pipelines tend to minimize this variability through template alignment,recent approaches instead treat folding patterns as biologically informative features." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/633> .

<urn:repronim:abide:abstract/ohbm2026/633/claim/2> a ex:AbstractClaim ;
    rdfs:label "Recent approaches treat folding patterns as biologically informative features." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "While classical neuroimaging pipelines tend to minimize this variability through template alignment,recent approaches instead treat folding patterns as biologically informative features." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/633> .

<urn:repronim:abide:abstract/ohbm2026/633/claim/3> a ex:AbstractClaim ;
    rdfs:label "Cortical surface area, hull surface area, and mean cortical thickness follow a logarithmic-linear scaling law across individuals and species." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "In particular, cortical surface area, hull surface area, and mean cortical thickness have been shownto follow a logarithmic–linear scaling law across individuals and species,indicating that global morphometric organization constrains local folding geometry." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/633> .

<urn:repronim:abide:abstract/ohbm2026/633/claim/4> a ex:AbstractClaim ;
    rdfs:label "The proposed framework integrates subject-level morphometric descriptors into contrastive learning." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Building on the Champollion foundation model, we incorporate a Y-aware contrastive formulation in which pairwise similarities between sulcal embeddings are weighted according to morphometric metadata." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/633> .

<urn:repronim:abide:abstract/ohbm2026/633/claim/5> a ex:AbstractClaim ;
    rdfs:label "Champollion is a self-supervised foundation model for regional cortical folding based on a 3D convolutional neural network." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "After region selection, cropping, and spatial normalization, sulcal segments were encoded using Champollion~\\cite{laval2024self}, a self-supervised foundation model for regional cortical folding based on a 3D convolutional neural network." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/633> .

<urn:repronim:abide:abstract/ohbm2026/633/claim/6> a ex:AbstractClaim ;
    rdfs:label "The method uses a multivariate formulation based on morphometric vectors comprising log-transformed cortical surface area, hull surface area, and mean cortical thickness." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Rather than relying on a single scalar proxy, we introduce a multivariate formulation based on morphometric vectors comprising log-transformed cortical surface area, hull surface area, and mean cortical thickness." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/633> .

<urn:repronim:abide:abstract/ohbm2026/633/claim/7> a ex:AbstractClaim ;
    rdfs:label "The Euclidean distance formulation yielded consistent and statistically significant improvements." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote """By contrast, aggregating multiple morphometric descriptors into a vector and

comparing subjects through a Euclidean distance led to consistent and statistically

significant improvements.""" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/633> .

<urn:repronim:abide:abstract/ohbm2026/633/claim/8> a ex:AbstractClaim ;
    rdfs:label "The proposed approach improves generalization across environmental and clinical prediction tasks." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "By explicitly linking global anatomical organization with local cortical folding patterns, the proposed approach improves generalization across environmental and clinical prediction tasks while yielding interpretable neuroanatomical signatures." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/633> .

<urn:repronim:abide:abstract/ohbm2026/639/claim/0> a ex:AbstractClaim ;
    rdfs:label "ABIDE provides 1,112 rs-fMRI scans from individuals with ASD and age-matched typically developing controls." ;
