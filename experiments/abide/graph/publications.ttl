    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/639> .

<urn:repronim:abide:abstract/ohbm2026/660/claim/0> a ex:AbstractClaim ;
    rdfs:label "The corpus callosum is the largest white-matter structure in the human brain." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "The corpus callosum (CC) is the largest white-matter (WM) structure in the human brain" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/660> .

<urn:repronim:abide:abstract/ohbm2026/660/claim/1> a ex:AbstractClaim ;
    rdfs:label "The corpus callosum plays a central role in interhemispheric communication and in cognitive processes such as memory and olfaction." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "and plays a central role in interhemispheric communication, as well as in cognitive processes such as memory and olfaction." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/660> .

<urn:repronim:abide:abstract/ohbm2026/660/claim/10> a ex:AbstractClaim ;
    rdfs:label "Two dedicated deep learning models determine the location of AC and PC and then segment the corpus callosum." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "On the mid-sagittal plane and adjacent slices, two dedicated deep learning models determine the location of AC & PC and then segment the CC." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/660> .

<urn:repronim:abide:abstract/ohbm2026/660/claim/11> a ex:AbstractClaim ;
    rdfs:label "The method derives an arbitrary number of corpus callosum thickness estimates, subdivides the corpus callosum using a novel geometry-aware subdivision scheme, and produces six shape descriptors." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Combining the CC and AC & PC information, our method derives an arbitrary number of corpus callosum thickness estimates along the anterior-posterior axes, subdivides the CC using a novel geometry-aware subdivision scheme, and produces six shape descriptors." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/660> .

<urn:repronim:abide:abstract/ohbm2026/660/claim/12> a ex:AbstractClaim ;
    rdfs:label "FastSurfer-CC outperforms state-of-the-art methods across the board." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Our method outperforms state-of-the-art methods across the board." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/660> .

<urn:repronim:abide:abstract/ohbm2026/660/claim/13> a ex:AbstractClaim ;
    rdfs:label "FastSurfer-CC demonstrates high segmentation accuracy and is least affected when moving from randomly sampled to challenging cases." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "FastSurfer-CC not only demonstrates high accuracy (=high DSC scores) but is also least affected when moving from randomly sampled cases (Fig. 2a top) to challenging cases (Fig. 2a bottom)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/660> .

<urn:repronim:abide:abstract/ohbm2026/660/claim/14> a ex:AbstractClaim ;
    rdfs:label "The pipeline finds thickness differences between Huntington’s disease patients and controls." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "In Fig. 2b, we demonstrate the power of the whole pipeline in finding thickness differences between Huntington’s disease patients and controls." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/660> .

<urn:repronim:abide:abstract/ohbm2026/660/claim/15> a ex:AbstractClaim ;
    rdfs:label "FastSurfer-CC finds more differences at higher significance than CCseg4." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Our method outperforms the only other analysis tool capable of generating these granular local difference maps (CCseg4) by finding more differences at higher significance." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/660> .

<urn:repronim:abide:abstract/ohbm2026/660/claim/16> a ex:AbstractClaim ;
    rdfs:label "The metrics derived by the method show high test-retest reliability." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Finally, the metrics derived by our method show high test-retest reliability, as indicated by high intraclass correlation coefficients (ICC) shown in Fig. 2c." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/660> .

<urn:repronim:abide:abstract/ohbm2026/660/claim/17> a ex:AbstractClaim ;
    rdfs:label "Estimates of thickness, area, and circularity are close to one, indicating nearly perfect agreement across scans." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Estimates of thickness, area, and circularity are close to one, indicating nearly perfect agreement across scans." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/660> .

<urn:repronim:abide:abstract/ohbm2026/660/claim/18> a ex:AbstractClaim ;
    rdfs:label "FastSurfer-CC is being integrated into the FastSurfer toolbox." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361>,
        <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "FastSurfer-CC is being integrated into the FastSurfer toolbox ([https://github.com/Deep-MI/FastSurfer](https://github.com/Deep-MI/FastSurfer)), enabling broad and seamless use within standard structural MRI processing workflows." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/660> .

<urn:repronim:abide:abstract/ohbm2026/660/claim/2> a ex:AbstractClaim ;
    rdfs:label "Alterations of the corpus callosum have been linked to epilepsy, autism, and schizophrenia." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Alterations of the CC have been linked to a range of neurological and psychiatric disorders, including epilepsy, autism, and schizophrenia." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/660> .

<urn:repronim:abide:abstract/ohbm2026/660/claim/3> a ex:AbstractClaim ;
    rdfs:label "Most structural MRI studies restrict corpus callosum segmentation to predefined midsagittal slices because it lacks clearly defined borders with white matter of the left and right hemispheres." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361>,
        <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Although the CC has distinct boundaries in the sagittal plane, it lacks clearly defined borders with WM of the left and right hemispheres. Consequently, most structural MRI studies restrict CC segmentation to predefined midsagittal slices." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/660> .

<urn:repronim:abide:abstract/ohbm2026/660/claim/4> a ex:AbstractClaim ;
    rdfs:label "Existing work frequently addresses head-pose normalization and segmentation independently, which can lead to error propagation and biased measurements of corpus callosum size and shape." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361>,
        <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Existing work frequently addresses head-pose normalization and segmentation independently1, which can lead to error propagation and biased measurements of CC size and shape." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/660> .

<urn:repronim:abide:abstract/ohbm2026/660/claim/5> a ex:AbstractClaim ;
    rdfs:label "Local morphological variations are associated with different diseases and are of broad research interest." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Moreover, local morphological variations are associated with different diseases and remain of broad research interest, indicating the importance of robust and sensitive tools that capture both global and regional CC changes." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/660> .

<urn:repronim:abide:abstract/ohbm2026/660/claim/6> a ex:AbstractClaim ;
    rdfs:label "The authors present a comprehensive corpus callosum analysis pipeline." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361>,
        <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "To meet this need, we present a comprehensive CC analysis pipeline2 that (i) determines the mid-sagittal plane for CC analysis, (ii) localizes the anterior and posterior commissures (AC and PC), (iii) segments CC and fornix, (iv) computes morphometric features including area, length, curvature, and thickness, and (v) performs geometric sub-segmentation (Fig. 1)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/660> .

<urn:repronim:abide:abstract/ohbm2026/660/claim/7> a ex:AbstractClaim ;
    rdfs:label "The dataset includes 280 T1-weighted brain MRIs from multiple scanners and studies." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We develop and evaluate our methods on a dataset of 280 T1-weighted brain MRIs from 7T, 3T, and 1.5T scanners of the HCP, ADNI, OASIS, ABIDE-II, MIRIAD, la5c, Rhineland-, and in-house studies." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/660> .

<urn:repronim:abide:abstract/ohbm2026/660/claim/8> a ex:AbstractClaim ;
    rdfs:label "A subset of the PREDICT-HD dataset was used for evaluation." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Additionally, we use a subset of the PREDICT-HD dataset (predict Huntington’s disease, 12686 cases) for evaluation." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/660> .

<urn:repronim:abide:abstract/ohbm2026/660/claim/9> a ex:AbstractClaim ;
    rdfs:label "The method determines the mid-sagittal plane using centroid registration of FastSurfer cortical segmentation labels to Talairach space." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Our method determines the mid-sagittal plane based on a centroid registration of FastSurfer’s cortical segmentation labels to Talairach space." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/660> .

<urn:repronim:abide:abstract/ohbm2026/698/claim/0> a ex:AbstractClaim ;
    rdfs:label "The study used ABIDE II data from 146 ASD and 128 TD participants aged 5 to 64 years." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Diffusion and structural T1-weighted (T1w) MRI, clinical and cognitive data from 146 ASD and age and sex matched 128 typically developing (TD) participants (ages 5-64 years) were obtained from ABIDE II^(5)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/698> .

<urn:repronim:abide:abstract/ohbm2026/698/claim/1> a ex:AbstractClaim ;
    rdfs:label "ASD participants had increased free water in widespread regions compared with typically developing participants." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Compared to TD, ASD showed increased FW in widespread regions through voxel-wise analyses (p <0.05 but not p < 0.05 FDR-corrected), and in the left cingulate, left superior temporal gyrus, left pallidum and right superior frontal gray matter at p < .05 FDR corrected-level via ROI analyses (Figure 1a)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/698> .

<urn:repronim:abide:abstract/ohbm2026/698/claim/2> a ex:AbstractClaim ;
    rdfs:label "ASD participants had significantly lower ALPS indices than TD participants before covariate adjustment." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "The ASD group had significantly lower ALPS indices (p = 0.005-0.025) consistent with other studies, but this went away after controlling for age, sex, FIQ, handedness and site (driven by age)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/698> .

<urn:repronim:abide:abstract/ohbm2026/698/claim/3> a ex:AbstractClaim ;
    rdfs:label "Age was significantly positively related to the ALPS indices in all groups." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Age was significantly positively related to the ALPS indices in all groups (p < 0.01)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/698> .

<urn:repronim:abide:abstract/ohbm2026/698/claim/4> a ex:AbstractClaim ;
    rdfs:label "ALPS indices were significantly positively associated with FW." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "The ALPS indices were significantly positively associated with FW, most notably in frontal, hippocampal and cerebellar regions via the voxel-wise analyses and ROIs analyses at the p < 0.05 FDR-corrected level (Figure panel 1b & 2a-b)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/698> .

<urn:repronim:abide:abstract/ohbm2026/698/claim/5> a ex:AbstractClaim ;
    rdfs:label "In ASD, increased FW was associated with increased ADOS, BDI, and ADI scores and decreased Vineland scores." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "In the ASD group, increased FW, particularly in subcortical hippocampus, pallidum, thalamus, amygdala, caudate and putamen areas at p < 0.05 FDR-correction-level, was associated with an increase in all ADOS, BDI and ADI scores, where increase scores indicate increase symptoms, and decreased Vineland scores, where decreased scores indicate poorer functioning (Figure panel 1C and Figure panel 2D-E)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/698> .

<urn:repronim:abide:abstract/ohbm2026/698/claim/6> a ex:AbstractClaim ;
    rdfs:label "The ALPS-FW correlation was stronger in young TD than in young ASD." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "When the groups were broken down by age, the ALPS-FW correlation was strongly positive in young TD (r=0.86, p<0.001) but significantly weaker in young ASD (r=0.41, p=0.02; Fisher's z=-2.61, p=0.009), suggesting disrupted coordination between glymphatic function and extracellular water homeostasis early in development (Figure panel 2a)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/698> .

<urn:repronim:abide:abstract/ohbm2026/698/claim/7> a ex:AbstractClaim ;
    rdfs:label "In adolescence, FW was most significantly increased compared with TD and had the strongest positive correlation with symptoms." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "In the Adolescent group, FW was the most significantly increased compared to TD, and had the strongest positive correlation to symptoms, correlating positively with ADOS communication deficits across 39/116 regions surviving FDR correction (Figure Panel 2b-e)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/698> .

<urn:repronim:abide:abstract/ohbm2026/698/claim/8> a ex:AbstractClaim ;
    rdfs:label "ASD showed reduced ALPS versus TD in the oldest tertile only." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Finally, ASD showed reduced ALPS versus TD in the oldest tertile only (d=-0.52, p=0.02), with trajectories diverging by symptom severity, which was established by SRS > 76 severe (N=99), and < 76 less severe (N=123) and a significant age by severity interaction (p = 0.022*) (Figure Panel 2f)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/698> .

<urn:repronim:abide:abstract/ohbm2026/733/claim/0> a ex:AbstractClaim ;
    rdfs:label "rs-fMRI has yet to deliver reproducible, clinically meaningful biomarkers." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Despite its widespread use, rs-fMRI has yet to deliver reproducible, clinically meaningful biomarkers." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/733> .

<urn:repronim:abide:abstract/ohbm2026/733/claim/1> a ex:AbstractClaim ;
    rdfs:label "Methodological heterogeneity is a key limitation in rs-fMRI." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "A key limitation is the methodological heterogeneity in the field." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/733> .

<urn:repronim:abide:abstract/ohbm2026/733/claim/2> a ex:AbstractClaim ;
    rdfs:label "Methodological heterogeneity can hinder cross-site integration and bias results in large-scale, multi-site initiatives such as ENIGMA." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "This limitation is particularly problematic in large-scale, multi-site initiatives such as the ENIGMA Consortium, where methodological heterogeneity can hinder cross-site integration and bias results." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/733> .

<urn:repronim:abide:abstract/ohbm2026/733/claim/3> a ex:AbstractClaim ;
    rdfs:label "No consensus exists on the most effective confound denoising approach." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Previous studies have assessed confound denoising using selected quality control metrics[2](https://paperpile.com/c/MOt3Oz/4apw), but no consensus exists on the most effective approach." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/733> .

<urn:repronim:abide:abstract/ohbm2026/733/claim/4> a ex:AbstractClaim ;
    rdfs:label "The project provides a guideline for denoising based on motion-quality metrics and quantitative analytic insights into functional connectivity." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "This project provides a guideline for denoising based on motion-quality metrics and quantitative analytic insights into functional connectivity, a cornerstone of contemporary rs-fMRI applications." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/733> .

<urn:repronim:abide:abstract/ohbm2026/733/claim/5> a ex:AbstractClaim ;
    rdfs:label "The study analyzed the UCLA Consortium for Neuropsychiatric Phenomics dataset and the ABIDE1 dataset." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We analyzed two open-access rs-fMRI datasets: (1) the UCLA Consortium for Neuropsychiatric Phenomics[3](https://paperpile.com/c/MOt3Oz/24eV) (ds000030; n = 272) and the Autism Brain Imaging Data Exchange 1 [4](https://paperpile.com/c/MOt3Oz/WWzg)(ABIDE1; n = 1112)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/733> .

<urn:repronim:abide:abstract/ohbm2026/733/claim/6> a ex:AbstractClaim ;
    rdfs:label "Preprocessing and connectivity matrices were generated using a combined atlas with HALFpipe, applying 18 distinct denoising strategies." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Preprocessing and connectivity matrices were generated using a combined atlas with HALFpipe[5](https://paperpile.com/c/MOt3Oz/PFNG), applying 18 distinct denoising strategies (Figure 1A)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/733> .

<urn:repronim:abide:abstract/ohbm2026/733/claim/7> a ex:AbstractClaim ;
    rdfs:label "All strategies included high-pass filtering." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "All strategies included high-pass filtering." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/733> .

<urn:repronim:abide:abstract/ohbm2026/733/claim/8> a ex:AbstractClaim ;
    rdfs:label "Automatic QC excluded participants with a mean framewise displacement > 0.5 mm or a maximum displacement > 3.0 mm." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Automatic QC excluded participants with a mean framewise displacement > 0.5 mm or a maximum displacement > 3.0 mm." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/733> .

<urn:repronim:abide:abstract/ohbm2026/733/claim/9> a ex:AbstractClaim ;
    rdfs:label "After QC, the final samples included n = 641 for ABIDE1 and n = 193 for ds000030." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "After QC, the final samples included n = 641 for ABIDE1 and n = 193 for ds000030." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/733> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/0> a ex:AbstractClaim ;
    rdfs:label "Autism is a neurodevelopmental condition concerning about 1 in 100 people." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Autism is a neurodevelopmental condition concerning about 1 in 100 people." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/1> a ex:AbstractClaim ;
    rdfs:label "Incomplete hippocampal inversion (IHI) is a developmental variant in which fetal inversion of the hippocampus is incomplete, yielding a rounder, more vertical hippocampus and often a deep collateral sulcus." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Incomplete hippocampal inversion (IHI) is a developmental variant in which fetal inversion of the hippocampus is incomplete, yielding a rounder, more vertical hippocampus and often a deep collateral sulcus." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/10> a ex:AbstractClaim ;
    rdfs:label "InovAND contributed to clustering only and was excluded from imaging analyses because its scans were 1.5T while our IHI model was trained on 3T data." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "InovAND contributed to clustering only and was excluded from imaging analyses because its scans were 1.5T while our IHI model was trained on 3T data." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/11> a ex:AbstractClaim ;
    rdfs:label "After clustering, we retained cluster labels and then restricted the study to participants with a valid T1 MRI and a successful automated IHI rating from ABIDE1, ABIDE2, and LEAP (n=1747)." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "After clustering, we retained cluster labels and then restricted the study to participants with a valid T1 MRI and a successful automated IHI rating from ABIDE1, ABIDE2, and LEAP (n=1747)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/12> a ex:AbstractClaim ;
    rdfs:label "SRS raw scores were converted to age, sex, and rater-standardized T-scores and capped at 90." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "For statistical analyses, SRS raw scores were converted to age, sex, and rater-standardized T-scores and capped at 90." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/13> a ex:AbstractClaim ;
    rdfs:label "We adjusted the IHI composite score and each individual criterion for age, age squared, sex, and site using ordinary least squares and used residuals in downstream tests." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "We adjusted the IHI composite score and each individual criterion for age, age squared, sex, and site using ordinary least squares and used residuals in downstream tests." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/14> a ex:AbstractClaim ;
    rdfs:label "Autism risk per unit increase in IHI was estimated with logistic regression." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Autism risk per unit increase in IHI was estimated with logistic regression, reporting odds ratios (ORs) and 95% confidence intervals." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/15> a ex:AbstractClaim ;
    rdfs:label "Associations between adjusted IHI and dimensional traits (IQ, SRS) were tested using Spearman correlations." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Associations between adjusted IHI and dimensional traits (IQ, SRS) were tested using Spearman correlations given non-normal IHI distributions." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/16> a ex:AbstractClaim ;
    rdfs:label "For IQ, both hemispheres showed weak negative correlations with composite IHI score: left r = -0.04 and right r = -0.05." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "For IQ, both hemispheres showed weak negative correlations: left r = -0.04 (p = 0.050) and right r = -0.05 (p = 0.023)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/17> a ex:AbstractClaim ;
    rdfs:label "After FDR correction, neither IQ correlation remained significant." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "After FDR correction, neither remained significant." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/18> a ex:AbstractClaim ;
    rdfs:label "For SRS, neither hemisphere showed evidence of association with the composite IHI score." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "For SRS, neither hemisphere showed evidence of association with the composite IHI score (left r = 0.04, p = 0.274; right r = 0.01, p = 0.791), and these findings remained non-significant after multiple-comparison control." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/19> a ex:AbstractClaim ;
    rdfs:label "In the IQ model, only C1_L, relating to the roundness of the hippocampus, showed a statistically significant association after FDR correction for eight tests." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In the IQ model, only C1_L, relating to the roundness of the hippocampus, showed a statistically significant association after FDR correction for eight tests (standardized β = -0.09; p ≤ 0.006)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/2> a ex:AbstractClaim ;
    rdfs:label "IHI lies on a continuum and is relatively common (pronounced forms up to ~20% of people in the left hemisphere, ~9% right)." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "IHI lies on a continuum and is relatively common (pronounced forms up to ~20% of people in the left hemisphere, ~9% right)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/20> a ex:AbstractClaim ;
    rdfs:label "Across analyses, the study found no robust link between IHI and autism." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "First, across analyses, we found no robust link between IHI and autism: in case-control models, pooled odds ratios for every criterion and the composite were near 1, only few being moderately significant and none survived multiple testing." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/3> a ex:AbstractClaim ;
    rdfs:label "Because binary definitions have been inconsistent, a multi-criteria system frames IHI as a continuous score with better reproducibility." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Because binary definitions have been inconsistent, a multi-criteria system frames IHI as a continuous score with better reproducibility.^2" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/4> a ex:AbstractClaim ;
    rdfs:label "The study assembled four autism cohorts with T1-weighted MRI." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We assembled four autism cohorts with T1-weighted MRI: the Autism Brain Imaging Data Exchange 1 (ABIDE1) (n=814; 430 neurotypical (NT), 384 autistic participants; 20 sites; mean age 18.3±8.4; 14.3% female), ABIDE2 (n=811; 452 NT, 359 autistic participants; 16 sites; mean age 15.1±9.6; 23% female),^4 and the Longitudinal European Autism Project (LEAP) (n=581; 235 NT, 346 autistic participants; 6 sites; mean age 17.0±5.7; 31% female).^5" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/5> a ex:AbstractClaim ;
    rdfs:label "Each participant contributed one T1 MRI, yielding 2,206 scans (978 autistic, 1,228 NT)." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Each participant contributed one T1 MRI, yielding 2,206 scans (978 autistic, 1,228 NT)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/6> a ex:AbstractClaim ;
    rdfs:label "IHI was quantified using an automated rater^3 that predicts four anatomical criteria: hippocampal roundness, collateral sulcus verticality, hippocampal mediality, and occipito-temporal/collateral sulcus depth, and sums them into a 0-8 composite score per hemisphere (higher indicates more pronounced IHI, figure 1a)." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "IHI was quantified using an automated rater^3 that predicts four anatomical criteria: hippocampal roundness, collateral sulcus verticality, hippocampal mediality, and occipito-temporal/collateral sulcus depth, and sums them into a 0-8 composite score per hemisphere (higher indicates more pronounced IHI, figure 1a)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/7> a ex:AbstractClaim ;
    rdfs:label "The convolutional neural network (5 convolutional layers, 3 fully connected) was trained on manually annotated adolescent/young-adult cohorts and validated on independent data." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "The convolutional neural network (5 convolutional layers, 3 fully connected) was trained on manually annotated adolescent/young-adult cohorts and validated on independent data." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/8> a ex:AbstractClaim ;
    rdfs:label "This full-sample set included participants with SRS and IQ from ABIDE, LEAP, and the external InoVAND cohort yielding N=2,210 (figure 1b)." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "This full-sample set included participants with SRS and IQ from ABIDE, LEAP, and the external InoVAND cohort yielding N=2,210 (figure 1b)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/931/claim/9> a ex:AbstractClaim ;
    rdfs:label "Cluster 1 is the closest to the NT behavior, while cluster 3 shows behaviors more similar to the ID group (figure 1.c.)." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Cluster 1 is the closest to the NT behavior, while cluster 3 shows behaviors more similar to the ID group (figure 1.c.)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/931> .

<urn:repronim:abide:abstract/ohbm2026/966/claim/0> a ex:AbstractClaim ;
    rdfs:label "The study assembled a large-scale, multi-site cohort for FNC analysis comprising 3,834 neurotypical participants." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "We assembled a large-scale, multi-site cohort for FNC analysis using the Neuromark_fMRI_1.0^(5) template, comprising a total of 3,834 neurotypical participants drawn from HCP-D, HCP-YA, HCP-A, FBIRN COBRE, LA5C, Chinese Han MDD, ABIDE (I and II), and ADHD200 datasets." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/966> .

<urn:repronim:abide:abstract/ohbm2026/966/claim/1> a ex:AbstractClaim ;
    rdfs:label "Normative modeling was performed with warped Bayesian linear regression as implemented in PCNtoolkit." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Normative modeling was performed with the warped Bayesian linear regression, as implemented in PCNtoolkit." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/966> .

<urn:repronim:abide:abstract/ohbm2026/966/claim/10> a ex:AbstractClaim ;
    rdfs:label "Astrocytes emerged as the top contributor at nearly all ages among cell types." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "For cell types, layer 6b neurons (L6b), astrocytes (Astro), oligodendrocyte precursor cells (OPC), and oligodendrocytes (Oligo) consistently exhibited high relative importance across life stages, with Astro emerging as the top contributor at nearly all ages." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/966> .

<urn:repronim:abide:abstract/ohbm2026/966/claim/11> a ex:AbstractClaim ;
    rdfs:label "For neurotransmitter systems, 5-HT1a, D2, and NMDA showed persistent contributions across the lifespan." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "For neurotransmitter systems, 5-hydroxytryptamine receptor 1A (5-HT1a), dopamine D2 receptor (D2), and N-methyl-D-aspartate receptor (NMDA) showed persistent contributions across the lifespan, with NMDA being the most dominant across nearly all stages." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/966> .

<urn:repronim:abide:abstract/ohbm2026/966/claim/12> a ex:AbstractClaim ;
    rdfs:label "For mitochondrial markers, complex 1 and mitochondrial tissue density robustly explained FNC variance throughout the lifespan." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "For mitochondrial markers, complex 1 (C1) and mitochondrial tissue density (MitoD) robustly explained FNC variance throughout the lifespan." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/966> .

<urn:repronim:abide:abstract/ohbm2026/966/claim/13> a ex:AbstractClaim ;
    rdfs:label "Mitochondrial phenotypes, including CI and MitoD, revealed a metabolic substrate underlying functional network stability and change." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Mitochondrial phenotypes, including CI and MitoD, further revealed a metabolic substrate underlying functional network stability and change, with peak contributions around major developmental transitions." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/966> .

<urn:repronim:abide:abstract/ohbm2026/966/claim/2> a ex:AbstractClaim ;
    rdfs:label "For each FNC edge, connectivity strength was modeled as a function of age, sex, head motion, and site." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "For each FNC edge, connectivity strength was modeled as a function of age, sex, head motion, and site." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/966> .

<urn:repronim:abide:abstract/ohbm2026/966/claim/3> a ex:AbstractClaim ;
    rdfs:label "The study generated lifespan trajectories for each edge by sampling 75 discrete integer ages spanning 6 to 80 years." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Using the fitted normative models, we generated lifespan trajectories for each edge by sampling 75 discrete integer ages spanning 6 to 80 years." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/966> .

<urn:repronim:abide:abstract/ohbm2026/966/claim/4> a ex:AbstractClaim ;
    rdfs:label "Pairwise similarity between brain regions was defined as 1−JSD." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Pairwise similarity between brain regions was then defined as 1−JSD, resulting in a symmetric similarity matrix for each marker." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/966> .

<urn:repronim:abide:abstract/ohbm2026/966/claim/5> a ex:AbstractClaim ;
    rdfs:label "The study constructed multiple linear regression models with selected microprofile networks as predictors and the FNC or FNC-change matrix as the dependent variable." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "For each age point, we constructed multiple linear regression models with selected microprofile networks (cellular/neurotransmitter/mitochondrion) as predictors and the FNC (or FNC-change) matrix as the dependent variable." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/966> .

<urn:repronim:abide:abstract/ohbm2026/966/claim/6> a ex:AbstractClaim ;
    rdfs:label "The study generated 1,000 surrogate FNC maps by randomly permuting edge positions." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "For each analysis, we generated 1,000 surrogate FNC maps by randomly permuting edge positions, yielding null distributions for the adjusted _r_² and predictor-specific dominance." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/966> .

<urn:repronim:abide:abstract/ohbm2026/966/claim/7> a ex:AbstractClaim ;
    rdfs:label "The p-values for adjusted r² were corrected for 75 age-point comparisons using the false discovery rate procedure." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "The _p_-values for adjusted _r_² were corrected for 75 age-point comparisons using the false discovery rate (FDR) procedure." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/966> .

<urn:repronim:abide:abstract/ohbm2026/966/claim/8> a ex:AbstractClaim ;
    rdfs:label "Across the lifespan, multivariate analyses revealed sustained colocalization between FNCs and neurobiological microprofile networks for cell types, neurotransmitters, and mitochondria." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Across the lifespan, multivariate analyses revealed sustained colocalization between FNCs and neurobiological microprofile networks across life stages for all three categories: cell types (adjusted _r_^(2) = 0.21 ± 0.01), neurotransmitters (adjusted _r_^(2) = 0.14 ± 0.02), and mitochondria (adjusted _r_^(2) = 0.12 ± 0.01)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/966> .

<urn:repronim:abide:abstract/ohbm2026/966/claim/9> a ex:AbstractClaim ;
    rdfs:label "All associations were statistically significant with FDR q < 0.05." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
