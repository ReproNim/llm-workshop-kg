<urn:repronim:abide:abstract/ohbm2026/639/claim/9> a ex:AbstractClaim ;
    rdfs:label "The model achieved 74% subject-level accuracy and a weighted F1-score of 0.76." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
