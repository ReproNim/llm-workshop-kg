    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "As in 1) and 2), model parameters were chosen by minimizing the BIC, providing a penalty on the degrees of freedom." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2033> .

<urn:repronim:abide:abstract/ohbm2026/2033/claim/18> a ex:AbstractClaim ;
    rdfs:label "The resulting curves successfully captured the trajectory of controllability throughout gestation and birth." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The resulting curves successfully captured the trajectory of controllability throughout gestation and birth (Fig. 1C)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2033> .

<urn:repronim:abide:abstract/ohbm2026/2033/claim/19> a ex:AbstractClaim ;
    rdfs:label "GAMLSS provides a toolset well-suited to modeling developmental trajectories in a range of distributions in human neuroimaging data." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "GAMLSS provides a toolset well-suited to modeling developmental trajectories in a range of distributions in human neuroimaging data." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2033> .

<urn:repronim:abide:abstract/ohbm2026/2033/claim/2> a ex:AbstractClaim ;
    rdfs:label "GAMLSS models are susceptible to overfitting due to the flexibility of the smoothing terms." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "For many datasets, GAMLSS models are susceptible to overfitting due to the flexibility of the smoothing terms." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2033> .

<urn:repronim:abide:abstract/ohbm2026/2033/claim/3> a ex:AbstractClaim ;
    rdfs:label "The manuscript presents three illustrative case studies of GAMLSS applications to human developmental neuroimaging data." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "We present three illustrative case studies of GAMLSS applications to human developmental neuroimaging data." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2033> .

<urn:repronim:abide:abstract/ohbm2026/2033/claim/4> a ex:AbstractClaim ;
    rdfs:label "Each case study required different curve-optimization approaches." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Each required different curve-optimization approaches, suggesting that GAMLSS modeling is not a simple, out-of-the-box approach." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2033> .

<urn:repronim:abide:abstract/ohbm2026/2033/claim/5> a ex:AbstractClaim ;
    rdfs:label "In experiment 1, the authors modeled state engagement variability in 4,091 participants from multiple datasets." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "1) We modeled the development of state engagement variability—a metric of neural variability measured through fMRI-derived brain states^1—in 4091 (1997 female) participants from the Philadelphia Neurodevelopmental Cohort, Healthy Brain Network, Human Connectome Project-Development, UCLA Consortium for Neuropsychiatric Phenomics, Japanese SRPBS, Transdiagnostic Connectome Project, HCP-Early Psychosis, and HCP-Aging datasets." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2033> .

<urn:repronim:abide:abstract/ohbm2026/2033/claim/6> a ex:AbstractClaim ;
    rdfs:label "In experiment 2, the authors created longitudinal normative growth curves of VEP morphology using 1,374 VEPs across 802 infants from South Africa, Brazil, and the United States." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "2) We created longitudinal normative growth curves of visual-evoked potential (VEP) morphology—a robust EEG response of visual neurodevelopment—with 1,374 VEPs across 802 infants (57 to 579 days old) from South Africa (622 obs. from 303 infants), Brazil (500 observations from 390 infants), and the United States (252 obs. from 109 infants).^2" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2033> .

<urn:repronim:abide:abstract/ohbm2026/2033/claim/7> a ex:AbstractClaim ;
    rdfs:label "In experiment 3, the authors used structural connectomes from fetuses, preterm infants, and term infants in the developing Human Connectome Project to chart changes to whole-brain controllability." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "3) We used structural connectomes from fetuses, preterm infants, and term infants in the developing Human Connectome Project (N=859; 393 female) to chart changes to whole-brain controllability.^3" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2033> .

<urn:repronim:abide:abstract/ohbm2026/2033/claim/8> a ex:AbstractClaim ;
    rdfs:label "In experiment 1, the authors used a Bayesian Information Criterion within each model term to penalize overfitting." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In 1), we used a Bayesian Information Criterion within each model term to penalize overfitting." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2033> .

<urn:repronim:abide:abstract/ohbm2026/2033/claim/9> a ex:AbstractClaim ;
    rdfs:label "Using p-spline smoothing terms with the BIC provided an ideal balance of model bias and variance." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Using p-spline smoothing terms with the BIC provided an ideal balance of model bias and variance." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2033> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/0> a ex:AbstractClaim ;
    rdfs:label "Resting-state fMRI networks can be employed to increase understanding of the functional organization of the healthy brain and to investigate how this organization is disrupted across distinct brain disorders." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Resting-state fMRI networks (RSNs) can be employed to increase our understanding of the functional organization of the healthy brain and to investigate how this organization is disrupted across distinct brain disorders." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/1> a ex:AbstractClaim ;
    rdfs:label "Resting-state acquisitions lack an experimental design and therefore rely on data-driven methods." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "In contrast to task-based fMRI, resting-state acquisitions lack an experimental design and therefore rely on data-driven methods." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/10> a ex:AbstractClaim ;
    rdfs:label "The cleaned rs-fMRI data from all subjects were temporally concatenated and submitted to MELODIC ICA with limited dimensionality of 20 ICs." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Then, cleaned rs-fMRI data from all subjects were temporally concatenated and submitted to MELODIC ICA with limited dimensionality (20 ICs)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/11> a ex:AbstractClaim ;
    rdfs:label "The group-level components were correlated with a reference study and significant RSNs were used as predictors to derive individual-level component timeseries and associated spatial maps." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "The resulting group-level components were correlated with a reference study^(3) and the significant RSNs (Pearson’s r > 0.25) were used as predictors to derive individual-level component timeseries and associated spatial maps (DR)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/12> a ex:AbstractClaim ;
    rdfs:label "Between-group differences were determined using nonparametric permutation testing and TFCE to control multiple comparisons at p<0.05." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Between-group differences were determined using nonparametric permutation testing (5000 permutations) and threshold-free cluster enhancement (TFCE) approach to control multiple comparisons (p<0.05)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/13> a ex:AbstractClaim ;
    rdfs:label "Brain areas were identified in FSLeyes with Harvard-Oxford cortical and subcortical atlases." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Brain areas were identifying in FSLeyes with Harvard-Oxford cortical and subcortical atlases (Figure 1)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/14> a ex:AbstractClaim ;
    rdfs:label "Following the group ICA, seven RSNs were identified through correlation with the reference study: visual, default mode, sensorimotor, cerebellum, auditory, executive control and frontoparietal networks." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Following the group ICA, seven RSNs were identified through correlation with the reference study: visual (VN), default mode (DMN), sensorimotor (SMN), cerebellum (CN), auditory (AN), executive control (ECN) and frontoparietal (FPN) networks." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/15> a ex:AbstractClaim ;
    rdfs:label "Six of the identified networks showed statistically significant differences between healthy controls and schizophrenia patients following stage 3 of the DR analysis." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Six of these networks showed statistically significant differences between HC and SZ following stage 3 of the DR analysis." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/16> a ex:AbstractClaim ;
    rdfs:label "The schizophrenia group exhibited increased functional connectivity within the posterior DMN, particularly in the precuneus, and hyperconnectivity with left-lateralized sensory-processing areas." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In comparison with the HC group, the SZ group exhibited increased functional connectivity within the posterior DMN, particularly in the precuneus, as well as hyperconnectivity of this network with left-lateralized sensory-processing areas (Figure 2a)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/17> a ex:AbstractClaim ;
    rdfs:label "Patients exhibited reduced activation within the VN, the SMN, and the ECN, including the bilateral frontal pole, frontal medial cortex, and the left paracingulate gyrus." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "On the other hand, patients exhibited reduced activationwithin the VN (lateral portion and occipital pole), the SMN, and the ECN, including the bilateral frontal pole, frontal medial cortex, and the left paracingulate gyrus." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/18> a ex:AbstractClaim ;
    rdfs:label "Patients also revealed hypoconnectivity between the right putamen and the SMN, and between the left putamen and the AN." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Patients also revealed hypoconnectivity between the right putamen and the SMN, as well as between the left putamen and the AN (Figure 2b)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/19> a ex:AbstractClaim ;
    rdfs:label "The findings are consistent with recent studies indicating that hyperactivation in the posterior default mode network may be associated with misattribution of thoughts and internal experiences characteristic of psychosis, including hallucinations." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "These findings area consisted with recent studies indicating that hyperactivation in the posterior default mode network (DMN) may be associated with the misattribution of thoughts and internal experiences characteristic of psychosis, including hallucinations.^(4)" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/2> a ex:AbstractClaim ;
    rdfs:label "Independent component analysis combined with dual regression is an effective model-free approach for assessing group differences in RSNs." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Among these, independent component analysis (ICA) combined with dual regression (DR) has been demonstrated to be an effective model-free approach for assessing group differences in RSNs.^(1)" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/20> a ex:AbstractClaim ;
    rdfs:label "Reduced functional connectivity in prefrontal regions and hypoconnectivity between the putamen and sensorimotor areas may reflect negative symptoms and cognitive impairments commonly associated with schizophrenia." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361>,
        <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Simultaneously, reduced functional connectivity in prefrontal regions and hypoconnectivity between the putamen and sensorimotor areas may reflect negative symptoms and cognitive impairments commonly associated with schizophrenia.^(5)" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/21> a ex:AbstractClaim ;
    rdfs:label "The present findings indicate that RSNs are differentially affected in schizophrenia, with both hyper- and hypoconnectivity patterns emerging across sensory, motor, and higher-order cognitive systems." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "The present findings indicate that RSNs are differentially affected in schizophrenia, with both hyper- and hypoconnectivity patterns emerging across sensory, motor, and higher-order cognitive systems." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/22> a ex:AbstractClaim ;
    rdfs:label "Alterations in the posterior default mode network, sensorimotor circuits, and prefrontal regions converge with previous evidence, reinforcing the notion that disruptions in large-scale network organization underlie core symptoms of the disorder." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361>,
        <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Alterations in the posterior default mode network, sensorimotor circuits, and prefrontal regions converge with previous evidence, reinforcing the notion that disruptions in large-scale network organization underlie core symptoms of the disorder." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/23> a ex:AbstractClaim ;
    rdfs:label "The reproducibility of these findings across independent investigations highlights the potential of aberrant connectivity in higher-level networks as reliable biomarkers." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Importantly, although previous studies have reported diverse and sometimes conflicting results, the reproducibility of these findings across independent investigations highlights the potential of aberrant connectivity in higher-level networks as reliable biomarkers." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/3> a ex:AbstractClaim ;
    rdfs:label "The study aimed to design a pipeline to identify significant group differences and evaluate reproducibility by comparing results with the literature." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "The aim of this study was to design a pipeline to identify significant group differences and to evaluate the reproducibility of these findings by comparing them with results reported in the literature, thereby contributing to the establishment of potential biomarkers for schizophrenia." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/4> a ex:AbstractClaim ;
    rdfs:label "The dataset analyzed originates from the UCLA Consortium for Neuropsychiatric Phenomics LA5c." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "The dataset analyzed originates from the UCLA Consortium for Neuropsychiatric Phenomics LA5c (open-access, OpenNeuro repository)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/5> a ex:AbstractClaim ;
    rdfs:label "The dataset includes 121 healthy controls and 50 patients with schizophrenia." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "It comprises 121 healthy controls (HC) and 50 patients with schizophrenia (SZ), both with age-range of 21-50 years (M=32.9, SD=9.0) and with education level-matched." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/6> a ex:AbstractClaim ;
    rdfs:label "fMRI data were acquired in a 3T Siemens Trio scanner with the specified EPI protocol." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "fMRI data were acquired in a 3T Siemens Trio scanner with an EPI protocol (slice thickness=4mm, 34 slices, TR=2s, TE=30ms, flip angle=90°, matrix 64×64, FOV=192mm, oblique slice orientation)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/7> a ex:AbstractClaim ;
    rdfs:label "During the rs-fMRI scan, participants were instructed to relax and keep their eyes open." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "During the rs-fMRI scan, the participants were instructed to relax and keep their eyes open." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/8> a ex:AbstractClaim ;
    rdfs:label "The first two volumes of each individual functional scan were discarded to ensure magnetization equilibrium." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The first two volumes of each individual functional scan were discarded to ensure magnetization equilibrium." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2088/claim/9> a ex:AbstractClaim ;
    rdfs:label "Standard preprocessing included slice timing, motion correction, removal of non-brain tissues, normalization to MNI152 template, high-pass filtering, spatial smoothing, resampling to 2x2x2m voxel size, ICA decomposition with automatic dimensionality and signal denoising using FIX." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Standard preprocessing included: slice timing, motion correction, removal of non-brain tissues, normalization to MNI152 template, high-pass filtering (0.01Hz), spatial smoothing (5mm FWHM), resampling to 2x2x2m^(3 )voxel size, ICA decomposition with automatic dimensionality and signal denoising using FMRIB's ICA-based Xnoiseifier (FIX)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2088> .

<urn:repronim:abide:abstract/ohbm2026/2095/claim/0> a ex:AbstractClaim ;
    rdfs:label "Autism spectrum disorder is a neurodevelopmental condition characterised by cognitive and/or behavioural impairments." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Autism spectrum disorder (ASD) is a neurodevelopmental condition characterised by cognitive and/or behavioural impairments." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2095> .

<urn:repronim:abide:abstract/ohbm2026/2095/claim/1> a ex:AbstractClaim ;
    rdfs:label "Diagnosis of ASD is usually a multidisciplinary and time-consuming process." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Diagnosis of ASD is usually a multidisciplinary and time-consuming process, involving mainly neuropsychological assessments and, occasionally, neuroimaging assessments." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2095> .

<urn:repronim:abide:abstract/ohbm2026/2095/claim/10> a ex:AbstractClaim ;
    rdfs:label "Unconventional connectivity metrics H2 and MIT could be useful for identifying ASD biomarkers in future studies." ;
    ex:claimTypeAbstractAtlas "IMPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "unconventional brain functional connectivity metrics such as H2 and MIT demonstrate potential and could be a useful strategy for identifying ASD biomarkers in future studies." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2095> .

<urn:repronim:abide:abstract/ohbm2026/2095/claim/2> a ex:AbstractClaim ;
    rdfs:label "The study used resting-state fMRI data from ABIDE I Preprocessed." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Raw data were obtained from the publicly available database ABIDE I Preprocessed (Autism Brain Imaging Data Exchange),^(1) which is a compilation of preprocessed resting-state functional magnetic resonance imaging data (rs-fMRI) obtained from seventeen international institutions." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2095> .

<urn:repronim:abide:abstract/ohbm2026/2095/claim/3> a ex:AbstractClaim ;
    rdfs:label "The resulting dataset included 346 ASD subjects and 369 typical controls." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The resulting dataset included 346 ASD subjects and 369 typical controls." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2095> .

<urn:repronim:abide:abstract/ohbm2026/2095/claim/4> a ex:AbstractClaim ;
    rdfs:label "Two deconvolution approaches were computed: Blind Deconvolution and Paradigm Free Mapping." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote """Subsequently, the following hemodynamic deconvolution approaches were computed:

(a) Blind Deconvolution (BD)^(2): assumes that the resting-state fMRI BOLD signal is an intrinsic, spontaneous event-related signal.""" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2095> .

<urn:repronim:abide:abstract/ohbm2026/2095/claim/5> a ex:AbstractClaim ;
    rdfs:label "Six connectivity metrics were calculated: Pearson’s correlation, Corr, H2, MIT, TE, and Coh." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "the following functional connectivity metrics were calculated: first, the commonly used Pearson’s correlation (PC); then, the unconventional metrics, namely: Pearson’s correlation with time delay (Corr), non-linear correlation coefficient (H2), mutual information in time domain (MIT), transfer entropy (TE), and coherence (Coh), using the MULAN toolbox.^(4)" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2095> .

<urn:repronim:abide:abstract/ohbm2026/2095/claim/6> a ex:AbstractClaim ;
    rdfs:label "Nine machine learning classifiers were adopted for distinguishing ASD subjects from typical controls." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Finally, nine machine learning classifiers were adopted for the task of distinguishing ASD subjects from typical controls, using the MALINI toolbox^(5): K-Nearest Neighbors (KNN); Linear Discriminant Analysis (LDA); Quadratic Discriminant Analysis (QDA); Naïve Bayes; Random Forest; Sparse Logistic Regression (SLR); Ridge Logistic Regression (RLR); Linear Support Vector Machines (LinearSVM); and Multilayer Perceptron Neural Network (MLP-NN)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2095> .

<urn:repronim:abide:abstract/ohbm2026/2095/claim/7> a ex:AbstractClaim ;
    rdfs:label "The study obtained 228 combinations for evaluation." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "228 combinations were obtained for the evaluation of the automated diagnosis of ASD using the selected machine learning classifiers." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2095> .

<urn:repronim:abide:abstract/ohbm2026/2095/claim/8> a ex:AbstractClaim ;
    rdfs:label "RLR, LinearSVM, and SLR showed significantly superior accuracy, while KNN, Naïve Bayes, and QDA were significantly inferior." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "the classifiers Ridge Logistic Regression (RLR), Linear Support Vector Machines (LinearSVM), and Sparse Logistic Regression (SLR) demonstrated significantly superior performance, with values above 70%, while K-Nearest Neighbors (KNN), NaïveBayes, and Quadratic Discriminant Analysis (QDA) exhibited significantly inferior performance, with values around 63% (Friedman nonparametric analysis of variance test p<0.001; Wilcoxon signed rank post-hoc test p<0.05)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2095> .

<urn:repronim:abide:abstract/ohbm2026/2095/claim/9> a ex:AbstractClaim ;
    rdfs:label "The non-deconvolved group exhibited significantly superior accuracy than Blind Deconvolution groups." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "the non-deconvolved group exhibited significantly superior performance in terms of accuracy when compared to Blind Deconvolution (BD) groups (Friedman nonparametric analysis of variance test p=0.0118; Wilcoxon signed rank post-hoc test p<0.05)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2095> .

<urn:repronim:abide:abstract/ohbm2026/2234/claim/0> a ex:AbstractClaim ;
    rdfs:label "Multivariate predictive models are crucial for enhancing the understanding of complex biological systems and developing innovative, replicable tools for translational medical research." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Multivariate predictive models are crucial for enhancing the understanding of complex biological systems and developing innovative, replicable tools for translational medical research." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2234> .

<urn:repronim:abide:abstract/ohbm2026/2234/claim/1> a ex:AbstractClaim ;
    rdfs:label "External validation involves testing the finalized model on independent data." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "external validation (EV), which involves testing the finalized model on independent data." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2234> .

<urn:repronim:abide:abstract/ohbm2026/2234/claim/2> a ex:AbstractClaim ;
    rdfs:label "AdaptiveSplit is implemented as a Python package." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "AdaptiveSplit^(1) is implemented as a Python package and utilizes a flexible, dynamically calculated stopping rule, which allows to determine the ideal discovery/external validation split of the data during prospective data acquisition." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2234> .

<urn:repronim:abide:abstract/ohbm2026/2234/claim/3> a ex:AbstractClaim ;
    rdfs:label "The stopping rule uses a Performance-rule and a Power-rule." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "The current decision is governed by two integrated criteria: a Performance-rule, detecting well-powered situations, where adding more training data comes with negligible benefits, and a Power-rule, which ensures that the resulting external validation sample will have sufficient statistical power to conclusively reject the null hypothesis of zero predictive performance." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2234> .

<urn:repronim:abide:abstract/ohbm2026/2264/claim/0> a ex:AbstractClaim ;
    rdfs:label "The study aimed to develop a brain age model using non-contrast T1WI from seven open-access datasets and to fine-tune it with CE-T1WI from a local hospital dataset." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Therefore, we aim to develop a brain age model by using non-contrast T1WI of healthy volunteers collected from seven open-access datasets (n = 4171) and implement two fine tuning approaches (tuning all layers or fully-connected layers only) with CE-T1WI of healthy subjects (n = 747) in our local dataset for comparison." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2264> .

<urn:repronim:abide:abstract/ohbm2026/2264/claim/1> a ex:AbstractClaim ;
    rdfs:label "The pre-trained model was built from 4,171 healthy subjects aged 5–100 years." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "To develop the pre-trained model for brain age prediction, 3D T1WI of 4,171 healthy subjects (age: 5-100 years) has been collected from Information eXtraction from Image (IXI, n = 561), Open Access Series of Imaging Studies-1 (OASIS-1, n = 316), Functional Connectomes Project (FCP, n = 1080), Autism Brain Imaging Data Exchange (n = 547 for ABIDE-I and n = 571 for ABIDE-II), the enhanced Nathan Kline Institute-Rockland Sample (NKI-RS, n = 411), and Lifespan Human Connectome Project Aging (HCP-A, n = 685)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2264> .

<urn:repronim:abide:abstract/ohbm2026/2264/claim/10> a ex:AbstractClaim ;
    rdfs:label "The fine-tuned model was used to estimate PAD in all patient groups, and significance was tested against the healthy test set using two-sample t tests." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "After that, the fine-tuned model was used to estimate the PAD of all patient groups. With the testing set of healthy subjects in our local dataset served as control, significant difference was examined (p < 0.05) using two-sample t test." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2264> .

<urn:repronim:abide:abstract/ohbm2026/2264/claim/11> a ex:AbstractClaim ;
    rdfs:label "The model's validation and testing MAE on the open-access datasets were 3.413 and 3.524 years, improving to 3.216 and 3.463 years after bias correction." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "With the non-contrast T1WI collected from worldwide open-access datasets, the validation and testing MAE of our model reaches 3.413 and 3.524 years, respectively, which was improved to 3.216 and 3.463 after bias correction." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2264> .

<urn:repronim:abide:abstract/ohbm2026/2264/claim/12> a ex:AbstractClaim ;
    rdfs:label "The tuning-all-layers model was more accurate than the tuning-FC-layers model, with bias-corrected test MAE 3.091 versus 3.549 and R² 0.852 versus 0.809." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Our results also showed that the tuning-all-layers model is more accurate than the tuning-FC-layers model (bias-corrected test MAE = 3.091 < 3.549; R^(2) = 0.852 > 0.809), both exhibiting an MAE comparable with the original performance of the pre-trained model (test MAE = 3.463)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2264> .

<urn:repronim:abide:abstract/ohbm2026/2264/claim/13> a ex:AbstractClaim ;
    rdfs:label "Using the tuning-all-layers model, diabetes mellitus and arrhythmia showed significantly higher PAD than the whole healthy control group." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Compared with the control (PAD = 0.673, n = 149) composed of the whole testing set of our local data, the PAD of diabetes mellitus (3.738) and arrhythmia (2.415) was significantly higher (p < 0.05)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2264> .

<urn:repronim:abide:abstract/ohbm2026/2264/claim/14> a ex:AbstractClaim ;
    rdfs:label "After age-matching, significantly higher PAD remained only in patients with diabetes mellitus, with Cohen’s d of 0.883 and p < 0.001." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "After that, significantly higher PAD only exists in patients with diabetes mellitus (p < 0.001, see Fig.2b for details) with an effect size of 0.883 (Cohen’s d)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2264> .

<urn:repronim:abide:abstract/ohbm2026/2264/claim/15> a ex:AbstractClaim ;
    rdfs:label "Diabetes-only patients (n = 49) had a mean PAD of 4.230, and the significant difference persisted after excluding comorbid cases." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "we also excluded the diabetes patients with other disease(s), and the mean PAD of diabetes-only patients (n = 49) was 4.230, keeping the significant difference persistent (p < 0.001)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2264> .

<urn:repronim:abide:abstract/ohbm2026/2264/claim/16> a ex:AbstractClaim ;
    rdfs:label "The conclusion states that fine-tuning reduced test MAE from 7.362 to 3.549 for FC-layer tuning and to 3.091 for all-layer tuning." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "our fine-tuned models reduced the test MAE substantially from 7.362 to 3.549 (tuning-FC-layers) and 3.091 (tuning-all-layers), exhibiting successful adaptation to the unseen dataset, in which only contrast-enhanced T1WI was collected from local inhabitants." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2264> .

<urn:repronim:abide:abstract/ohbm2026/2264/claim/17> a ex:AbstractClaim ;
    rdfs:label "Higher PAD was associated only with diabetes mellitus in the age-matched control comparison, in agreement with previous findings." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361>,
        <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "In comparison with the age-matched control group, higher PAD was only associated with diabetes mellitus, which is in agreement with previous findings.^(2)" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2264> .

<urn:repronim:abide:abstract/ohbm2026/2264/claim/2> a ex:AbstractClaim ;
    rdfs:label "The local health-check dataset included 983 subjects aged 19–88 years, comprising 747 healthy subjects and 236 patients." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "After image quality check, 983 subjects (age: 19-88 years), including 747 healthy subjects and 236 patients with diabetes mellitus, arrhythmia, myocardial infarction, valvular heart disease, coronary artery disease, insomnia, anxiety disorder, and depression disorder, were recruited." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2264> .

<urn:repronim:abide:abstract/ohbm2026/2264/claim/3> a ex:AbstractClaim ;
    rdfs:label "Minimal preprocessing included reorientation, brain extraction, rigid registration to the MNI152 T1 template, intensity normalization, and resampling with CAT12.9 to 1-mm isotropic resolution." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The procedure included reorientation, brain extraction to remove non-brain tissues, rigid registration to the MNI152 T1 template, normalization of intensity, and data resampling by applying Computational Anatomy Toolbox (CAT12.9)^(3) to generate an unbiased and intensity-normalized T1WI in 1-mm isotropic resolution." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2264> .

<urn:repronim:abide:abstract/ohbm2026/2264/claim/4> a ex:AbstractClaim ;
    rdfs:label "The model was a 3D convolutional neural network with residual learning, composed of six residual blocks and one fully connected block." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In this study, a 3D convolutional neural network with residual learning framework^(4) was modified for brain age prediction. As shown in Fig.1, our model was composed of 6 residual blocks and one fully-connected (FC) block, in which sex and main magnetic strength (B0) were encoded as binary inputs and concatenated to the second FC layer." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2264> .

<urn:repronim:abide:abstract/ohbm2026/2264/claim/5> a ex:AbstractClaim ;
    rdfs:label "The open-access datasets were split into training, validation, and testing sets of 3,471, 350, and 350 subjects, respectively." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Data gathered from open-access datasets were randomly split into training (n = 3471), validation (n = 350), and testing sets (n = 350), with age of the latter two sets being uniformly distributed." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2264> .

<urn:repronim:abide:abstract/ohbm2026/2264/claim/6> a ex:AbstractClaim ;
    rdfs:label "The pre-trained model was trained from scratch with Adam optimizer, learning rate 0.001, dropout 0.2, and batch size 4, and the checkpoint with minimal validation MAE over 1000 epochs was selected." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We trained our age prediction model from scratch (Adam optimizer, learning rate = 0.001, dropout = 0.2, and batch size = 4), and model weights with minimal validation loss of mean absolute error (MAE) in 1000 epochs was selected as the pre-trained model." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2264> .

<urn:repronim:abide:abstract/ohbm2026/2264/claim/7> a ex:AbstractClaim ;
    rdfs:label "The local healthy-subject dataset was split into training, validation, and testing sets in a 60/20/20 ratio with identical age distribution." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "data of healthy subjects from the local health check dataset were divided into training (60%, n = 449), validation (20%, n = 149), and testing sets (20%, n = 149) with identical age distribution." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2264> .

<urn:repronim:abide:abstract/ohbm2026/2264/claim/8> a ex:AbstractClaim ;
    rdfs:label "Fine tuning was performed with either all layers or only the fully connected layers, using the same hyperparameters except for limiting training to 100 epochs." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "To achieve adaptation to the local CE-T1WI dataset, two strategies of fine tuning, either model weights of all layers or only those of FC layers being tuned, were implemented independently with the same hyperparameters except training epochs limited at 100." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2264> .

<urn:repronim:abide:abstract/ohbm2026/2264/claim/9> a ex:AbstractClaim ;
    rdfs:label "Validation and test MAE and R² were calculated, and a bias-adjustment scheme using linear regression on validation data was used to remove age-prediction bias." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "MAE and coefficient of determination (R^(2)) of validation and testing sets were calculated. In addition, a bias-adjustment scheme using linear regression on validation data was performed to remove bias in age prediction." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2264> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/0> a ex:AbstractClaim ;
    rdfs:label "Deep learning models can characterize aging-related structural changes from brain MRI to estimate normative aging trajectories for age prediction, thereby providing a quantitative framework for identifying deviations associated with disease." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Deep learning models can characterize aging-related structural changes from brain MRI to estimate normative aging trajectories for age prediction, thereby providing a quantitative framework for identifying deviations associated with disease." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/1> a ex:AbstractClaim ;
    rdfs:label "The hippocampus and amygdala have been reported to exhibit early and pronounced atrophy in Alzheimer’s disease." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "the hippocampus and amygdala have been reported to exhibit early and pronounced atrophy in Alzheimer’s disease." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/10> a ex:AbstractClaim ;
    rdfs:label "Non-brain tissues were removed using TigerBX, followed by automatic tissue segmentation into 43 subregions according to the FreeSurfer aseg atlas." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Non-brain tissues were removed using a deep learning-based tool (TigerBX, [https://github.com/htylab/tigerbx](https://github.com/htylab/tigerbx)), followed by automatic tissue segmentation into 43 subregions according to the FreeSurfer aseg atlas." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/11> a ex:AbstractClaim ;
    rdfs:label "Subsequent preprocessing with CAT12 included bias correction, global intensity normalization, rigid registration to the MNI T1 template, and resampling to 1-mm isotropic resolution." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Subsequent preprocessing was performed using CAT12 ([https://neuro-jena.github.io/cat/](https://neuro-jena.github.io/cat/)), including bias correction, global intensity normalization, rigid registration to the MNI T1 template, and resampling to 1-mm isotropic resolution to generate the non-deformed T1WI, together with the gray matter and white matter probability maps (GMP and WMP)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/12> a ex:AbstractClaim ;
    rdfs:label "The aseg segmentation map was aligned with the corresponding T1WI using the same rigid transformation, enabling selective preservation of image intensity within regions of interest through masking of the preprocessed T1WI." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The aseg segmentation map was aligned with the corresponding T1WI using the same rigid transformation, enabling selective preservation of image intensity within regions of interest through masking of the preprocessed T1WI." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/13> a ex:AbstractClaim ;
    rdfs:label "A deep gray matter image was generated by masking bilateral thalamus, caudate, putamen, pallidum, hippocampus, amygdala, accumbens, and ventral diencephalon." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "For example, a deep gray matter image was generated by masking bilateral thalamus, caudate, putamen, pallidum, hippocampus, amygdala, accumbens, and ventral diencephalon (Fig.1a)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/14> a ex:AbstractClaim ;
    rdfs:label "Five other masked images were constructed corresponding to cerebral white matter, cerebral cortex, hippocampus, amygdala, and a combined hippocampus-amygdala region." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In addition to deep gray matter, five other masked images were constructed, corresponding to cerebral white matter, cerebral cortex, hippocampus, amygdala, and a combined hippocampus-amygdala region." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/15> a ex:AbstractClaim ;
    rdfs:label "The region-specific images were used independently to train the corresponding regional brain age models." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "These region-specific images were used independently to train the corresponding regional brain age models." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/16> a ex:AbstractClaim ;
    rdfs:label "The SFCN architecture was implemented using soft classification and regression." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In this study, the SFCN architecture was implemented using two prediction strategies: soft classification and regression (Fig.1b)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/17> a ex:AbstractClaim ;
    rdfs:label "For soft classification, the network output consisted of 95 nodes following a softmax layer, with each node representing the probability of an age between 5 and 100 years at one-year intervals." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "For soft classification, the network output consisted of 95 nodes following a softmax layer, with each node representing the probability of an age between 5 and 100 years at one-year intervals." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/18> a ex:AbstractClaim ;
    rdfs:label "The regression model employed a single output node with linear activation to directly estimate chronological age." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In contrast, the regression model employed a single output node with linear activation to directly estimate chronological age." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/19> a ex:AbstractClaim ;
    rdfs:label "All data were divided into training (n = 3,471), validation (n = 350), and test sets (n = 350)." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "All data were divided into training (n = 3,471), validation (n = 350), and test sets (n = 350)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/2> a ex:AbstractClaim ;
    rdfs:label "Region-specific biomarkers are likely to be more sensitive to disease-related alterations than a global brain age measure." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "These observations suggest that region-specific biomarkers are likely to be more sensitive to disease-related alterations than a global brain age measure." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/20> a ex:AbstractClaim ;
    rdfs:label "The validation and test sets were constructed to have approximately uniform age distributions." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The validation and test sets were constructed to have approximately uniform age distributions." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/21> a ex:AbstractClaim ;
    rdfs:label "During each training epoch, samples were drawn with equal probability across age groups to reduce potential age-related bias." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "During each training epoch, samples were drawn with equal probability across age groups to reduce potential age-related bias." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/22> a ex:AbstractClaim ;
    rdfs:label "Age groups with larger sample sizes were fully utilized across successive training epochs." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Age groups with larger sample sizes were nevertheless fully utilized across successive training epochs." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/23> a ex:AbstractClaim ;
    rdfs:label "Models were trained iteratively for up to 250 epochs, and the network weights with the minimum validation loss were selected for testing." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Models were trained iteratively for up to 250 epochs, and the network weights with the minimum validation loss were selected for testing." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/24> a ex:AbstractClaim ;
    rdfs:label "Twelve regional brain age models and six global brain age models were trained independently and compared." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In total, twelve regional brain age models (6 input types × 2 prediction strategies) were trained independently and compared with the other six global brain age models (T1, GMP, and WMP × 2 prediction strategies)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/25> a ex:AbstractClaim ;
    rdfs:label "For each model, mean absolute error and coefficient of determination were calculated for validation and test sets." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "For each model, mean absolute error (MAE) and coefficient of determination (R^(2)) were calculated for validation and test sets." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/26> a ex:AbstractClaim ;
    rdfs:label "A linear regression-based bias adjustment was derived from the validation data and applied to subsequent analyses to correct systematic bias in age prediction." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "To correct systematic bias in age prediction, a linear regression-based bias adjustment was derived from the validation data and applied to subsequent analyses." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/27> a ex:AbstractClaim ;
    rdfs:label "All models were further evaluated in an independent clinical sample from the OASIS-3 cohort including participants with dementia, MCI, and cognitively normal controls matched for age distribution." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "All models were further evaluated in an independent clinical sample from the OASIS-3 cohort, including participants with dementia (n = 150), MCI (n = 75), and cognitively normal controls (CN; n = 150), matched for age distribution (range: 59.3–89.4 years; mean: 75.4 years)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/28> a ex:AbstractClaim ;
    rdfs:label "The predicted age difference (PAD) was defined as the difference between predicted brain age and chronological age." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The difference between predicted brain age and chronological age, defined as the predicted age difference (PAD), was obtained to quantify deviations from normative aging associated with neurodegenerative processes." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/29> a ex:AbstractClaim ;
    rdfs:label "Global brain age models based on whole-brain inputs achieved lower MAE than regional models." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Overall, global brain age models based on whole-brain inputs (T1, GMP, and WMP) achieved lower MAE than regional models, consistent with the greater availability of structural information for age prediction at the whole-brain level." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/3> a ex:AbstractClaim ;
    rdfs:label "By using convolutional neural network, local brain age estimation can be achieved by restricting predictions to structural features extracted from predefined image patches." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361>,
        <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "By using convolutional neural network, local brain age estimation can be achieved by restricting predictions to structural features extracted from predefined image patches." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/30> a ex:AbstractClaim ;
    rdfs:label "Models trained exclusively on the hippocampus or amygdala exhibited higher prediction errors, with MAE exceeding 6.2 years." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In contrast, models trained exclusively on the hippocampus or amygdala exhibited higher prediction errors, with MAE exceeding 6.2 years." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/31> a ex:AbstractClaim ;
    rdfs:label "The deep gray matter model demonstrated prediction accuracy comparable to global models despite being derived from a substantially smaller masked region." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Notably, the deep gray matter model represented an exception among regional approaches, demonstrating prediction accuracy comparable to global models despite being derived from a substantially smaller masked region." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/32> a ex:AbstractClaim ;
    rdfs:label "Across all input types, the SFCN models with soft classification strategy consistently yielded lower MAE and higher R^(2) values than their regression-based counterparts except for the combined hippocampus-amygdala input." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Across all input types, the SFCN models with soft classification strategy consistently yielded lower MAE and higher R^(2) values than their regression-based counterparts except for the combined hippocampus-amygdala input." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/33> a ex:AbstractClaim ;
    rdfs:label "PAD was significantly higher in the dementia group than in CN." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Across all models, PAD was significantly higher in the dementia group than in CN (all _p_ < 0.05)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/34> a ex:AbstractClaim ;
    rdfs:label "PAD in the MCI group was significantly elevated relative to CN only in one global model and in five regional models, including cerebral cortex, deep gray matter, hippocampus, amygdala, and the combined hippocampus-amygdala region." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In contrast, PAD in the MCI group was significantly elevated relative to CN only in one global model (GMP) and in five regional models, including cerebral cortex, deep gray matter, hippocampus, amygdala, and the combined hippocampus-amygdala region." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/35> a ex:AbstractClaim ;
    rdfs:label "The combined hippocampus-amygdala model showed lower age prediction accuracy compared with global brain age models but exhibited a pronounced separation of PAD across clinical groups." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Although the combined hippocampus-amygdala model showed lower age prediction accuracy compared with global brain age models (test MAE = 6.49 years vs. 3.57-3.73 years), it exhibited a pronounced separation of PAD across clinical groups." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/36> a ex:AbstractClaim ;
    rdfs:label "The mean PAD values derived from the combined hippocampus-amygdala model were −1.32 years for CN, 3.61 years for MCI, and 6.50 years for dementia, resulting in significant differences between all pairwise group comparisons." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The mean PAD values derived from this model were −1.32 years for CN, 3.61 years for MCI, and 6.50 years for dementia, resulting in significant differences between all pairwise group comparisons." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/37> a ex:AbstractClaim ;
    rdfs:label "The study implemented a regional brain age model based on the lightweight SFCN to compare with conventional global age models." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "In this study, the regional brain age model based on the lightweight SFCN has been implemented to compare with the conventional global age model." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/38> a ex:AbstractClaim ;
    rdfs:label "Global models based on whole-brain inputs such as T1WI, GMP, and WMP achieved higher age prediction accuracy." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "While global models based on whole-brain inputs, such as T1WI, GMP, and WMP, achieved the higher age prediction accuracy, the deep gray matter model exhibited accuracy comparable to global models despite substantially reduced spatial coverage." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/39> a ex:AbstractClaim ;
    rdfs:label "The combined hippocampus-amygdala model demonstrated enhanced ability to differentiate CN, MCI, and dementia using PAD." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "For example, the combined hippocampus-amygdala model demonstrated enhanced ability to differentiate CN, MCI, and dementia using PAD." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/4> a ex:AbstractClaim ;
    rdfs:label "The Simple Fully Convolutional Network (SFCN) is a lightweight deep neural network that has demonstrated high accuracy in brain age prediction." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "The Simple Fully Convolutional Network (SFCN) is a lightweight deep neural network that has demonstrated high accuracy in brain age prediction." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/40> a ex:AbstractClaim ;
    rdfs:label "Regional models may provide more sensitive biomarkers for detecting early and localized neurodegenerative changes than conventional global brain age measures." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "These findings highlight a dissociation between predictive accuracy and clinical relevance in brain age modeling and suggest that region-specific brain age estimates may provide more sensitive biomarkers for detecting early and localized neurodegenerative changes than conventional global brain age measures." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/5> a ex:AbstractClaim ;
    rdfs:label "By eliminating fully connected layers, SFCN substantially reduces model parameters, enabling efficient training, lowering the risk of overfitting, and allowing flexibility in input size." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "By eliminating fully connected layers, SFCN substantially reduces model parameters, enabling efficient training, lowering the risk of overfitting, and allowing flexibility in input size." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/6> a ex:AbstractClaim ;
    rdfs:label "The study adopted the SFCN architecture to train regional brain age models targeting the hippocampus and/or amygdala and to contrast their performance with conventional global brain age models." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "As a result, we adopt the SFCN architecture to train our regional brain age models, including models targeting the hippocampus and/or amygdala, and contrast their performance with the conventional global brain age models." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/7> a ex:AbstractClaim ;
    rdfs:label "The study compared soft classification and regression prediction strategies." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "In addition, we compare two types of prediction strategies, soft classification and regression." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/8> a ex:AbstractClaim ;
    rdfs:label "T1-weighted MRI from 4,171 healthy subjects aged 5-100 years were aggregated from 7 databases." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "To train the age prediction model, T1-weighted MRI from 4,171 healthy subjects (age: 5-100 years) were aggregated from 7 databases: IXI (n = 561), OASIS-1 (n = 316), FCP (n = 1080), ABIDE-I (n = 547), ABIDE-II (n = 571), NKI-RS (n = 411), and HCP-A (n = 685)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2266/claim/9> a ex:AbstractClaim ;
    rdfs:label "All images underwent a unified preprocessing procedure to minimize inter-site variability." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "To minimize inter-site variability arising from differences in scanners, acquisition protocols, and preprocessing pipelines, all images underwent a unified preprocessing procedure (Fig.1a)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2266> .

<urn:repronim:abide:abstract/ohbm2026/2270/claim/0> a ex:AbstractClaim ;
    rdfs:label "NeuroFM is a foundation model trained entirely on synthetic (AI-generated) structural MRI data." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Here, we introduce NeuroFM, a foundation model trained entirely on synthetic (AI-generated) structural MRI data, designed to overcome these limitations and support a wide range of neuroimaging applications." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2270> .

<urn:repronim:abide:abstract/ohbm2026/2270/claim/1> a ex:AbstractClaim ;
    rdfs:label "The model learns compact, anatomically meaningful latent representations by jointly predicting multiple morphometric targets and requires only minimal preprocessing." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "The model learns compact, anatomically meaningful latent representations by jointly predicting multiple morphometric targets and requires only minimal preprocessing (Fig. 1a)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2270> .

<urn:repronim:abide:abstract/ohbm2026/2270/claim/10> a ex:AbstractClaim ;
    rdfs:label "Pretraining used all 100k synthetic samples with strong data augmentation, an exponentially decaying learning rate and early stopping." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Pretraining used all 100k synthetic samples with strong data augmentation, an exponentially decaying learning rate and early stopping." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2270> .

<urn:repronim:abide:abstract/ohbm2026/2270/claim/11> a ex:AbstractClaim ;
    rdfs:label "Logistic/linear regression models were trained on these features for each external task without updating the foundation model." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Logistic/linear regression models were trained on these features for each external task without updating the foundation model." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2270> .

<urn:repronim:abide:abstract/ohbm2026/2270/claim/12> a ex:AbstractClaim ;
    rdfs:label "5-fold cross-validation and permutation testing (500 iterations) were used to validate all results." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "5-fold cross-validation and permutation testing (500 iterations) were used to validate all results." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2270> .

<urn:repronim:abide:abstract/ohbm2026/2270/claim/13> a ex:AbstractClaim ;
    rdfs:label "In the clinical domain, NeuroFM was applied to predict fronto-temporal dementia presence in the NIFD dataset, Alzheimer’s disease presence in the ADNI dataset, and glioma tumour size prediction in the BRATS 2023 dataset." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In the clinical domain, we applied NeuroFM to predict fronto-temporal dementia presence in the NIFD dataset, Alzheimer’s disease presence in the ADNI dataset, and glioma tumour size prediction in the BRATS 2023 dataset." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2270> .

<urn:repronim:abide:abstract/ohbm2026/2270/claim/14> a ex:AbstractClaim ;
    rdfs:label "Relevance maps/highlights were created by finetuning NeuroFM on the target task and applying layerwise relevance propagation." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Relevance maps/highlights were created by finetuning NeuroFM on the target task (e.g. AD presence) and then applying layerwise relevance propagation (LRP)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2270> .

<urn:repronim:abide:abstract/ohbm2026/2270/claim/15> a ex:AbstractClaim ;
    rdfs:label "LRP was performed on NIFD, ADNI, and BRATS 2023." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "LRP was performed on NIFD, ADNI, and BRATS 2023." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2270> .

<urn:repronim:abide:abstract/ohbm2026/2270/claim/16> a ex:AbstractClaim ;
    rdfs:label "NeuroFM was used to predict MMSE and CDR in the cognitive domain." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "For the cognitive domain, we looked at the ability of NeuroFM to predict two common cognitive metrics: MMSE (mini-mental state exam), and CDR (clinical dementia rating) on the NIFD and ADNI dataset." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2270> .

<urn:repronim:abide:abstract/ohbm2026/2270/claim/2> a ex:AbstractClaim ;
    rdfs:label "NeuroFM enables efficient inference across five neuroscience domains: clinical, cognitive, developmental, socio-behavioural, and quality metrics." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Leveraging numerous small test datasets, we demonstrate that NeuroFM enables efficient inference across five neuroscience domains: clinical, cognitive, developmental, socio-behavioural, and quality metrics (Fig. 1b)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2270> .

<urn:repronim:abide:abstract/ohbm2026/2270/claim/3> a ex:AbstractClaim ;
    rdfs:label "The study used 17 publicly available datasets, totaling 182,280 unique MRI volumes." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We used 17 publicly available datasets: UK Biobank (n=44,790), ADNI (n=2,011), NIFD (n=259), IXI (n=569), OASIS3 (n=2,633), LDM100k (n=100,000), ADHD-200 (n=880), ABIDE (n=904), 1000-FCP (n=7,496), AOMIC (n=1,911), BRATS 2023 (n=1,244), EDSD (n=290), HCP (n=890), IADNI (n=98), IBSR (n=18), MALC2012 (n=34), and MindBoggle101 (n=92), for a total of 182,280 unique MRI volumes." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2270> .

<urn:repronim:abide:abstract/ohbm2026/2270/claim/4> a ex:AbstractClaim ;
    rdfs:label "Only LDM100k was used for supervised pretraining." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Only LDM100k was used for supervised pretraining." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2270> .

<urn:repronim:abide:abstract/ohbm2026/2270/claim/5> a ex:AbstractClaim ;
    rdfs:label "All other datasets were used for evaluation and task adaptation." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "All other datasets were used for evaluation and task adaptation." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2270> .

<urn:repronim:abide:abstract/ohbm2026/2270/claim/6> a ex:AbstractClaim ;
    rdfs:label "All volumes were minimally preprocessed by resampling to 1 mm isotropic in a 256³ grid, followed by skull stripping with SynthStrip." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "All volumes were minimally preprocessed: resampling with FreeSurfer to 1 mm isotropic in a 256³ grid, followed by skull stripping with SynthStrip.3" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2270> .

<urn:repronim:abide:abstract/ohbm2026/2270/claim/7> a ex:AbstractClaim ;
    rdfs:label "No intersubject template registration was applied." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "No intersubject template registration was applied." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2270> .

<urn:repronim:abide:abstract/ohbm2026/2270/claim/8> a ex:AbstractClaim ;
    rdfs:label "NeuroFM is a 3D CNN with parameter-efficient bottleneck blocks." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "NeuroFM is a 3D CNN with parameter-efficient bottleneck blocks." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2270> .

<urn:repronim:abide:abstract/ohbm2026/2270/claim/9> a ex:AbstractClaim ;
    rdfs:label "The base model outputs four targets: predicted brain age, sex, intracranial volume and ventricular volume." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The base model outputs four targets: predicted brain age, sex, intracranial volume and ventricular volume." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2270> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/0> a ex:AbstractClaim ;
    rdfs:label "The study applies contrastive learning to learn representations that capture neuroanatomical variability associated with psychiatric phenotype in UKB and the ABCD Study." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "This study applies contrastive learning to learn representations that capture neuroanatomical variability associated with psychiatric phenotype in two large-scale datasets, namely UKB ([https://www.ukbiobank.ac.uk/](https://www.ukbiobank.ac.uk/)) and the ABCD Study ([https://abcdstudy.org/](https://abcdstudy.org/))." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/1> a ex:AbstractClaim ;
    rdfs:label "The study defines psychiatric phenotypes along continuous factors of psychopathology derived with Exploratory Factor Analysis." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Aligned with the conceptual shift in psychiatry from categorical to dimensional models (e.g. RDoC¹), we define psychiatric phenotypes along continuous factors of psychopathology derived with Exploratory Factor Analysis." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/10> a ex:AbstractClaim ;
    rdfs:label "The five UKB factors were labeled acute stress, chronic stress, mood disorder, impulsivity, and cognition." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "We labeled the five resulting factors based on the categories corresponding to the items with the strongest absolute loadings on each factor: “Acute stress”, “Chronic stress”, “Mood disorder”, “Impulsivity”, and “Cognition” (Fig. 1B)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/11> a ex:AbstractClaim ;
    rdfs:label "For ABCD, latent psychopathology factors were derived using exploratory factor analysis." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "For ABCD, following prior work,³ we derived latent factors of psychopathology using exploratory factor analysis." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/12> a ex:AbstractClaim ;
    rdfs:label "The ABCD factors were derived from Child Behavior Checklist data." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "We used the Child Behavior Checklist (CBCL) data, resulting in three dimensions of youth psychopathology: externalizing, internalizing and neurodevelopmental symptoms (Fig. 1B)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/13> a ex:AbstractClaim ;
    rdfs:label "The ABCD data yielded three dimensions: externalizing, internalizing, and neurodevelopmental symptoms." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "We used the Child Behavior Checklist (CBCL) data, resulting in three dimensions of youth psychopathology: externalizing, internalizing and neurodevelopmental symptoms (Fig. 1B)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/14> a ex:AbstractClaim ;
    rdfs:label "A baseline anatomy-behavior correlation was established by predicting these dimensions using Ridge regression on VBM features defined on the neuromorphometrics atlas." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "To ensure there is a baseline anatomy-behavior correlation, we first predicted these dimensions using Ridge regression on VBM features defined on the neuromorphometrics atlas." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/15> a ex:AbstractClaim ;
    rdfs:label "Psy-Aware is a weakly-supervised contrastive approach that incorporates behavioral factors into the loss function." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "We introduce the so-called psy-Aware framework (Fig. 1C), a weakly-supervised contrastive approach that incorporates behavioral factors into the loss function, extending y-Aware to a multidimensional loss, as in Dufumier et al..⁴" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/16> a ex:AbstractClaim ;
    rdfs:label "Psy-Aware extends y-Aware to a multidimensional loss." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "We introduce the so-called psy-Aware framework (Fig. 1C), a weakly-supervised contrastive approach that incorporates behavioral factors into the loss function, extending y-Aware to a multidimensional loss, as in Dufumier et al..⁴" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/17> a ex:AbstractClaim ;
    rdfs:label "The psy-Aware loss uses a Gaussian kernel with bandwidth matrix Σ to modulate the loss based on similarity of auxiliary labels." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "For a pair of embeddings _zi_,_ zj_ the psy-Aware loss uses a Gaussian kernel _w_Σ__with bandwidth matrix Σ to modulate the loss based on the similarity of auxiliary labels _yi_,_ yj_, pulling embeddings closer when psychopathology scores are more similar." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/18> a ex:AbstractClaim ;
    rdfs:label "The kernel bandwidth Σ was estimated using Silverman's rule of thumb." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Drawing a parallel with kernel density estimation,⁴ we estimated the kernel’s bandwidth Σ using Silverman’s rule of thumb." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/19> a ex:AbstractClaim ;
    rdfs:label "The study compared psy-Aware against a baseline using the factor best predicted from VBM." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In both ABCD and UKB, we compared psy-Aware against a baseline incorporating as y-Aware auxiliary variable the factor best predicted from VBM." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/2> a ex:AbstractClaim ;
    rdfs:label "The approach integrates latent factors into the weakly supervised contrastive learning y-Aware framework." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Our approach integrates these latent factors into the weakly supervised contrastive learning _y_-Aware framework,² hypothesizing that it enhances the clinical relevance of the learned representations." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/20> a ex:AbstractClaim ;
    rdfs:label "In UKB, age-Aware was also included as a strong weakly-supervised baseline." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "In UKB, we also included age-Aware as a strong weakly-supervised baseline.²" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/21> a ex:AbstractClaim ;
    rdfs:label "SimCLR was added as a standard unsupervised contrastive baseline." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "We added SimCLR⁵ as a standard unsupervised contrastive baseline to the comparison." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/22> a ex:AbstractClaim ;
    rdfs:label "All models used a ResNet18 encoder backbone with embedding dimension 512 and random erasing, random cropping, and Gaussian noise augmentation." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "All models used a ResNet18 encoder backbone with an embedding dimension of 512 and random erasing, random cropping and Gaussian noise as data augmentation." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/23> a ex:AbstractClaim ;
    rdfs:label "The models were trained on ABCD for 13,300 steps (100 epochs) and on UKB for 18,200 steps (60 epochs)." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We trained on ABCD for 13,300 steps (100 epochs) and on UKB for 18,200 steps (60 epochs)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/24> a ex:AbstractClaim ;
    rdfs:label "Pretrained representations were evaluated by linear probing on three classification tasks: bipolar disorder vs healthy control, schizophrenia vs healthy control, and autism spectrum disorder vs healthy control." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "As in previous work,² pretrained representations were evaluated by linear probing for three classification tasks: bipolar disorder (BD) vs. healthy control (HC), schizophrenia (SCZ) vs. HC, and autism spectrum disorder (ASD) vs. HC (Fig. 1D)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/25> a ex:AbstractClaim ;
    rdfs:label "The three downstream tasks used datasets with 1,233, 1,352, and 2,117 distinct subjects." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Each of these tasks was carried out on datasets containing, respectively, n=1,233, 1,352, and 2,117 distinct subjects obtained from the ABIDE 1+2, BIOBD, BSNIP, SCHIZCONNECT-VIP, PRAGUE, CANDI and CNP datasets." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/26> a ex:AbstractClaim ;
    rdfs:label "Performance was assessed using Monte-Carlo cross-validation with 200 folds and the AUROC metric." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Performance was assessed using Monte-Carlo cross-validation (200 folds) with the AUROC metric." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/27> a ex:AbstractClaim ;
    rdfs:label "All psychopathological factors except internalizing could be predicted better than chance from VBM features." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "As a sanity check, all psychopathological factors, except internalizing, can be predicted better than chance level from VBM features." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/28> a ex:AbstractClaim ;
    rdfs:label "Neurodevelopmental symptoms and cognition were the best-predicted factors in ABCD and UKB, respectively." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Neurodevelopmental symptoms and cognition are the factors best predicted respectively in ABCD and in UKB (Fig 2A)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/29> a ex:AbstractClaim ;
    rdfs:label "Incorporating all psychopathological factors in pre-training improves downstream representation compared to using only the single best predicted factor." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Incorporating all psychopathological factors in pre-training improves the downstream representation compared to including only the single best predicted factor (Fig. 2C)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/3> a ex:AbstractClaim ;
    rdfs:label "The study used T1-weighted MRI scans from UKB and ABCD." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0006055> ;
    ex:sourceQuote "We used T1-weighted MRI scans from the UKB (n = 42,786 unique participants and scans) and ABCD datasets (n = 11,460 unique participants, n = 21,216 scans)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/30> a ex:AbstractClaim ;
    rdfs:label "Psy-Aware on ABCD or UKB does not outperform SimCLR in most cases except for ASD, where psy-Aware is superior when pretrained on UKB." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Surprisingly, psy-Aware on ABCD or UKB does not outperform unsupervised SimCLR model in most cases except for ASD, for which psy-Aware is superior when pretrained on UKB (Fig 2B)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/31> a ex:AbstractClaim ;
    rdfs:label "Psy-Aware pretrained on UKB is competitive with age-Aware pretrained on the same cohort, even outperforming it in ASD classification." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Psy-Aware pretrained on UKB is competitive with age-Aware pretrained on the same cohort, even outperforming it in ASD classification (Fig." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/32> a ex:AbstractClaim ;
    rdfs:label "The authors hypothesize that current psychiatric scales may lack sufficient variance in large datasets for an effective dimensional approach in psychiatry." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "We hypothesize that current psychiatric scales may lack sufficient variance in large datasets for an effective dimensional approach in psychiatry." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/33> a ex:AbstractClaim ;
    rdfs:label "The paper highlights the need for a new dataset tailored for psychiatry." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "It highlights the need for a new dataset tailored for psychiatry." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/34> a ex:AbstractClaim ;
    rdfs:label "Evaluating model performance on downstream tasks alone is not informative of the features captured by one or the other model." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Moreover, evaluating model performance on downstream tasks alone is not informative of the features captured by one or the other model." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/35> a ex:AbstractClaim ;
    rdfs:label "Further research is needed to improve the interpretability of the embeddings space’s structure." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Further research is needed to improve the interpretability of the embeddings space’s structure." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/4> a ex:AbstractClaim ;
    rdfs:label "The MRI scans were preprocessed using voxel-based morphometry to extract normalized gray matter volumes in MNI space." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "We preprocessed them using voxel-based morphometry (VBM) to extract normalized gray matter volumes in MNI space." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/5> a ex:AbstractClaim ;
    rdfs:label "The UKB behavioral metadata analysis selected 124 behavioral phenotypes salient for predicting mental disorders." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Out of the data available in UKB, we selected 124 behavioral phenotypes that were deemed salient for the prediction of mental disorders." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/6> a ex:AbstractClaim ;
    rdfs:label "The UKB phenotypes were classified into twelve categories." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "These phenotypes can be classified into twelve distinct categories: Anxiety, Cognition, Depression, Mania, Perinatal, Personality, Psychosis, Self-harm, Sleep, Social, Substance use, and Trauma." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/7> a ex:AbstractClaim ;
    rdfs:label "The responses were converted to a continuous numerical scale and missing values were imputed using the MICE method." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "We converted all the responses to a continuous numerical scale and imputed missing values using the MICE method." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/8> a ex:AbstractClaim ;
    rdfs:label "An exploratory factor analysis was performed on the UKB behavioral data." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "An Exploratory Factor Analysis (EFA) was performed on these data." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2271/claim/9> a ex:AbstractClaim ;
    rdfs:label "A five-factor solution provided the best fit and aligned well with the RDoC framework." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "A five-factor solution provided the best fit and aligned well with the RDoC framework.¹" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2271> .

<urn:repronim:abide:abstract/ohbm2026/2291/claim/0> a ex:AbstractClaim ;
    rdfs:label "ASD is a neurodevelopmental condition associated with widespread alterations in large-scale functional connectivity." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Autism Spectrum Disorder (ASD) is a neurodevelopmental condition associated with widespread alterations in large-scale functional connectivity (FC)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2291> .

<urn:repronim:abide:abstract/ohbm2026/2291/claim/1> a ex:AbstractClaim ;
    rdfs:label "The study analyzed resting-state fMRI data from the ABIDE I and II datasets, including 461 individuals with ASD and 446 Typically Developing Controls spanning ages 5 to 25 years." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We analyzed resting-state fMRI data from the ABIDE I and II datasets, including 461 individuals with ASD and 446 Typically Developing Controls (TDC), spanning an age range of 5 to 25 years.^1" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2291> .

<urn:repronim:abide:abstract/ohbm2026/2291/claim/10> a ex:AbstractClaim ;
    rdfs:label "The extrapolated state exhibited widespread reductions in functional coupling relative to baseline." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "As visually evident in the differential connectivity maps (Fig. 2B/D), the extrapolated state exhibits widespread reductions in functional coupling relative to the baseline , which is indicated by predominant negative difference values." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2291> .

<urn:repronim:abide:abstract/ohbm2026/2291/claim/11> a ex:AbstractClaim ;
    rdfs:label "The average connectivity strength decreased monotonically from 0.809 in the baseline state to 0.741 in the extrapolated state." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Quantitative assessment confirmed this trend, revealing a monotonic reduction in average connectivity strength from 0.809 (Baseline State) to 0.741 (Extrapolated State)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2291> .

<urn:repronim:abide:abstract/ohbm2026/2291/claim/12> a ex:AbstractClaim ;
    rdfs:label "The reduction represented a structured erosion of functional boundaries across major cortical networks rather than random noise." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Spatially, the network-annotated maps (Fig. 2C/E) revealed that this reduction represents a structured erosion of functional boundaries across major cortical networks (e.g., Default Mode, Attention), rather than random noise." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2291> .

<urn:repronim:abide:abstract/ohbm2026/2291/claim/13> a ex:AbstractClaim ;
    rdfs:label "The generated patterns recapitulate key under-connectivity features observed in empirical ASD data." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "These generated patterns recapitulate key under-connectivity features observed in empirical ASD data." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2291> .

<urn:repronim:abide:abstract/ohbm2026/2291/claim/14> a ex:AbstractClaim ;
    rdfs:label "ASD-associated dysconnectivity can be consistently positioned within a shared, low-dimensional space of brain network organization defined by constrained axes of reorganization." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361>,
        <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Rather than requiring a disease-specific network architecture, ASD-associated dysconnectivity can be consistently positioned within a shared, low-dimensional space of brain network organization defined by constrained axes of reorganization that have been classically associated with aging-related changes in the literature." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2291> .

<urn:repronim:abide:abstract/ohbm2026/2291/claim/2> a ex:AbstractClaim ;
    rdfs:label "To mitigate class-frequency bias, the authors applied a stratified balancing procedure combining Propensity Score Matching and adaptive resampling." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "To mitigate class-frequency bias, we applied a stratified balancing procedure combining Propensity Score Matching and adaptive resampling." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2291> .

<urn:repronim:abide:abstract/ohbm2026/2291/claim/3> a ex:AbstractClaim ;
    rdfs:label "The NCL-VAE preserves the geometry of typical developmental organization while accommodating ASD-related variation." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361>,
        <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "To this end, we developed a Normative Continual Learning Variational Autoencoder (NCL-VAE) that preserves the geometry of typical developmental organization while accommodating ASD-related variation.^4" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2291> .

<urn:repronim:abide:abstract/ohbm2026/2291/claim/4> a ex:AbstractClaim ;
    rdfs:label "The NCL-VAE consisted of a variational autoencoder coupled with an auxiliary age regressor." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The NCL-VAE consisted of a variational autoencoder coupled with an auxiliary age regressor." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2291> .

<urn:repronim:abide:abstract/ohbm2026/2291/claim/5> a ex:AbstractClaim ;
    rdfs:label "The model was trained sequentially, first on TDC data and subsequently on ASD data, using an improved Elastic Weight Consolidation (EWC) strategy to prevent catastrophic forgetting and maintain a shared normative manifold." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "The model was trained sequentially, first on TDC data and subsequently on ASD data, using an improved Elastic Weight Consolidation (EWC) strategy to prevent catastrophic forgetting and maintain a shared normative manifold." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2291> .

<urn:repronim:abide:abstract/ohbm2026/2291/claim/6> a ex:AbstractClaim ;
    rdfs:label "ASD-related FC patterns do not occupy an independent or orthogonal network regime." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Latent space representations revealed that ASD-related FC patterns do not occupy an independent or orthogonal network regime." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2291> .

<urn:repronim:abide:abstract/ohbm2026/2291/claim/7> a ex:AbstractClaim ;
    rdfs:label "ASD-related FC patterns substantially overlap with the continuum defined by typical development." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361>,
        <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Instead, they substantially overlap with the continuum defined by typical development, consistent with the RDoC perspective of continuous variation rather than categorical distinctness." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2291> .

<urn:repronim:abide:abstract/ohbm2026/2291/claim/8> a ex:AbstractClaim ;
    rdfs:label "ASD-related variation is structured predominantly along a low-dimensional axis associated with large-scale network de-differentiation." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Latent space representations revealed that ASD-related FC patterns do not occupy an independent or orthogonal network regime. Instead, they substantially overlap with the continuum defined by typical development, consistent with the RDoC perspective of continuous variation rather than categorical distinctness." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2291> .

<urn:repronim:abide:abstract/ohbm2026/2291/claim/9> a ex:AbstractClaim ;
    rdfs:label "Counterfactual traversal along the normative reorganization axis generated FC patterns characterized by progressive global de-differentiation." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Counterfactual traversal along the normative reorganization axis, inferred exclusively from TDC data and extrapolated toward reduced network segregation, extrapolated toward an extreme state, generated FC patterns characterized by progressive global de-differentiation." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2291> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/0> a ex:AbstractClaim ;
    rdfs:label "The choroid plexus forms the blood–cerebrospinal fluid barrier and orchestrates neuroimmune signaling." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "The choroid plexus forms the blood–cerebrospinal fluid barrier and orchestrates neuroimmune signaling," ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/1> a ex:AbstractClaim ;
    rdfs:label "Prior evidence suggests choroid plexus morphological alterations may be present in autism spectrum disorder (ASD)." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Prior evidence suggests choroid plexus morphological alterations may be present in autism spectrum disorder (ASD)^(1)," ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/10> a ex:AbstractClaim ;
    rdfs:label "The deterministic pipeline produced binary masks by majority vote across ensemble members." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "The deterministic pipeline produced binary masks by majority vote across ensemble members." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/11> a ex:AbstractClaim ;
    rdfs:label "Monte Carlo dropout with p = 0.1 was enabled during finetuning and inference in each ensemble model to approximate Bayesian behavior without architectural overhaul." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "We enabled Monte Carlo (MC) dropout (p = 0.1) during finetuning and inference in each ensemble model to approximate Bayesian behavior without architectural overhaul^(5)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/12> a ex:AbstractClaim ;
    rdfs:label "For each subject, voxel-wise probability maps were generated and four uncertainty metrics were computed: prediction standard deviation, total predictive entropy, aleatoric entropy, and epistemic uncertainty." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "For each subject, we generated voxel‑wise probability maps and computed four uncertainty metrics: (i) prediction standard deviation, (ii) total predictive entropy, (iii) aleatoric entropy (expected per‑sample entropy), and (iv) epistemic uncertainty (mutual information)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/13> a ex:AbstractClaim ;
    rdfs:label "The study ran 100 iterations per local subject, corresponding to 20 MC passes times 5 models." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We ran 100 iterations per local subject (20 MC passes × 5 models)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/14> a ex:AbstractClaim ;
    rdfs:label "Accuracy was quantified via Dice similarity coefficients between automated and manual labels." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Accuracy was quantified via Dice similarity coefficients between automated and manual labels." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/15> a ex:AbstractClaim ;
    rdfs:label "For baseline comparison, the authors generated choroid plexus labels using FreeSurfer v6.0 automated segmentation." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "For a baseline comparison to another automated method, we generated choroid plexus labels using FreeSurfer’s (v6.0) automated segmentation." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/16> a ex:AbstractClaim ;
    rdfs:label "A linear mixed-effects model on Dice coefficients was fit with fixed factors of segmentation method, sex, and diagnosis, and random intercepts per subject." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "To test performance bias, we fit a linear mixed‑effects model on Dice coefficients with fixed factors of segmentation method, sex, and diagnosis, and random intercepts per subject." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/17> a ex:AbstractClaim ;
    rdfs:label "Finetuning markedly improved segmentation versus FreeSurfer and non-finetuned ASCHOPLEX." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Finetuning markedly improved segmentation versus FreeSurfer and non‑finetuned ASCHOPLEX." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/18> a ex:AbstractClaim ;
    rdfs:label "Deterministic versus probabilistic finetuned model performance did not significantly differ." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Deterministic vs. probabilistic finetuned model performance did not significantly differ (T(53)=1.16, p=0.25)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/19> a ex:AbstractClaim ;
    rdfs:label "Without finetuning, ASCHOPLEX showed better performance on control participants than on ASD participants." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Without finetuning, ASCHOPLEX showed better performance on CON participants (higher Dice in CON vs. ASD: T(23,30)=4.04, p<0.001)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/2> a ex:AbstractClaim ;
    rdfs:label "ASCHOPLEX enables automatic segmentation of choroid plexus based on T1-weighted MRI." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "ASCHOPLEX enables automatic segmentation of choroid plexus based on T1-weighted MRI and has demonstrated high specificity for identifying choroid plexus in adults with and without multiple sclerosis^(2)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/20> a ex:AbstractClaim ;
    rdfs:label "Finetuning removed the diagnostic bias for both deterministic and probabilistic pipelines." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Finetuning removed the diagnostic bias for both deterministic and probabilistic pipelines (ASD vs. CON: n.s.; male vs. female: n.s.)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/21> a ex:AbstractClaim ;
    rdfs:label "Uncertainty was minimal in the local adult dataset, near the MC-dropout floor." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Uncertainty was minimal in the local adult dataset, near the MC‑dropout “floor,” consistent with in‑distribution inputs far from decision boundaries." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/22> a ex:AbstractClaim ;
    rdfs:label "In ABIDE, uncertainty increased significantly." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In ABIDE, uncertainty increased significantly (standard deviation and total entropy: ABIDE adults > local, ABIDE children > ABIDE adults, all p<0.01 to p<0.001)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/23> a ex:AbstractClaim ;
    rdfs:label "The rise in uncertainty was driven by epistemic, not aleatoric, uncertainty." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Decomposition revealed that the rise was driven by epistemic, not aleatoric, uncertainty, implicating model unfamiliarity (age and acquisition diversity) rather than data noise per se" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/24> a ex:AbstractClaim ;
    rdfs:label "The authors argue that model unfamiliarity due to age and acquisition diversity, rather than data noise, explains the uncertainty increase." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Decomposition revealed that the rise was driven by epistemic, not aleatoric, uncertainty, implicating model unfamiliarity (age and acquisition diversity) rather than data noise per se" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/25> a ex:AbstractClaim ;
    rdfs:label "These findings align with known age effects on ventricular anatomy that diminish CP–CSF contrast in children, resulting in poorer CP segmentation without finetuning on children." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361>,
        <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "These findings align with known age effects on ventricular anatomy that diminish CP–CSF contrast in children, resulting in poorer CP segmentation without finetuning on children." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/26> a ex:AbstractClaim ;
    rdfs:label "ASCHOPLEX, when finetuned on a small adult subset of ASD and CON MRI scans, achieves near-human-level CP segmentation accuracy and removes performance biases." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "ASCHOPLEX, when finetuned on a small adult subset of ASD and CON MRI scans, achieves near–human‑level CP segmentation accuracy and removes performance biases, supporting its utilization for large‑scale ASD studies." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/27> a ex:AbstractClaim ;
    rdfs:label "Extending the ensemble to a probabilistic implementation enriched with MC dropout preserves accuracy while yielding robust voxel-wise confidence maps." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Extending the ensemble to a probabilistic implementation enriched with MC dropout preserves accuracy while yielding robust voxel‑wise confidence maps, which are of great significance for assessing the reliability in cohorts when manual labels are unavailable (e.g., ABIDE)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/3> a ex:AbstractClaim ;
    rdfs:label "ASCHOPLEX has demonstrated high specificity for identifying choroid plexus in adults with and without multiple sclerosis." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "ASCHOPLEX enables automatic segmentation of choroid plexus based on T1-weighted MRI and has demonstrated high specificity for identifying choroid plexus in adults with and without multiple sclerosis^(2)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/4> a ex:AbstractClaim ;
    rdfs:label "The study assessed the generalizability of ASCHOPLEX to ASD cohorts and implemented a probabilistic variant to quantify model confidence when manual ground-truth labels are unavailable." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Here, we assessed the generalizability of the ASCHOPLEX tool to ASD cohorts and implemented a probabilistic variant to quantify model confidence when “ground truth” labels obtained by manual tracing are unavailable." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2343> .

<urn:repronim:abide:abstract/ohbm2026/2343/claim/5> a ex:AbstractClaim ;
    rdfs:label "High-resolution T1-weighted MEMPRAGE MRI were acquired from a local adult cohort (n=65; 36 ASD, 29 CON; ages 18–40 years) using a 3T TIM Trio with 1.0 mm isotropic voxels." ;
