    ex:sourceQuote "For brain state quantization, we developed NeuroLex, a vector-quantized graph Transformer framework designed to discretize fMRI brain dynamics, as illustrated in Fig. 1b." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2627> .

<urn:repronim:abide:abstract/ohbm2026/2627/claim/1> a ex:AbstractClaim ;
