    ex:sourceQuote "the model demonstrated high reliability for the ASD class with a precision of 0.88 and sensitivity (recall) of 0.79." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/639> .

<urn:repronim:abide:abstract/ohbm2026/639/claim/11> a ex:AbstractClaim ;
    rdfs:label "Specificity for the TD class was 0.54." ;
