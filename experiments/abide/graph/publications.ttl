    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "For each clinical subject, individual deviations were computed as Z-scores from age and sex matched normative estimates." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2782> .

<urn:repronim:abide:abstract/ohbm2026/2782/claim/2> a ex:AbstractClaim ;
    rdfs:label "The study assembled a multi-site rs-fMRI dataset of 15,307 participants aged 5–100 years from 98 scanners across 13 datasets." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
