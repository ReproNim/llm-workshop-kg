<urn:repronim:abide:abstract/ohbm2026/2/claim/4> a ex:AbstractClaim ;
    rdfs:label "Deco and Kringelbach1 showed that treating the brain as a system of coupled oscillators allows turbulent markers to be identified in rsfMRI, offering a detailed view of spatiotemporal synchronization dynamics." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Deco and Kringelbach1 showed that treating the brain as a system of coupled oscillators allows turbulent markers to be identified in rsfMRI, offering a detailed view of spatiotemporal synchronization dynamics." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2> .

<urn:repronim:abide:abstract/ohbm2026/2/claim/5> a ex:AbstractClaim ;
    rdfs:label "The final sample included 505 autistic individuals and 504 TD individuals." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "After all filtering steps, the final sample included 505 autistic individuals (mean age = 16.29, SD = 9.00) and 504 TD individuals (mean age = 16.68, SD = 8.94)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2> .

<urn:repronim:abide:abstract/ohbm2026/2/claim/6> a ex:AbstractClaim ;
    rdfs:label "Higher λ values correspond to narrower weighting kernels, while lower values correspond to wider kernels." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Higher λ values correspond to narrower weighting kernels, while lower values correspond to wider kernels." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2> .

<urn:repronim:abide:abstract/ohbm2026/2/claim/7> a ex:AbstractClaim ;
    rdfs:label "Metastability is temporal variation in whole-brain synchronization." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Metastability – temporal variation in whole-brain synchronization (sd(KGOP))." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2> .

<urn:repronim:abide:abstract/ohbm2026/2/claim/8> a ex:AbstractClaim ;
    rdfs:label "Metastability differed significantly between groups, with lower levels in autism." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006>,
        <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Metastability differed significantly between groups (Figure 2a, F(1,1003) = 3.92, p = 0.048, d = 0.13), with lower levels in autism, indicating reduced whole-brain variability over time." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2> .

<urn:repronim:abide:abstract/ohbm2026/2020/claim/0> a ex:AbstractClaim ;
    rdfs:label "Reynolds et al. (2023) first noted stripes of low TSNR in one site's subjects and used AFNI's InstaCorr tool to reveal extended, nonphysiological patterns of strong correlation and anticorrelation associated with the stripes, for all subjects in that collection." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "During the FMRI Open QC Project [1], Reynolds et al. (2023) [2] first noted stripes of low TSNR in one site's subjects and then used the AFNI [3] GUI's InstaCorr tool (instant correlation) to reveal extended, nonphysiological patterns of strong correlation and anticorrelation associated with the stripes, for all subjects in that collection." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2020> .

<urn:repronim:abide:abstract/ohbm2026/2020/claim/1> a ex:AbstractClaim ;
    rdfs:label "The authors developed an AFNI tool named find_variance_lines.tcsh to detect variance lines." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We have since developed a tool in AFNI to detect these variance lines (aptly named find_variance_lines.tcsh) and to systematically study datasets that have them;" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2020> .

<urn:repronim:abide:abstract/ohbm2026/2020/claim/10> a ex:AbstractClaim ;
    rdfs:label "Variance line artifacts appear to be present in a surprisingly large fraction of data collections." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "We are still assessing the extent of the effects of the variance line artifacts across repositories, but variance line artifacts appear to be present in a surprisingly large fraction of data collections." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2020> .

<urn:repronim:abide:abstract/ohbm2026/2020/claim/2> a ex:AbstractClaim ;
    rdfs:label "Variance line artifacts have not been reported previously." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "To our knowledge, this artifact has not been reported previously, and we term these \"variance line artifacts\"." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2020> .

<urn:repronim:abide:abstract/ohbm2026/2020/claim/3> a ex:AbstractClaim ;
    rdfs:label "The tool estimates a slightly eroded data mask, detrends each voxel time series, estimates variance, scales variance by the 90th percentile, computes mean scaled variance along each z-axis, and labels columns bad if the mean exceeds 0.97." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote """The algorithm proceeds as follows:

-

estimate a slightly eroded data mask for the EPI volume

-

detrend each voxel time series and estimate its variance

-

estimate the 90th %ile value of variance within the mask volume

-

scale each voxel's variance value by the 90th %ile value, with a ceiling of 1

-

calculate the mean of the scaled variance along each z-axis within the eroded mask

-

label any column as "bad" if its mean is above a threshold (default: 0.97).""" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2020> .

<urn:repronim:abide:abstract/ohbm2026/2020/claim/4> a ex:AbstractClaim ;
    rdfs:label "The variance pattern across any given EPI volume is generally non-uniform due to motion effects at the edge of the brain, B0 inhomogeneity, scanner distortions, midline brightness, and coil variability." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:sourceQuote "Since the variance pattern across any given EPI volume is generally non-uniform (e.g., due to motion effects at the edge of the brain, B0 inhomogeneity, scanner distortions, midline brightness, and coil variability)," ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2020> .

<urn:repronim:abide:abstract/ohbm2026/2020/claim/5> a ex:AbstractClaim ;
    rdfs:label "The tool outputs automatic images of the sagittal slice of the scaled variance map for manual QC evaluation." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "To help the user distinguish these, this program also outputs automatic images of the sagittal slice of the scaled variance map, for manual quality control (QC) evaluation." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2020> .

<urn:repronim:abide:abstract/ohbm2026/2020/claim/6> a ex:AbstractClaim ;
    rdfs:label "The authors investigated 193 data collections from FCP, ABIDE-1, ABIDE-2, and OpenNeuro." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "Using this new AFNI tool, we investigated the prevalence of the variance line artifact by looking at subsets of up to ten subjects from each of 193 data collections in popularly used data repositories: 33 in the Functional Connectome Project (FCP), 24 in ABIDE-1 and 19 in ABIDE-2, and 117 in OpenNeuro." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2020> .

<urn:repronim:abide:abstract/ohbm2026/2020/claim/7> a ex:AbstractClaim ;
    rdfs:label "Panels A and B in Fig 1 each show an example of finding variance lines with find_variance_lines.tcsh and associated artifactual features in one example subject." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "Panels A and B in Fig 1 each show an example of finding variance lines with find_variance_lines.tcsh and associated artifactual features in the data from one example subject." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2020> .

<urn:repronim:abide:abstract/ohbm2026/2020/claim/8> a ex:AbstractClaim ;
    rdfs:label "The artifacts would affect any further analyses with these data." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000361> ;
    ex:sourceQuote "Thus, the artifacts would affect any further analyses with these data." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2020> .

<urn:repronim:abide:abstract/ohbm2026/2020/claim/9> a ex:AbstractClaim ;
    rdfs:label "The manuscript reports 6 of 24 ABIDE-1 collections, 5 of 19 ABIDE-2 collections, 8 of 33 FCP collections, and at least 15 of 117 OpenNeuro sites appeared to have variance lines." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
    ex:sourceQuote "For example, 6 of 24 collections in ABIDE-1 and 5 of 19 in ABIDE-2 appeared to have at least one subject with variance lines. 8 of 33 FCP collections contained some examples, as did at least 15 of 117 OpenNeuro sites." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2020> .

<urn:repronim:abide:abstract/ohbm2026/2033/claim/0> a ex:AbstractClaim ;
    rdfs:label "GAMLSS are a powerful tool for creating normative models and centile growth curves for developmental data." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Generalized additive models for location, scale, and shape (GAMLSS) are a powerful tool for creating normative models and centile growth curves for developmental data." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2033> .

<urn:repronim:abide:abstract/ohbm2026/2033/claim/1> a ex:AbstractClaim ;
    rdfs:label "GAMLSS models have been increasingly applied to human neuroimaging." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0006151> ;
    ex:sourceQuote "Leveraging their ability to capture nonlinear and heteroskedastic distributions, GAMLSS models have been increasingly applied to human neuroimaging." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2033> .

<urn:repronim:abide:abstract/ohbm2026/2033/claim/10> a ex:AbstractClaim ;
    rdfs:label "With a large sample, models were robust to overfitting when using this penalty, despite the unharmonized data." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "With a large sample, models were robust to overfitting when using this penalty, despite the unharmonized data (Fig. 1A)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2033> .

<urn:repronim:abide:abstract/ohbm2026/2033/claim/11> a ex:AbstractClaim ;
    rdfs:label "In experiment 2, applying a similar approach resulted in overfitting to non-biological oscillations in the study population." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "A similar approach to 1) resulted in overfitting to non-biological oscillations in the study population, decreasing the likelihood that these curves would generalize across diverse cohorts." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2033> .

<urn:repronim:abide:abstract/ohbm2026/2033/claim/12> a ex:AbstractClaim ;
    rdfs:label "The authors developed a novel fitting procedure using a leave-one-dataset-out approach." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We developed a novel fitting procedure using a leave-one-dataset-out approach." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2033> .

<urn:repronim:abide:abstract/ohbm2026/2033/claim/13> a ex:AbstractClaim ;
    rdfs:label "They optimized hyperparameters by minimizing the summed model BIC scores across iterations." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We then optimized hyperparameters by minimizing the summed model BIC scores across iterations, leading to robust models that could be validated across datasets (Fig. 1B)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2033> .

<urn:repronim:abide:abstract/ohbm2026/2033/claim/14> a ex:AbstractClaim ;
    rdfs:label "The resulting models could be validated across datasets." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "We then optimized hyperparameters by minimizing the summed model BIC scores across iterations, leading to robust models that could be validated across datasets (Fig. 1B)." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2033> .

<urn:repronim:abide:abstract/ohbm2026/2033/claim/15> a ex:AbstractClaim ;
    rdfs:label "In experiment 3, four-term distribution models were susceptible to overfitting because there were fewer samples per group." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0000006> ;
    ex:sourceQuote "In 3), with fewer samples per group than in previous cases, four-term distribution models were susceptible to overfitting." ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/2033> .

<urn:repronim:abide:abstract/ohbm2026/2033/claim/16> a ex:AbstractClaim ;
    rdfs:label "The authors limited comparisons to two- and three-term distributions." ;
