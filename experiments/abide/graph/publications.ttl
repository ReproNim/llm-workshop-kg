<urn:repronim:abide:abstract/ohbm2026/25/claim/13> a ex:AbstractClaim ;
    rdfs:label "Cluster 1 included regions of the default mode network (DMN) and dorsal attention network (DAN), with peak Hb connectivity in the left angular gyrus (IAG, BA 39)." ;
    ex:claimTypeAbstractAtlas "EXPLICIT" ;
    ex:ecoCode <http://purl.obolibrary.org/obo/ECO_0007672> ;
