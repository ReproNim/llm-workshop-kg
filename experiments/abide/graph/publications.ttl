<urn:repronim:abide:abstract/ohbm2026/2782/claim/21> a ex:AbstractClaim ;
    rdfs:label "The population-level canonical lag was +3.80 seconds and the negative correlation between global BOLD and CSF signals was maximal there with mean r = −0.24." ;
