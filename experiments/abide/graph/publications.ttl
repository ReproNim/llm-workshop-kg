<urn:repronim:abide:abstract/ohbm2026/2033/claim/17> a ex:AbstractClaim ;
    rdfs:label "In experiments 1 and 2, model parameters were chosen by minimizing the BIC, providing a penalty on the degrees of freedom." ;
