    ex:sourceQuote "the Autism Brain Imaging Data Exchange (ABIDE) provides 1,112 rs-fMRI scans from individuals with ASD and age-matched typically developing (TD) controls" ;
    ex:sourceQuoteVerified true ;
    ex:statedIn <urn:repronim:abide:abstract/ohbm2026/639> .

<urn:repronim:abide:abstract/ohbm2026/639/claim/1> a ex:AbstractClaim ;
