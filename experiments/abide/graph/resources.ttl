<urn:repronim:abide:resource/dimartino2014> a schema1:ScholarlyArticle,
        ex:Resource ;
    rdfs:label "Di Martino et al. 2014 (ABIDE)" ;
    schema1:audience "neuroimaging researchers" ;
    schema1:description "Introduces ABIDE and reports whole-brain functional connectivity differences in 763 males: both hypo- and hyperconnectivity, with hypoconnectivity dominating, especially cortico-cortical and interhemispheric." ;
    schema1:identifier <https://doi.org/10.1038/mp.2013.78> ;
    schema1:name "Di Martino et al. 2014 (ABIDE)" ;
    schema1:url <https://doi.org/10.1038/mp.2013.78> ;
