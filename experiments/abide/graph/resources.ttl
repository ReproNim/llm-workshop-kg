<urn:repronim:abide:resource/abide-preprocessed> a schema1:Dataset,
        dcat:Dataset,
        ex:Resource ;
    rdfs:label "ABIDE Preprocessed (PCP)" ;
    schema1:audience "neuroimaging researchers" ;
    schema1:description "Preprocessed ABIDE I resting-state fMRI and structural derivatives from the Preprocessed Connectomes Project: four pipelines (C-PAC, CCS, DPARSF, NIAK), several strategies and atlases, ROI time series, FreeSurfer and ANTs outputs, and a phenotype table with three-rater QC. Public on S3 (fcp-indi)." ;
    schema1:name "ABIDE Preprocessed (PCP)" ;
    schema1:url <http://preprocessed-connectomes-project.org/abide/> ;
    ex:descriptionSource <http://preprocessed-connectomes-project.org/abide/> ;
    ex:edamTopic edam:topic_3419,
        edam:topic_3444 ;
    ex:modality "MRI",
        "fMRI",
        "phenotype" ;
    ex:openalexSearch "Preprocessed Connectomes Project ABIDE" ;
    ex:outputFormat edam:format_3549,
        edam:format_3752 ;
    ex:produces "nidm:AcquisitionObject",
        "nidm:DerivativeObject" ;
    ex:resourceType "Dataset" ;
    ex:usageInExperiment "data_source" ;
    ex:usageNote "Phenotype table, CC200 time series (C-PAC filt_noglobal), ANTs ROI thickness and the C-PAC config were downloaded and hashed." ;
    ex:workflowStep <urn:repronim:abide:step/data_source>,
        <urn:repronim:abide:step/preprocessing> .

<urn:repronim:abide:resource/abide-raw-bids> a schema1:Dataset,
        dcat:Dataset,
        ex:Resource ;
    rdfs:label "ABIDE I raw data (BIDS, S3)" ;
    schema1:audience "neuroimaging researchers" ;
    schema1:description "Raw ABIDE I T1w and resting BOLD scans from 1,112 participants at 17 international sites, in BIDS on S3 (fcp-indi RawDataBIDS)." ;
    schema1:name "ABIDE I raw data (BIDS, S3)" ;
    schema1:url <https://fcon_1000.projects.nitrc.org/indi/abide/> ;
    ex:descriptionSource <https://fcon_1000.projects.nitrc.org/indi/abide/> ;
    ex:edamTopic edam:topic_3419,
        edam:topic_3444 ;
    ex:modality "MRI",
        "fMRI" ;
    ex:outputFormat edam:format_3549 ;
    ex:produces "nidm:AcquisitionObject" ;
    ex:resourceType "Dataset" ;
    ex:usageInExperiment "pointer" ;
    ex:usageNote "Referenced by URL as source scans; not downloaded." ;
    ex:workflowStep <urn:repronim:abide:step/acquisition>,
        <urn:repronim:abide:step/data_source> .

<urn:repronim:abide:resource/abraham2017> a schema1:ScholarlyArticle,
        ex:Resource ;
    rdfs:label "Abraham et al. 2017 (inter-site prediction)" ;
    schema1:audience "neuroimaging researchers" ;
    schema1:description "Shows inter-site prediction of autism diagnosis from functional connectomes on 871 ABIDE participants (about 67% accuracy) and that region definition matters most among pipeline choices." ;
    schema1:identifier <https://doi.org/10.1016/j.neuroimage.2016.10.045> ;
    schema1:name "Abraham et al. 2017 (inter-site prediction)" ;
    schema1:url <https://doi.org/10.1016/j.neuroimage.2016.10.045> ;
    ex:descriptionSource <https://doi.org/10.1016/j.neuroimage.2016.10.045> ;
    ex:doi "10.1016/j.neuroimage.2016.10.045" ;
    ex:edamTopic edam:topic_3419,
        edam:topic_3474 ;
    ex:modality "fMRI" ;
    ex:produces "ex:Claim",
        "ex:ResearchQuestion" ;
    ex:resourceType "ScholarlyArticle" ;
    ex:usageInExperiment "data_source" ;
    ex:usageNote "Question, claims, cohort and methods extracted with verbatim quotes (arXiv v1)." ;
    ex:workflowStep <urn:repronim:abide:step/data_source>,
        <urn:repronim:abide:step/statistics_results> .

<urn:repronim:abide:resource/ants-nidm_bidsapp> a schema1:SoftwareSourceCode,
        ex:Resource ;
    rdfs:label "ANTs NIDM BIDS App" ;
    schema1:audience "neuroimaging researchers" ;
    schema1:codeRepository <https://github.com/ReproNim/ants-nidm_bidsapp> ;
    schema1:description "A BIDS App that segments a T1w image into about 100 labelled structures with multi-atlas joint label fusion (GPU registration via FireANTs) and writes per-structure volumes as CSV and NIDM Turtle. Use it for ANTs volumes that pool across studies. Needs a GPU for registration." ;
    schema1:license "MIT" ;
    schema1:name "ANTs NIDM BIDS App" ;
    schema1:programmingLanguage "Python" ;
    schema1:url <https://github.com/ReproNim/ants-nidm_bidsapp> ;
    schema1:version "25c7a29340c968edd5677e590af50715206b3ecf" ;
    codemeta:maintainer "ReproNim" ;
    ex:consumes "BIDS dataset" ;
    ex:descriptionSource <https://github.com/ReproNim/ants-nidm_bidsapp/blob/25c7a29340c968edd5677e590af50715206b3ecf/README.md> ;
    ex:edamOperation edam:operation_3443 ;
    ex:edamTopic edam:topic_3382 ;
    ex:githubRepo "ReproNim/ants-nidm_bidsapp" ;
    ex:inputFormat edam:format_3549 ;
    ex:modality "MRI" ;
    ex:outputFormat edam:format_3255,
        edam:format_3752 ;
    ex:pinnedCommit "25c7a29340c968edd5677e590af50715206b3ecf" ;
    ex:produces "ex:BrainVolume",
        "nidm:DerivativeObject" ;
    ex:resourceType "SoftwareSourceCode" ;
    ex:usageInExperiment "pointer" ;
    ex:usageNote "Would regenerate ANTs volumes with NIDM output; not run here." ;
    ex:workflowStep <urn:repronim:abide:step/containerized_execution>,
        <urn:repronim:abide:step/idp_extraction_to_nidm> .

<urn:repronim:abide:resource/ants_seg_to_nidm> a schema1:SoftwareSourceCode,
        ex:Resource ;
    rdfs:label "ants_seg_to_nidm" ;
    schema1:audience "neuroimaging researchers" ;
    schema1:codeRepository <https://github.com/ReproNim/ants_seg_to_nidm> ;
    schema1:description "Exports ANTs-based structural segmentation volumes to NIDM, with a CDE file (ants_cde.ttl) that maps each ANTs measure to anatomy and units. Use it to add ANTs volumes to a NIDM dataset graph. Does not run ANTs." ;
    schema1:license "MIT" ;
    schema1:name "ants_seg_to_nidm" ;
    schema1:programmingLanguage "Python" ;
    schema1:url <https://github.com/ReproNim/ants_seg_to_nidm> ;
    schema1:version "97e6257b0827a0e6bcc78c179f83168c83397f39" ;
    codemeta:maintainer "ReproNim" ;
    ex:consumes "ANTs segmentation outputs" ;
    ex:descriptionSource <https://github.com/ReproNim/ants_seg_to_nidm/blob/97e6257b0827a0e6bcc78c179f83168c83397f39/README.md> ;
    ex:edamOperation edam:operation_3434 ;
    ex:githubRepo "ReproNim/ants_seg_to_nidm" ;
    ex:modality "MRI" ;
    ex:outputFormat edam:format_3255 ;
    ex:pinnedCommit "97e6257b0827a0e6bcc78c179f83168c83397f39" ;
    ex:produces "ex:BrainVolume",
        "nidm:DataElement" ;
    ex:resourceType "SoftwareSourceCode" ;
    ex:usageInExperiment "data_source" ;
    ex:usageNote "ants_cde.ttl at a pinned commit was loaded to interpret ANTs volumes in the simple2 graphs." ;
    ex:workflowStep <urn:repronim:abide:step/idp_extraction_to_nidm> .

