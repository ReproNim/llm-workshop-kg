<urn:repronim:abide:paper/abraham2017/AB_Q> a ex:ResearchQuestion ;
    rdfs:label "AB_Q" ;
    ex:hasEvidence <urn:repronim:abide:paper/abraham2017/AB_Q/evidence> ;
    ex:statedIn <urn:repronim:abide:paper/abraham2017> .

<urn:repronim:abide:rule/motion_v1> a prov:Entity,
        ex:SelectionRule ;
    rdfs:label "shared motion rule v1" ;
    prov:wasAttributedTo ex:analystA ;
    ex:comparison "lessThan" ;
    ex:definition "func_mean_fd < 0.2 mm" ;
    ex:threshold 2e-01 ;
    ex:variable ns1:func_mean_fd .

<urn:repronim:abide:result/A_v1> a prov:Entity,
        ex:Result ;
    rdfs:label "Analyst A result v1" ;
    prov:wasDerivedFrom <urn:repronim:abide:cohort/A_v1> ;
    prov:wasGeneratedBy <urn:repronim:abide:analysis/A_v1> ;
    ex:hypo_fraction 9.961312e-01 ;
    ex:hypo_fraction_ci_high 9.979636e-01 ;
    ex:hypo_fraction_ci_low 9.018636e-01 ;
    ex:interhemispheric_fraction_hypo_edges 5.178472e-01 ;
    ex:median_abs_d_significant 2.953623e-01 ;
    ex:n 441 ;
    ex:n_fdr_significant 5428 ;
    ex:n_hyper 21 ;
    ex:n_hypo 5407 ;
    ex:resultFile "results/analyst_a_v1.json" .

ex:analystB a prov:Agent,
        prov:Person ;
    rdfs:label "Analyst B (hypothetical)" ;
    ex:scenarioStatus "illustrative scenario; hypothetical analyst, not a real person's contribution" .

