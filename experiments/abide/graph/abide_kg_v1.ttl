<urn:repronim:abide:assessment/A_vs_paper> a prov:Entity,
        ex:EvidenceAssessment ;
    rdfs:label "Analyst A claim vs paper claim" ;
    prov:wasAttributedTo ex:analystA ;
    prov:wasDerivedFrom <urn:repronim:abide:claim/A_v1>,
        <urn:repronim:abide:paper/dimartino2014/DM_C1> ;
    prov:wasGeneratedBy <urn:repronim:abide:activity/compare_A_to_paper> ;
    ex:caveat "Same direction is testable; pipeline differs (release C-PAC, Friston-24 vs alpha C-PAC, 6 motion parameters), cohort differs (A_v1 vs 763), CC200 only. Not a replication." ;
    ex:target <urn:repronim:abide:paper/dimartino2014/DM_C1> ;
    ex:verdict "comparable question, non-equivalent analysis" .

<urn:repronim:abide:assessment/B_vs_paper> a prov:Entity,
        ex:EvidenceAssessment ;
    rdfs:label "Analyst B claim vs paper claim" ;
    prov:wasAttributedTo ex:analystB ;
    prov:wasDerivedFrom <urn:repronim:abide:claim/B_v1>,
        <urn:repronim:abide:paper/abraham2017/AB_C1> ;
    prov:wasGeneratedBy <urn:repronim:abide:activity/compare_B_to_paper> ;
    ex:caveat "Same question form; atlas differs (CC200 vs MSDL best), cohort differs (B_v1 vs 871), single classifier. Not a replication." ;
    ex:target <urn:repronim:abide:paper/abraham2017/AB_C1> ;
    ex:verdict "comparable question, non-equivalent analysis" .

