<urn:repronim:abide:paper/abraham2017/AB_C1/evidence> a ex:EvidenceSpan ;
    prov:wasQuotedFrom <urn:repronim:abide:paper/abraham2017> ;
    ex:charOffset 1813 ;
    ex:locator "Abstract" ;
    ex:quote "Good choices of methods for the various steps of the pipeline lead to 67% prediction accuracy on the full ABIDE data" ;
    ex:verbatimMatch true .

<urn:repronim:abide:paper/abraham2017/AB_C2/evidence> a ex:EvidenceSpan ;
    prov:wasQuotedFrom <urn:repronim:abide:paper/abraham2017> ;
    ex:charOffset 2324 ;
    ex:locator "Abstract" ;
    ex:quote "the definition of functional brain areas is of paramount importance for biomarker discovery" ;
    ex:verbatimMatch true .

<urn:repronim:abide:paper/abraham2017/AB_C3/evidence> a ex:EvidenceSpan ;
    prov:wasQuotedFrom <urn:repronim:abide:paper/abraham2017> ;
    ex:charOffset 2210 ;
    ex:locator "Abstract" ;
    ex:quote "prediction accuracy improves as we include more subjects" ;
    ex:verbatimMatch true .

<urn:repronim:abide:paper/abraham2017/AB_Q/evidence> a ex:EvidenceSpan ;
    prov:wasQuotedFrom <urn:repronim:abide:paper/abraham2017> ;
    ex:charOffset 1132 ;
    ex:locator "Abstract" ;
    ex:quote "we demonstrate the feasibility of inter-site classification of neuropsychiatric status" ;
    ex:verbatimMatch true .

<urn:repronim:abide:paper/abraham2017/AB_cohort/evidence> a ex:EvidenceSpan ;
    prov:wasQuotedFrom <urn:repronim:abide:paper/abraham2017> ;
    ex:charOffset 12138 ;
    ex:locator "Section 2.1" ;
    ex:quote "This yielded 871 subjects out of the initial 1112." ;
    ex:verbatimMatch true .

<urn:repronim:abide:paper/abraham2017/AB_cv/evidence> a ex:EvidenceSpan ;
    prov:wasQuotedFrom <urn:repronim:abide:paper/abraham2017> ;
    ex:charOffset 6708 ;
    ex:locator "Introduction" ;
    ex:quote "we left out entire sites to measure performance in the presence of uncontrolled variability" ;
    ex:verbatimMatch true .

<urn:repronim:abide:paper/abraham2017/AB_motion/evidence> a ex:EvidenceSpan ;
    prov:wasQuotedFrom <urn:repronim:abide:paper/abraham2017> ;
    ex:charOffset 12455 ;
    ex:locator "Section 2.1" ;
    ex:quote "Head motion was modeled using 24 regressors derived from the parameters estimated during motion realignment" ;
    ex:verbatimMatch true .

<urn:repronim:abide:paper/abraham2017/AB_qc/evidence> a ex:EvidenceSpan ;
    prov:wasQuotedFrom <urn:repronim:abide:paper/abraham2017> ;
    ex:charOffset 10318 ;
    ex:locator "Section 2.1" ;
    ex:quote "Data were selected based on the results of quality visual inspection by three human experts" ;
    ex:verbatimMatch true .

<urn:repronim:abide:paper/abraham2017/AB_tangent/evidence> a ex:EvidenceSpan ;
    prov:wasQuotedFrom <urn:repronim:abide:paper/abraham2017> ;
    ex:charOffset 32157 ;
    ex:locator "Section 3.3" ;
    ex:quote "Among all matrix types, tangent embedding is the best on all ABIDE subsets." ;
    ex:verbatimMatch true .

<urn:repronim:abide:paper/dimartino2014/DM_C1/evidence> a ex:EvidenceSpan ;
    prov:wasQuotedFrom <urn:repronim:abide:paper/dimartino2014> ;
    ex:charOffset 1222 ;
    ex:locator "Abstract" ;
    ex:quote "both were detected, though hypoconnectivity dominated, particularly for cortico-cortical and interhemispheric functional connectivity" ;
    ex:verbatimMatch true .

<urn:repronim:abide:paper/dimartino2014/DM_Q/evidence> a ex:EvidenceSpan ;
    prov:wasQuotedFrom <urn:repronim:abide:paper/dimartino2014> ;
    ex:charOffset 9054 ;
    ex:locator "Methods, Analytic Strategy" ;
    ex:quote "To understand the relative contributions of hypo and hyperconnectivity in ASD, we carried out whole-brain iFC analyses" ;
    ex:verbatimMatch true .

