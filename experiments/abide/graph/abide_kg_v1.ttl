    crypto:sha256 "87f34fecab62a5375ef2a55ae5a33c84f6141420a1b20a434b0c21bd9921163c" ;
    prov:atLocation <https://s3.amazonaws.com/fcp-indi/data/Projects/ABIDE_Initiative/Resources/pipeline_config.yml> ;
    ex:bandpassHz "0.01-0.1" ;
    ex:globalSignalRegression false ;
    ex:nuisance "CompCor 5 components; Friston 24 motion; linear and quadratic trend" ;
    ex:registration "ANTS; BBR func-to-anat" ;
    ex:scrubbing false ;
    ex:strategy "filt_noglobal (band-pass filtered, no global signal regression)" .

