<urn:repronim:abide:adoption/mni152_fsl_template> a prov:Activity,
        ex:Adoption ;
    prov:used <urn:repronim:abide:resource/mni152_fsl> ;
    ex:localDeviation "not MNI152NLin2009cAsym (the fMRIPrep default used in the CNP example)" ;
    ex:localParameters "anatomical registration at 2 mm, functional at 3 mm, ANTs" ;
    ex:localRevalidation "not re-validated here: preprocessing taken as released" ;
    ex:pinnedVersion "FSL 5.0 MNI152_T1_2mm (C-PAC pipeline_config.yml)" .

<urn:repronim:abide:adoption/nidm_linkml_schema> a prov:Activity,
        ex:Adoption ;
    prov:used <urn:repronim:abide:resource/pynidm> ;
    ex:localDeviation "13 classes and 191 properties declared in graph/abide_extension.ttl" ;
    ex:localParameters "open and closed SHACL generated with linkml gen-shacl 1.12.1" ;
    ex:localRevalidation "core graph: 11491 open-shape results; PyNIDM's own csv2nidm output: 134; simple2 Caltech: 114" ;
    ex:pinnedVersion "PyNIDM v4.5.5 (74793553f2ef0884602c4383fe8dbe8c74e3dcb8), schema 0.1.0" .

<urn:repronim:abide:adoption/simple2_nidm> a prov:Activity,
        ex:Adoption ;
    prov:used <urn:repronim:abide:resource/simple2_nidm_examples> ;
    ex:localParameters "loaded unmodified as 27 named graphs" ;
    ex:localRevalidation "identity join 1112/1112 with 0 field conflicts; shipped query output reproduced 12907/12907" ;
    ex:pinnedVersion "commit e0dff17629bd5031e246c05ff4bed174597552a2" .

