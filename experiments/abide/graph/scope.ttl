ex:participantRecords a ex:RecordFamily ;
    rdfs:label "ABIDE participant-level phenotype records, scan pointers, time series and IDPs (1,112 participants)" ;
    ex:accessLevel "public" ;
    ex:hasSensitivityProfile <urn:repronim:abide:sensitivity/abide_public_release> ;
    ex:knowledgeScope <urn:repronim:abide:scope/pond> ;
    ex:lakeCopy <http://preprocessed-connectomes-project.org/abide/> ;
    ex:memberPattern "urn:repronim:abide:record/*, participant/*, timeseries/*, connectivity/*, idp/*" ;
    ex:pondLevel "lab" ;
    ex:promotionPolicy "never-promote: the lake already holds the authoritative public release; link to it instead of copying" .

