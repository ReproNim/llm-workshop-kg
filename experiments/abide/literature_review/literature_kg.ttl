<urn:repronim:abide:litreview/quote/S-036/4> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "we ﬁrst divided the whole dataset into two parts: training (85%), and testing (15%). From the generated training images, approximately 85% of the whole images were considered as the training set, and 15% as the validation set." ;
