    ex:sourceQuoteVerified true ;
    ex:supportsClaim "ASD showed higher modular variability in default-mode regions and lower variability in visual cortex vs HC (FDR p<.05)." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-005/8> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "we found that brain dynamics was a significant predictor of SRS scores (r = .16, pperm = .002)" ;
