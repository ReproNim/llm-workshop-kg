    ex:sourceQuoteVerified true ;
    ex:supportsClaim "Three atlases used jointly: AAL, CC200, DOS160." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-074/4> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value """we employed 10-fold stratified cross-validation. For each fold, the model is trained
on the remaining nine training folds and evaluated on the held-out test fold.
Further, we set aside 30% of each training fold as validation sets""" ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-2> ;
    prov:wasQuotedFrom <https://doi.org/10.1007/978-3-031-44858-4_12> ;
    ex:sourceLocator "corpus local_d76b09c5 full_text sha256:2ef1e68f8601a72dc761366387f82d9358e8761d51af3aeca08ac33b41ba2455 section:methods (whitespace/ligature-normalised match)" ;
    ex:sourceQuoteVerified true ;
    ex:supportsClaim "Evaluation: 10-fold stratified CV with a held-out test fold and a separate validation split from the training folds (leakage-aware)." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

