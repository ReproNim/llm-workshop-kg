    ex:sourceQuoteVerified true ;
    ex:supportsClaim "Cases were selected aged 7-18 years with successful registration, FIQ 70-148, and mFD within 3xIQR+Q3 of the sample (~0.39mm)." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-008/3> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value """At each step, any sites with less than three individual 
datasets per diagnostic/sex groups were excluded.""" ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-1> ;
