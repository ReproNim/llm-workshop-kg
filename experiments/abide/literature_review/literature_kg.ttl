    ex:sourceQuoteVerified true ;
    ex:supportsClaim "816 subjects across 22 sites were distributed into five age ranges (5-10, 10-15, 15-20, 20-30, 30-65 years: 109, 342, 190, 137, 51 subjects respectively)." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-033/6> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "We then use a sequential feature selection technique to choose the top 10 features that contribute to this classiﬁcation." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-3> ;
    prov:wasQuotedFrom <https://doi.org/10.3389/fnins.2018.01018> ;
    ex:sourceLocator "corpus local_bb07b369 full_text sha256:e81de84254bd6b8062fcb0edf0ba99fe2ecca0e434e1e1d7d60eb659e590bfe4 section:methods (whitespace/ligature-normalised match)" ;
    ex:sourceQuoteVerified true ;
    ex:supportsClaim "A sequential feature selection (wrapper) method chose the top 10 of 817 graph-theory features per network-extraction method for the SVM." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-033/7> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "We minimized the risk of overﬁtting by using three limiting approaches. First, the simplest kernel (linear) was used for the SVM. Second, only 10 features were used to learn to classify between 104 subjects. Finally, using 10-fold cross validation ensured the model is only evaluated on data points that it has not experienced before." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-3> ;
    prov:wasQuotedFrom <https://doi.org/10.3389/fnins.2018.01018> ;
    ex:sourceLocator "corpus local_bb07b369 full_text sha256:e81de84254bd6b8062fcb0edf0ba99fe2ecca0e434e1e1d7d60eb659e590bfe4 section:methods (whitespace/ligature-normalised match)" ;
    ex:sourceQuoteVerified true ;
    ex:supportsClaim "Overfitting was limited using a linear SVM kernel, only 10 selected features, and 10-fold cross-validation so the model was evaluated only on unseen data." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

