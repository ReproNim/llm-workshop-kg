<urn:repronim:abide:litreview/quote/S-080/4> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "After excluding cases with high  head motion (cutoff: >2SD over mean framewise dis­ placement, n = 10), we obtained a sample size of n = 211  (103/108 ASD/NT)." ;
