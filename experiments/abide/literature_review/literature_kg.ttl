    ex:sourceQuoteVerified true ;
    ex:supportsClaim "DLPFC and superior/middle temporal cortex are common functional-structural covarying areas across ASD subtypes." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-009/7> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "negative fALFF in anterior cingulate cortex unique to PDD-NOS subtype; and negative thalamus–amygdala–caudate fALFF unique to the Autistic subtype." ;
