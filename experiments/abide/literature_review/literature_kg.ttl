    ex:sourceQuoteVerified true ;
    ex:supportsClaim "R-fMRI preprocessing included slice-time correction, 24-motion-parameter regression, CompCor noise reduction, detrending, and band-pass filtering; five metrics examined: PCC-iFC, VMHC, ReHo, DC, fALFF." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-008/5> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value """To account for site and collection time variability 
across each of the data collections in ABIDE I and II data 
repositories, site effects were removed using the ComBat 
function available in python [61] (https​://githu​b.com/
brent​p/comba​t.py). This approach has been shown to 
effectively account for scanner-related variance""" ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-1> ;
    prov:wasQuotedFrom <https://doi.org/10.1186/s13229-021-00415-z> ;
