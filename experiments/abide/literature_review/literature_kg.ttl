    ex:sourceQuoteVerified true ;
    ex:supportsClaim "Preprocessing used CPAC; functional connectivity used the Harvard-Oxford atlas (111 ROIs)." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

