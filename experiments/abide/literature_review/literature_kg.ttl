<urn:repronim:abide:litreview/quote/S-065/2> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "In our work, the structural MR images we used were aggregated from all 17 international sites, which contain 518 ASD patients and 567 age-matched normal controls (ages 7–64 years, median 14.7 years across groups)." ;
