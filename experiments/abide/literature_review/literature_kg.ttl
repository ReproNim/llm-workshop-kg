<urn:repronim:abide:litreview/quote/S-019/5> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "We focus our attention to the phenotypic graph (using default phenotypic measures), which corresponds to the graph constructed taking into account SEX and SITE information, weighted by the feature correlation similarity." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-5> ;
