<urn:repronim:abide:litreview/quote/S-001/2> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value """The current ABIDE II dataset encompasses 17 collections of unique independent datasets (i.e., from
individuals whose data were not previously shared in ABIDE I) yielding 487 datasets classiﬁed as ASD
and 557 as controls (Fig. 1a, Table 1). These represent previously collected datasets across 16 sites,
including nine charter ABIDE I institutions and seven new members""" ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-1> ;
    prov:wasQuotedFrom <https://doi.org/10.1038/sdata.2017.10> ;
    ex:sourceLocator "corpus local_b363d94a full_text sha256:008b2a1a334444bc7039cf2cc249390654ecdc65c2282cc44bfc1c5b205bf0e9 section:results char:11229" ;
    ex:sourceQuoteVerified true ;
    ex:supportsClaim "ABIDE II comprises 17 collections across 16 sites (9 ABIDE I charter sites plus 7 new sites)." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-001/3> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value """ASD classiﬁcation was determined by either 1) combining clinical judgment with ‘gold standard’
diagnostic instruments—Autism Diagnostic Observation Scale34,35 and/or Autism Diagnostic Interview-
Revised36 [ADOS, ADI-R]; (n = 12 data collections; 368 ASD datasets) or 2) by using these ‘gold
standard’ diagnostic instruments only (n = 4 collections; 92 ASD datasets)""" ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-1> ;
    prov:wasQuotedFrom <https://doi.org/10.1038/sdata.2017.10> ;
