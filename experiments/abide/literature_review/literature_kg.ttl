    ex:sourceQuoteVerified true ;
    ex:supportsClaim "In ABIDE, prediction performance declined as participant diversity increased, both within-distribution (AUC r=-0.630) and out-of-distribution (AUC r=-0.671)." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

