<urn:repronim:abide:litreview/quote/S-010/1> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "Our model achieves state-of-the-art 80% area under the ROC curve (AUROC) in diagnosis on test data from the IMPAC dataset; and 86% and 79% AUROC on the external ABIDE I and ABIDE II datasets (with further improvement to 93% and 90% after supervised domain adaptation)." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-3> ;
    prov:wasQuotedFrom <https://doi.org/10.1038/s41598-022-06459-2> ;
    ex:sourceLocator "corpus local_afcc5b8c full_text sha256:0fe8a35dd30a8f98e84dd5920ece680dca1a6d613a4339e941bab654c7788860 section:abstract (whitespace/ligature-normalised match)" ;
    ex:sourceQuoteVerified true ;
    ex:supportsClaim "Models trained on IMPAC generalise to ABIDE I and ABIDE II with 86% and 79% AUROC, improving to 93%/90% after supervised domain adaptation." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-010/2> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "Participants from all sites of the ABIDE I and ABIDE II were included for external validation, provided both sMRI and rsfMRI were obtained on the same visit. The first avail- able pair of sMRI and rsfMRI scans were used per subject. 1045 subjects from ABIDE I and 761 subjects from ABIDE II met this criteria." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-3> ;
    prov:wasQuotedFrom <https://doi.org/10.1038/s41598-022-06459-2> ;
    ex:sourceLocator "corpus local_afcc5b8c full_text sha256:0fe8a35dd30a8f98e84dd5920ece680dca1a6d613a4339e941bab654c7788860 section:methods (whitespace/ligature-normalised match)" ;
    ex:sourceQuoteVerified true ;
    ex:supportsClaim "External validation used all ABIDE I/II sites, restricted to subjects with a paired same-visit sMRI+rsfMRI scan: 1045 ABIDE I and 761 ABIDE II subjects." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-010/3> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "Table 3. Demographics of IMPAC participants, ABIDE I participants, and ABIDE II participants. Errors shown are standard deviations. IMPAC ABIDE I ABIDE II Female % 50 15 20 ASD % 46 48 52 Age (years) 17 ± 9.6 17 ± 8.1 17 ± 11 Total participants 915 1045 761" ;
