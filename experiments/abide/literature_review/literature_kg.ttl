<urn:repronim:abide:litreview/quote/S-036/5> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "Table V represents the classiﬁcation performance for ensemble learning showing that the third ensemble classiﬁer performs better than other ensembles." ;
