<urn:repronim:abide:litreview/quote/S-009/8> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "The identified subtype-specific patterns are only predictive for ASD symptoms manifested in the corresponding subtypes, but not the other subtypes." ;
