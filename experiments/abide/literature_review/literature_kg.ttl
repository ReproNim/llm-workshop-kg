        ex:EvidenceQuote ;
    prov:value "We selected only ASD participants from the ABIDE database since diagnostic scores were  not available for controls. We selected the same 5 datasets used in (1), that is sites with  codes: 'CALTECH' (n=19), 'CMU' (n=14), 'PITT' (n=30), 'UM_1' (n=55), 'UM_2' (n=13) for  a total of 131 ASD participants." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-5> ;
    prov:wasQuotedFrom <https://doi.org/10.1002/hbm.23084> ;
    ex:sourceLocator "corpus local_4a257bf0 full_text sha256:2ba35b7cc8fa94f3e3f065d8f3c6dc0643f0802d9827c839506afa7ff05f7a58 section:methods (whitespace/ligature-normalised match)" ;
