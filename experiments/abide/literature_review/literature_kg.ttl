    ex:sourceQuoteVerified true ;
    ex:supportsClaim "Motion QC excluded scans with mean FD>1mm or motion >2.0mm/1.0 degree." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-009/4> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "to calculate fALFF [34], the sum of the spectral amplitude values in the 0.01–0.08 Hz low-frequency power range was divided by the sum of the amplitudes over the entire detectable power spectrum (range: 0–0.25 Hz)." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-7> ;
    prov:wasQuotedFrom <https://doi.org/10.1186/s13229-020-00397-4> ;
    ex:sourceLocator "corpus local_d46bcf61 full_text sha256:0c5c88b70f78f6a17a2579a0a17ee756279702d2d5e51af200efddef7ea9c2b8 section:methods (whitespace/ligature-normalised match)" ;
    ex:sourceQuoteVerified true ;
    ex:supportsClaim "fALFF computed as ratio of low-frequency (0.01-0.08Hz) spectral power to total power (0-0.25Hz)." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-009/5> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "the preprocessed multimodal MRI features were jointly analyzed by a fusion-with-reference model called “MCCAR + jICA”" ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-7> ;
    prov:wasQuotedFrom <https://doi.org/10.1186/s13229-020-00397-4> ;
