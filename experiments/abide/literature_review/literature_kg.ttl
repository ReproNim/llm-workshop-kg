    ex:sourceQuoteVerified true ;
    ex:supportsClaim "In the ABIDE validation analysis, right thalamus connectivity with right precentral (p=0.019) and postcentral gyri (p=0.028) was greater in ASD than TD, replicating the primary-cohort finding." ;
