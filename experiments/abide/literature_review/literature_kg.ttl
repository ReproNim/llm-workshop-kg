<urn:repronim:abide:litreview/quote/S-010/4> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "The IMPAC fMRI and sMRI were processed using the fconn1000 ­pipeline41. For the fMRI connectivity features, the TSE connectivity metric was fit on either the training data alone (IMPAC models) or the entire IMPAC dataset (ABIDE 1 and 2 datasets), and the TSE values per-ROI timeseries for the ABIDE dataset were calculated." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-3> ;
    prov:wasQuotedFrom <https://doi.org/10.1038/s41598-022-06459-2> ;
    ex:sourceLocator "corpus local_afcc5b8c full_text sha256:0fe8a35dd30a8f98e84dd5920ece680dca1a6d613a4339e941bab654c7788860 section:methods (whitespace/ligature-normalised match)" ;
    ex:sourceQuoteVerified true ;
    ex:supportsClaim "Processing pipeline (fconn1000) and feature-embedding (TSE) procedure for IMPAC and ABIDE connectivity features." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-010/5> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "The features were standard scaled by the mean and standard deviation of the IMPAC dataset." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-3> ;
    prov:wasQuotedFrom <https://doi.org/10.1038/s41598-022-06459-2> ;
