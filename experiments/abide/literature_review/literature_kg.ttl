<urn:repronim:abide:litreview/quote/S-033/1> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "In this study, we used the fMRI data of 816 individuals enrolled in the Autism Brain Imaging Data Exchange (ABIDE) to introduce a new biomarker extraction pipeline for ASD that relies on the use of graph theoretical metrics of fMRI-based functional connectivity to inform a support vector machine (SVM)." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-3> ;
    prov:wasQuotedFrom <https://doi.org/10.3389/fnins.2018.01018> ;
