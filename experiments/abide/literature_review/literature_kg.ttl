<urn:repronim:abide:litreview/quote/S-005/6> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "the ASD group showed a higher mean value (Cohen’s d = .18, p = .007) and a lower standard deviation (Cohen’s d = -.19, p = .004) in whole-brain modular variability than the HC group" ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-7> ;
    prov:wasQuotedFrom <https://doi.org/10.1016/j.biopsych.2021.12.004> ;
    ex:sourceLocator "corpus local_904dfa27 full_text sha256:bfa15d701c5e62f8e81529aa87dc874e417592843776db72409c4e495e703d83 section:results (whitespace/ligature-normalised match)" ;
    ex:sourceQuoteVerified true ;
    ex:supportsClaim "ASD showed higher mean and lower SD of whole-brain modular variability than HC (Cohen's d=.18 and -.19)." ;
