    ex:sourceQuoteVerified true ;
    ex:supportsClaim "Main finding: ASD shows widespread connectivity-distance reductions, implying relatively reduced long-range and increased short-range connectivity." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-080/3> a prov:Entity,
        ex:EvidenceQuote ;
