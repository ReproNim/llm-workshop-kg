    ex:sourceQuoteVerified true ;
    ex:supportsClaim "The study used fMRI data of 816 ABIDE individuals, extracting graph-theoretical metrics of functional connectivity to inform an SVM classifier." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-033/2> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "Our methodology achieved better results than most state-of-the-art investigations on this dataset with the best model for the >30 years age group achieving an accuracy, sensitivity, and speciﬁcity of 95, 97, and 95%, respectively." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-3> ;
    prov:wasQuotedFrom <https://doi.org/10.3389/fnins.2018.01018> ;
