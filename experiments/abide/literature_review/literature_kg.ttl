<urn:repronim:abide:litreview/quote/S-036/3> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "in this work, ﬁrstly, we design an image genera- tor to generate single volume brain images from the whole-brain image of each subject." ;
