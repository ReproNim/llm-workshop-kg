<urn:repronim:abide:litreview/quote/S-099/1> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "The original ABIDE dataset claimed to have 1112 subjects consisting of 539 ASD and 573 Healthy controls subjects. However, after removing subjects with missing information we have a total of 1035 subjects which is" ;
