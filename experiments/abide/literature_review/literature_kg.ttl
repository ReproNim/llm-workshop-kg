    ex:sourceQuoteVerified true ;
    ex:supportsClaim "Subtype-specific brain patterns predict only the corresponding subtype's symptoms, not other subtypes." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-009/9> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "models can be generalized to predict ADOS and SRS scores for the corresponding subgroup from ABIDE I, but not for the other groups" ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-7> ;
    prov:wasQuotedFrom <https://doi.org/10.1186/s13229-020-00397-4> ;
