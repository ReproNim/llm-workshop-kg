<urn:repronim:abide:litreview/quote/S-074/3> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "METAFormer employs a multi-atlas approach, where flattened connectivity matrices from the AAL, CC200, and DOS160 atlases serve as input to the transformer encoder." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-2> ;
    prov:wasQuotedFrom <https://doi.org/10.1007/978-3-031-44858-4_12> ;
