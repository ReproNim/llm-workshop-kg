<urn:repronim:abide:litreview/quote/S-036/2> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "Selected strategies are Connectome Computation System (CCS), Conﬁgurable Pipeline for the Analysis of Con- nectomes (CPAC), Data Processing Assistant for Resting-State fMRI (DPARSF) and Neuroimaging Analysis Kit (NIAK)." ;
