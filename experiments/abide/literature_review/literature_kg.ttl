    ex:sourceQuoteVerified true ;
    ex:supportsClaim "With a fixed number of epochs, elastic deformation augmentation gave the largest improvement (2.2 percentage points)." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-063/7> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "Our conclusion is that augmentation only provides mi- nor improvements when training 3D CNNs for classiﬁcation of ASD versus controls" ;
