    ex:sourceQuoteVerified true ;
    ex:supportsClaim "Best augmentation (random scaling, early stopping) improved test accuracy by only 0.6 percentage points over no augmentation." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-063/6> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "elastic deformations seem to work best, with an improvement of 2.2 percentage units." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-7> ;
    prov:wasQuotedFrom <https://doi.org/10.3390/diagnostics13172773> ;
