    ex:sourceQuoteVerified true ;
    ex:supportsClaim "Site effects across ABIDE I and II data collections were removed using the ComBat harmonisation function." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-008/6> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value """Discovery analyses in ABIDE revealed significant main effects of diagnosis and sex across the intrinsic func‑
