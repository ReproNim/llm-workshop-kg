    ex:sourceQuoteVerified true ;
    ex:supportsClaim "Subjects with a consistently zero time-series were excluded from the dataset." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-033/5> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "All Sites 109 342 190 137 51 816 Number of participants from each site for each age group as well as the overall number of participants in a site that were used for this study. Last row shows the total number of subjects in each age-range." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-3> ;
    prov:wasQuotedFrom <https://doi.org/10.3389/fnins.2018.01018> ;
