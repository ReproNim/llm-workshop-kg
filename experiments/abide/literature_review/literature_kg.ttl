    ex:sourceQuoteVerified true ;
    ex:supportsClaim "Leave-one-site-out analysis showed ASD covarying pattern consistent across sites." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-009/2> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "Subjects with ASD (n = 229) and the corresponding TDCs (n = 126) were selected from the ABIDE II [29, 30], which is hosted by the 1000 Functional Connectome Project/International Neuroimaging Data-sharing Ini- tiative (INDI) from multiple international sites (9 sites, Additional file 1: Table S1)." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-7> ;
    prov:wasQuotedFrom <https://doi.org/10.1186/s13229-020-00397-4> ;
