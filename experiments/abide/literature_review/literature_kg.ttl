<urn:repronim:abide:litreview/quote/S-019/4> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "We evaluate our model on both the ADNI and ABIDE databases using a 10-fold stratiﬁed cross validation strategy." ;
