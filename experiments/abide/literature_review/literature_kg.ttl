    ex:sourceQuoteVerified true ;
    ex:supportsClaim "ABIDE II discovery sample: 229 ASD, 126 TDC from 9 sites." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-009/3> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "we removed outlier datasets with mean FD exceeding 1 mm, as well as head motion exceeding 2.0 mm of maximal translation (in any direction of x, y or z) or 1.0° of maximal rotation through- out the course of scanning." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-7> ;
    prov:wasQuotedFrom <https://doi.org/10.1186/s13229-020-00397-4> ;
