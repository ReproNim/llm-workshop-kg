<urn:repronim:abide:litreview/quote/S-024/6> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "Table 1: k-nn classiﬁcation results with k = 3 using the proposed metric and Euclidean distance following PCA. Classiﬁcation all sites site 6 site 9 site 14 site 16 site 18 PCA/Euclidean 51.0% 59.3% 25.0% 30.0% 64.3% 50.0% GCN 62.9% 81.5% 62.5% 70.0% 50.0% 90.0%" ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-5> ;
