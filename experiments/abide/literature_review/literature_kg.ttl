    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-099/2> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value """We have used the ABIDE dataset that is pre-processed using Conﬁguration Pipeline for
