<urn:repronim:abide:litreview/quote/S-080/1> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "We studied 211 males from three sites of the ABIDE-I dataset comprising 103 participants with an ASD diagnosis (mean ± SD age = 20.8 ± 8.1 years) and 108 neurotypical controls (NT, 19.2 ± 7.2 years)." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-8> ;
    prov:wasQuotedFrom <https://doi.org/10.1186/s13229-024-00616-2> ;
