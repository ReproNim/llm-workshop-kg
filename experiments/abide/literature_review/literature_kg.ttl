<urn:repronim:abide:litreview/quote/S-022/7> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "we used a leave-site-out approach for our proposed CNN, SVM, KNN, and RF classiﬁers (Heinsfeld et al., 2018). In this method, each site is taken as one fold in the dataset, and we applied a cross-validation approach on the remaining sites instead of diﬀerent folds. Therefore, each time, one site out of 17 is used to test, and the other sites are used for training." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-3> ;
    prov:wasQuotedFrom <https://doi.org/10.3389/fnins.2019.01325> ;
    ex:sourceLocator "corpus local_b72b2fbd full_text sha256:bfaa6e13aaa55d2e974e294ef5cfbf1bfff7ec8ec8e0765a2f9581f730339361 section:methods (whitespace/ligature-normalised match)" ;
    ex:sourceQuoteVerified true ;
    ex:supportsClaim "Performance was also evaluated using a leave-site-out approach across the 17 ABIDE I sites." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-022/8> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "DATA AVAILABILITY STATEMENT The datasets generated for this study are available on request to the corresponding author." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-3> ;
    prov:wasQuotedFrom <https://doi.org/10.3389/fnins.2019.01325> ;
    ex:sourceLocator "corpus local_b72b2fbd full_text sha256:bfaa6e13aaa55d2e974e294ef5cfbf1bfff7ec8ec8e0765a2f9581f730339361 section:methods (whitespace/ligature-normalised match)" ;
    ex:sourceQuoteVerified true ;
    ex:supportsClaim "Data are available on request to the corresponding author, not openly released." ;
