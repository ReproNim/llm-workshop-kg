    ex:sourceQuoteVerified true ;
    ex:supportsClaim "ABIDE features were scaled using the IMPAC (training) dataset's mean/SD, not refit on ABIDE itself, limiting cross-dataset leakage." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-010/6> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "The top single model trained using IMPAC attained 80.4% AUROC on IMPAC held-out test data. When tested on ABIDE I, it achieved an AUROC of 86.0% (Table 2 underlined) and when tested on the ABIDE II it achieved a performance of 79.2%." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-3> ;
    prov:wasQuotedFrom <https://doi.org/10.1038/s41598-022-06459-2> ;
    ex:sourceLocator "corpus local_afcc5b8c full_text sha256:0fe8a35dd30a8f98e84dd5920ece680dca1a6d613a4339e941bab654c7788860 section:results (whitespace/ligature-normalised match)" ;
    ex:sourceQuoteVerified true ;
    ex:supportsClaim "The top IMPAC-trained model achieved 86.0% AUROC on ABIDE I and 79.2% AUROC on ABIDE II without adaptation." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-010/7> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "These tuned models achieved AUROC as high as 93.2% on ABIDE-I and 90.5% on ABIDE-II, roughly a 4–9 basis point increase in performance relative to models without any adaptation." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-3> ;
    prov:wasQuotedFrom <https://doi.org/10.1038/s41598-022-06459-2> ;
