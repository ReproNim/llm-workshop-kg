    ex:sourceQuoteVerified true ;
    ex:supportsClaim "ABIDE II ASD subtype groups (Asperger's n=79, PDD-NOS n=58, Autistic n=92) used as discovery cohort, ABIDE I (n=400) as replication." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-009/10> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "site-out analysis (details can be found in Additional file 1: “Reproducibility” section) in the ADOS-guided fALFF and GMV fusion on the whole ASD group to check whether the site effect will contribute to current ASD pattern." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-7> ;
    prov:wasQuotedFrom <https://doi.org/10.1186/s13229-020-00397-4> ;
