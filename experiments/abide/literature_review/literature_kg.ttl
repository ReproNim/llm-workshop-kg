    ex:sourceQuoteVerified true ;
    ex:supportsClaim "ASD diagnosis across collections was based on clinical judgment plus ADOS/ADI-R, or ADOS/ADI-R alone, varying by collection." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-001/4> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value """we used the Preprocessed Connectome Project quality assurance protocol49
(http://preprocessed-connectomes-project.github.io)""" ;
