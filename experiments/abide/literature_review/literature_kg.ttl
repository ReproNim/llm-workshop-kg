<urn:repronim:abide:litreview/quote/S-009/1> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "DSM-IV-TR diagnosed Asperger’s disorder (n = 79), pervasive developmental disorder-not otherwise specified [PDD-NOS] (n = 58) and Autistic disorder (n = 92) from ABIDE II were used as discovery cohort, and ABIDE I (n = 400) was used for replication." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-7> ;
    prov:wasQuotedFrom <https://doi.org/10.1186/s13229-020-00397-4> ;
