    ex:sourceQuoteVerified true ;
    ex:supportsClaim "Cohort was the commonly-used 871-subject ABIDE I subset (403 ASD, 468 HC) meeting imaging-quality and phenotypic-completeness criteria." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-076/2> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value """Data preprocessing was performed using the configurable pipeline for the analysis of con- 
