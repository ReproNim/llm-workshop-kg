    ex:sourceQuoteVerified true ;
    ex:supportsClaim "Fusion of fALFF and GM voxel maps used MCCAR+jICA, guided by ADOS scores." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-009/6> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "Dorsolateral prefrontal cortex and superior/middle temporal cortex are the primary common functional– structural covarying cortical brain areas shared among Asperger’s, PDD-NOS and Autistic subgroups." ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-7> ;
    prov:wasQuotedFrom <https://doi.org/10.1186/s13229-020-00397-4> ;
