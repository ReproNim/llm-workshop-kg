    ex:sourceQuoteVerified true ;
    ex:supportsClaim "Leave-one-site-out SVM classification reached mean AUC 0.75 ± 0.05, best fold AUC 0.83." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-062/6> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value """Specifically, stronger functional connectivity (FC) in ASD with respect to TD 
involve (p < 0.001) the angular gyrus with the precuneus in the right (R) hemisphere, and the 
R frontal operculum cortex with the pars opercularis of the left (L) inferior frontal gyrus.""" ;
    prov:wasGeneratedBy <urn:repronim:abide:litreview/activity/charting-batch-6> ;
    prov:wasQuotedFrom <https://doi.org/10.3389/fpsyt.2019.00620> ;
    ex:sourceLocator "corpus local_81234492 full_text sha256:876abfb3d6edabfd02482ac0d3b483ea255089176d78d640d4617286e686e87e section:abstract char:3396" ;
    ex:sourceQuoteVerified true ;
    ex:supportsClaim "ASD showed hyper-connectivity between right angular gyrus-precuneus (DMN) and right frontal operculum-left IFG pars opercularis." ;
    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-062/7> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value """implementation of the HO atlas. The binary classification 
