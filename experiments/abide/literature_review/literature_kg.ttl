    ex:verifiedBy <urn:repronim:abide:litreview/activity/phase3-merge> .

<urn:repronim:abide:litreview/quote/S-080/2> a prov:Entity,
        ex:EvidenceQuote ;
    prov:value "Compared to NT, ASD participants presented with widespread reductions in CD, generally indicating shorter average connection length and thus suggesting reduced long-range connectivity but increased short-range connections." ;
