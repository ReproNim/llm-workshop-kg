        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1256 ;
            slr:answer_text "fconn1000 pipeline (same as used for the IMPAC challenge); seven functional atlases (BASC at 64/122/197 ROIs, Craddock 249-ROI atlas, and others) plus FreeSurfer structural features. | quote: \"The IMPAC fMRI and sMRI were processed using the fconn1000 ­pipeline41. For the fMRI connectivity features, the TSE connectivity metric was fit on either the training data alone (IMPAC models) or the entire IMPAC dataset (ABIDE 1 and 2 datasets), and the TSE values per-ROI timeseries for the ABIDE dataset were calculated.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-010" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1250 ;
            slr:answer_text """CPAC pipeline via the Preprocessed Connectomes Project; Harvard-Oxford atlas (111 ROIs), distance-correlation connectivity. | quote: "Data preprocessing was performed using the configurable pipeline for the analysis of con- 
