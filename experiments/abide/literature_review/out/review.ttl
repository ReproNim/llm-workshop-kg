            slr:relevance_score "0.7"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """ASD classiﬁcation was determined by either 1) combining clinical judgment with ‘gold standard’
