        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1176 ;
            slr:answer_text "Partly | quote: \"The output with the six motion parameters (3 translations in x, y, z directions,  and 3 rotations: pitch (about x-axis), roll (about y-axis), and yaw (about z-axis)) is recor\"" ;
