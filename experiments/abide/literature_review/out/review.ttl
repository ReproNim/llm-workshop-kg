        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1207 ;
            slr:answer_text "No — single-site (KKI) study; no multi-site harmonisation or leave-site-out evaluation needed or reported." ;
