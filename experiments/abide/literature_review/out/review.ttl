        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1201 ;
            slr:answer_text "Partly — the offline SSAE pretraining pool is explicitly restricted to non-target sites (avoiding target-site leakage into pretraining), and CV is stratified by diagnosis, but the text does not state whether the site/age/gender/handedness regression itself was refit within each CV fold. | quote: \"the independent healthy FC data from the remaining 16 sites from the ABIDE repository were accumulated as pre- collected data to train an SSAE prototype during oﬄine learning. Then, we randomly split the data from the target site into training and testing set. The data from the training set were applied on an SSAE prototype in the prior knowledge aided training step. The hold-out testing data were then used to evaluate the trained DTL-NN model.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl5-leakage-control-reported-feature-selection-scaling-harmo> ;
            slr:source_id "S-025" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1199 ;
