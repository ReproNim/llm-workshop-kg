        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1172 ;
            slr:answer_text "GRETNA pipeline; 512-region random parcellation for dynamic connectome nodes | quote: \"All rsfMRI data were preprocessed with a standardized and harmonized pipeline using the GRETNA package (36).\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
