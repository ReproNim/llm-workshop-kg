            oa:hasBody [ a dcterms:Text ;
                    rdf:value "After testing our model for ASD classiﬁcation, we have achieved the highest accuracy of 94.7%, the precision of 94.5%, recall of 92.5%, f1-score of 95%, and the AUC score 94.703%." ] ;
