        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1250 ;
            slr:answer_text """Yes — CPAC named via the Preprocessed Connectomes Project. | quote: "Data preprocessing was performed using the configurable pipeline for the analysis of con- 
nectomes.\"""" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl3-preprocessing-pipeline-and-version-reported> ;
