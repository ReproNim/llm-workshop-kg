        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1262 ;
            slr:answer_text "Partly — a detailed custom FSL-based pipeline is described (tools named with citations) but not presented as a single named/versioned pipeline (e.g. C-PAC)." ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl3-preprocessing-pipeline-and-version-reported> ;
