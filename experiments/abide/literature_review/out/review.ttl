        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1220 ;
            slr:answer_text "No named preprocessing pipeline (e.g. CPAC/DPARSF); connectivity derived using the BASC atlas (scale 122 via MSTEPS) and Pearson correlation. | quote: \"we used multiscale functional brain parcels. Brain parcels were created using a method known as the bootstrap analysis of stable clusters called BASC [32].\"" ;
