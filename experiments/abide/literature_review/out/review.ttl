            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1167 ;
            slr:answer_text "C-PAC pipeline (Preprocessed Connectomes Project) with CC200 functional parcellation | quote: \"We used the preprocessed data using the Conﬁgurable Pipeline for the Analysis of Connectomes C-PAC pipeline (Craddock et al., 2013)\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
