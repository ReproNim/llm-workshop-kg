        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "we downloaded Re- gions of Interests (ROIs) fMRI series of the top four largest sites (UM1, NYU, USM, UCLA1) from the preprocessed ABIDE dataset with Conﬁgurable Pipeline for the Analysis of Connec- tomes (CPAC), band-pass ﬁltering (0.01 - 0.1 Hz), no global signal regression, parcellated by Harvard-Oxford (HO) atlas." ] ;
            oa:hasTarget <https://doi.org/10.1016/j.media.2020.101765> ;
