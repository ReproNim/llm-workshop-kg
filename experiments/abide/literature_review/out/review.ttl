        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1262 ;
            slr:answer_text "No — sites pooled with a per-site minimum-N inclusion rule but no explicit site covariate, harmonisation, or leave-site-out evaluation." ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl6-site-handling-reported-site-covariate-harmonisation-e-g> ;
            slr:source_id "S-094" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1222 ;
            slr:answer_text "Yes — an explicit leave-site-out cross-validation was run across the five largest ABIDE sites in addition to pooled five-fold CV. | quote: \"For the leave-site-out CV procedure, we selected ﬁve sites with the highest number of total subjects (ASD/total), namely New York University (NYU) (90/159), Kennedy Krieger Institute - 1 (KKI-I) (88/114), University of Miami - 1 (UM-I) (50/96), University of California, Los Angeles (UCLA)-I (28/69), Oregon Health & Science University (OHSU)-I (42/64).\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl6-site-handling-reported-site-covariate-harmonisation-e-g> ;
