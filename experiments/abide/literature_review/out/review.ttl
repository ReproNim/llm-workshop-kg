                            slr:justification "quote: \"We used the resulting 11 region atlas to assign a region label\"" ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
