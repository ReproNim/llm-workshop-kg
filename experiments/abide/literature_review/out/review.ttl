            slr:answer_text "Partly | quote: \"A ﬁnal dataset of 871 subjects, including 403 ASD patients and 468 TCs, was obtained by removing the samples with incomplete brain coverage, high motion peaks, ghosting and other scanner artifacts.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl2-motion-qc-rule-reported-metric-and-threshold-e-g-mean-fd> ;
