        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1196 ;
            slr:answer_text """Yes | quote: "The corresponding data subset consists of a total of 452 subjects, with respec-
tively 251 NT and 201 ASD subjects.\"""" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl1-cohort-definition-reported-inclusion-exclusion-rules-and> ;
