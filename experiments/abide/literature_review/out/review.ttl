        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1236 ;
            slr:answer_text "3D-CNN atlas-ensemble reached 73.3% CV accuracy (ABIDE-I) and 71.7% independent test accuracy (ABIDE-II), AUC 75.8%, outperforming linear/DNN baselines and a prior ABIDE-I benchmark of up to 67%; saliency maps highlighted the default mode network as discriminative. | quote: \"Previous studies have reported cross- validated classiﬁcation accuracies up to 67% on ABIDE-I, the ﬁrst phase of the ABIDE study [1]. The proposed CNN approach improves this accuracy to above 73%.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ5> ;
            slr:question_id "RQ5" ;
