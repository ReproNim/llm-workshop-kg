        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1165 ;
            slr:answer_text "Main effects of diagnosis and sex across PCC-iFC, ReHo and VMHC converging on the default-network midline; sex-by-diagnosis interaction confined to VMHC in dorsolateral occipital cortex, with reduced VMHC in autistic females, replicated in EU-AIMS LEAP but not GENDAAR | quote: \"Sex-by-diagnosis interactions were confined to the dorsolateral occipital cortex, with reduced VMHC in females with autism.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ5> ;
            slr:question_id "RQ5" ;
            slr:source_id "S-008" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1204 ;
            slr:answer_text "Joint structural+functional fusion achieved AUC 0.78±0.04, exceeding structural-only (0.66±0.05) and functional-only (0.76±0.04) models; top features in Default Mode Network and Social Brain regions | quote: \"The AUC values of 0.66±0.05 and of 0.76±0.04 were obtained in the ASD vs. TD discrimination when only structural or functional features are considered, respectively. The joint fusion approach led to an AUC of 0.78±0.04.\"" ;
