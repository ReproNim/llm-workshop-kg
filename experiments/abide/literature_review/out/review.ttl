        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1164 ;
            slr:answer_text "CPAC pipeline (Preprocessed Connectomes Project); Harvard-Oxford atlas (110 ROIs) as the primary parcellation, with AAL atlas tested for comparison. | quote: \"We use the Harvard Oxford (HO) atlas [23], so we  have N = 110 nodes.\"" ;
