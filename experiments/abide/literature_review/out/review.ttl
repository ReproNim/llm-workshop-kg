        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1225 ;
            slr:answer_text "Whole-brain ReHo classifier achieved ~62% accuracy with no dimensionality reduction or feature selection. | quote: \"The accuracy of our model without any dimensionality reduction or feature selection was ~ 62%.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ5> ;
            slr:question_id "RQ5" ;
            slr:source_id "S-081" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1176 ;
            slr:answer_text "Excess noise and randomness in head micro-movements in ASD vs. controls, exacerbated by comorbidity, lower IQ, and autism severity, independent of medication status. | quote: \"We  find excess noise and randomness in the ASD cases, suggesting an uncertain motor-feedback signal.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ5> ;
