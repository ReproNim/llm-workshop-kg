            slr:relevance_score "1.0"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """We balance the data per site, meaning that we take the same 
number of ASD subjects as TD subjects per site. Furthermore, 
we ensure that the 2 resulting classes (TD and ASD) with 77 
subjects each are similar on average with respect to IQ, age, and 
head movements. This prevents the classifier from separating""" ] ;
            oa:hasTarget <https://doi.org/10.3389/fpsyt.2016.00177> ;
            slr:claim_label "Data were balanced per site (equal ASD/TD counts) and matched on IQ, age and head movement." ;
            slr:relevance_score "0.85"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
