<urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ1> a slr:ResearchQuestion ;
    dcterms:title "Release, subset and QC rule" ;
    slr:has_answer [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1196 ;
            slr:answer_text """predictive | ABIDE I, primary sample of 452 adolescents (201 ASD, 251 NT) from 17 sites, selected via eyes-open, age<18, mean-FD<0.2mm inclusion criteria; secondary adult generalization subsample of 130 (63 ASD, 67 NT). | quote: "The corresponding data subset consists of a total of 452 subjects, with respec-
tively 251 NT and 201 ASD subjects.\"""" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ1> ;
            slr:question_id "RQ1" ;
            slr:source_id "S-055" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1227 ;
            slr:answer_text "ABIDE, restricted to the four sites with repetition time 2s (NYU, SDSU, UM, USM): 147 ASD and 146 healthy controls; no further exclusion rule described. | quote: \"We limited ourselves to acquisitions with repetition time of 2s (sites NYU, SDSU, UM, USM). This resulted in a dataset of 147 subjects with ASD and 146 healthy controls.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ1> ;
            slr:question_id "RQ1" ;
            slr:source_id "S-072" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1240 ;
            slr:answer_text "associational — discovery: ABIDE I post-QC N=708 (432 TD, 276 ASD); validation: ABIDE II post-QC N=585 (316 TD, 269 ASD, 11 sites); QC rule: >5% of scans removed by motion scrubbing excludes a subject | quote: \"After preprocessing (described in section 2.2.), the ABIDE I dataset was composed of 432 subjects with TD (348 males, mean age ± standard deviation of 18.21 ± 8.04) and 276 individuals with ASD (241 males, 18.42 ± 8.38). The ABIDE II dataset was composed of 316 subjects with TD (208 males, 12.80 ± 5.61) and 269 individuals with ASD (234 males, 13.93 ± 7.07).\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ1> ;
            slr:question_id "RQ1" ;
            slr:source_id "S-012" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1176 ;
            slr:answer_text "associational | ABIDE I, 605 participants (304 ASD, 301 typical controls) from 7 of 16 ABIDE sites (UM_1, UM_2, USM, NYU, UCLA_1, OLIN, PITT) meeting raw-scan, scan-duration and minimum-N inclusion criteria. | quote: \"Datasets from a total of 605 participants were analyzed, including 304 individuals with Autism Spectrum  Disorder (ASD) and 301 typically developing controls (CT).\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ1> ;
            slr:question_id "RQ1" ;
            slr:source_id "S-047" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1180 ;
            slr:answer_text "predictive | Same 871-subject ABIDE I cohort (403 ASD, 468 controls) from 20 sites as used by Abraham et al. 2017. | quote: \"It includes N = 871 subjects from diﬀerent imaging sites that met the imaging quality and phenotypic information criteria, consisting of 403 individuals suﬀering from ASD and 468 healthy con- trols.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ1> ;
            slr:question_id "RQ1" ;
            slr:source_id "S-024" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1183 ;
            slr:answer_text """predictive | ABIDE-I, restricted to the single NYU site (79 ASD/105 NC) out of the full ABIDE-I 539 ASD/573 TC across 17 sites, specifically to avoid cross-site scan-parameter heterogeneity; no further exclusion rule stated beyond site restriction | quote: "To avoid the impact of data heterogeneity,
we collected raw rs-fMRI data from the whole NYU site,
consisting of 79 ASD subjects and 105 normal controls (NCs).\"""" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ1> ;
            slr:question_id "RQ1" ;
            slr:source_id "S-060" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1236 ;
            slr:answer_text "predictive — ABIDE-I (1112 total; analysed 774: 379 ASD/395 TD, 17 sites, manual QA by all functional raters) used for training/10-fold CV; ABIDE-II (analysed 393: 163 ASD/230 TD, from sites overlapping ABIDE-I) used as independent held-out test after automatic motion-scrubbing QC. | quote: \"In our experiments, we used ABIDE-I subject data that passed manual qual- ity assessments (QA) by all the functional raters. This yielded a ﬁnal sample size of 774 ABIDE-I subjects, comprising 379 subjects with ASD and 395 typical con- trols.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ1> ;
            slr:question_id "RQ1" ;
            slr:source_id "S-006" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1248 ;
            slr:answer_text "ABIDE-I, all 17 sites; starting N=1112 (539 ASD/573 controls); after removing subjects with missing information, final N=1035 (505 ASD/530 controls); per-site breakdown given in Table 1. | quote: \"The original ABIDE dataset claimed to have 1112 subjects consisting of 539 ASD and 573 Healthy controls subjects. However, after removing subjects with missing information we have a total of 1035 subjects which is\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ1> ;
            slr:question_id "RQ1" ;
            slr:source_id "S-099" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1225 ;
            slr:answer_text "ABIDE I (full preprocessed release): 539 ASD, 573 controls; no QC/exclusion rule described in this report. | quote: \"The ABIDE dataset contains 539 individuals with ASD and 573 control subjects.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ1> ;
            slr:question_id "RQ1" ;
            slr:source_id "S-081" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1174 ;
            slr:answer_text "predictive — ABIDE (release not specified as I vs II in extracted text, but cites ABIDE/Nielsen 2013 ABIDE results), N=154 (77 ASD, 77 TD), balanced per site and matched on IQ/age/head-movement; subjects with strong motion artifacts excluded | quote: \"The inputs to the classification pipeline are the 77 ASD and 77 TD connectivity matrices (hence 154 data samples in total), where each connectivity matrix consists of 19,900 features.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ1> ;
            slr:question_id "RQ1" ;
            slr:source_id "S-029" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1257 ;
            slr:answer_text "ABIDE I: 1111 scans from 17 sites (573 HC, 538 ASD); split into 800 (70%) training and 311 (30%) hold-out test subjects, preserving the overall case:control ratio (0.5157) in both sets. | quote: \"The ABIDE dataset consists of 1111 scans, taken from 17 sites consisting of 573 healthy controls and 538 patients with autism. To evaluate each learning model, we use 800 subjects (70%) for model training and 311 subjects (30%) for hold-out testing. We use the same case/control ratio (0.5157) for both training and test set.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ1> ;
            slr:question_id "RQ1" ;
            slr:source_id "S-023" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1195 ;
            slr:answer_text "associational — ABIDE I, N=975 (458 ASD, 517 TDC) after excluding sites/datasets for missing FIQ (Groningen), poor cerebellar coverage (Carnegie Mellon), and low IQ (<70, 5 datasets) from the original 1112 | quote: \"We excluded datasets from the social brain Lab BCN NIC UMC Groningen and Netherlands Institute for Neurosciences due to the missing information of a full-scale intelligence quotient (IQ) for many subjects. After preprocessing, we found that a large part of the cerebellum was missing in the imaging dataset of Carnegie Mellon University, and all datasets from Carnegie Mellon University were excluded. To control for potential confounding eﬀects of IQ in our analysis, we decided to exclude ﬁve datasets that included some subjects with IQ lower than 70. Finally, we performed voxel-wise group comparisons with 975 imaging datasets.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ1> ;
            slr:question_id "RQ1" ;
            slr:source_id "S-041" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1175 ;
            slr:answer_text "ABIDE I: 1,112 individuals (539 ASD/573 TD, 17 sites), sites required >=20 subjects passing successful preprocessing/normalisation QC; after CPAC preprocessing the sample was reduced to 871 subjects (a separate statement reports 505 ASD/530 typical controls as the dataset used). | quote: \"There are 1,112 subjects (539 diagnosed with ASD, and 573 typical controls) in the ABIDE I dataset, reduced to 871 subjects after preprocessing.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ1> ;
            slr:question_id "RQ1" ;
            slr:source_id "S-022" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1187 ;
            slr:answer_text "predictive | ABIDE I, 964 of 1112 participants (447 autism, 517 TD) from 16 sites after preprocessing-success inclusion criteria. | quote: \"A total of 964 subjects met all inclusion criteria (517 typically developing subjects and 447 subjects with autism from 16 sites).\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ1> ;
            slr:question_id "RQ1" ;
            slr:source_id "S-021" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1201 ;
            slr:answer_text "ABIDE I — four target sites with >=60 subjects each (UM: 48 ASD/65 healthy; UCLA: 36/39; USM: 38/23; LEUVEN: 27/34), with offline SSAE pretraining drawn from healthy subjects pooled across the remaining 16 ABIDE sites. | quote: \"we performed ASD classiﬁcation experiments on four individual data sites with at least 60 subjects, including University of Michigan (UM), University of California, Los Angeles (UCLA), University of Utah School of Medicine (USM), and Katholieke Universiteit Leuven (LEUVEN).\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ1> ;
