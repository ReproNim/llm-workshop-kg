        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1241 ;
            slr:answer_text "Best accuracy 70.4%, AUC 0.75 using a phenotypic (sex+site) population graph with K=4. | quote: \"The best average performance is achieved for K = 4 with accuracy 70.4% and AUC 0.75.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ5> ;
