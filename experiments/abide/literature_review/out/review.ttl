                            slr:justification "Code on GitHub; no individual participant list published. | quote: \"Custom R code and data to support the data correction, correlation analysis, visualizations, functional, and gene set enrichments are available at https://github.com/konopkalab/\"" ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "CL6 Site handling reported?" ;
                            slr:justification "Explicit site-mean correction across 30 sites plus site regressed out as a covariate. | quote: \"We accessed publicly available ABIDE data across 30 different sites.\"" ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ] ;
