        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1213 ;
            slr:answer_text "Yes — site included as a one-hot-encoded covariate in the ABIDE GLM analysis | quote: \"To account for potential con- founding effects from differences in scan acquisition parameters, we included site as a covariate in our ABIDE GLM analysis as one-hot encoded variables.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl6-site-handling-reported-site-covariate-harmonisation-e-g> ;
