            oa:hasTarget <https://doi.org/10.3389/fams.2018.00025> ;
            slr:claim_label "No site-specific/leave-site-out analysis was possible for ASD because only one site had enough samples per group." ;
            slr:relevance_score "0.7"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """the results show that our model outperforms all the base-
