        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1179 ;
            slr:answer_text "72.46% accuracy, 74.35% sensitivity, 79.25% specificity, AUC 0.79, outperforming CNN-MLP, DiagNet, HI-GCN and GAT | quote: \"the AUC value of the proposed algorithm is 0.79, which is 5.42% higher compared to GAT.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ5> ;
