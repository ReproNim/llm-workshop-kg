        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1219 ;
            slr:answer_text """uses-data | quote: "Validation on two datasets, ADNI and ABIDE, demonstrates that DGCL surpasses traditional methods and other deep
