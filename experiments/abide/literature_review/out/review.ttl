        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1230 ;
            slr:answer_text "Yes | quote: \"We considered the following predeﬁned atlases: Har- vard Oxford [40]\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
            slr:source_id "S-002" ],
        [ a slr:ChartingQuestionAnswer ;
