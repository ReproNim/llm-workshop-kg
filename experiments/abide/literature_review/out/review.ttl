        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1253 ;
            slr:answer_text "FSL/AFNI preprocessing (deobliquing, motion correction via MCFLIRT, skull-stripping, 6mm FWHM smoothing); Shen 268-node functional atlas for connectivity ROIs. | quote: \"A functionally defined atlas, consisting of 268 cortical and subcortical regions-of-interest (‘nodes’)\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
