        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1175 ;
            slr:answer_text "Partly — CPAC via the Preprocessed Connectomes Project is named with preprocessing steps, but no pipeline version number is given. | quote: \"The Preprocessed Connectomes Project (PCP) is a publicly available preprocessed version of data from both the 1,000 Functional Connectomes Project (FCP) and the International Neuroimaging Data-Sharing Initiative (INDI)3. We used data from the FCP using the conﬁgurable pipeline, the Analysis of Connectomes (CPAC).\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl3-preprocessing-pipeline-and-version-reported> ;
            slr:source_id "S-022" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1238 ;
            slr:answer_text "Yes | quote: \"For a fair comparison, all data are preprocessed using the Conﬁgurable Pipeline for the Analysis of Connectomes (C-PAC) based on the preprocessed fMRI datasets [22].\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl3-preprocessing-pipeline-and-version-reported> ;
