        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1246 ;
            slr:answer_text """partly — N by diagnosis and the source release (ABIDE-I, 17 sites) are given and code is public, but no participant-ID list or exact numeric exclusion rule for the 848-subject subset is published. | quote: "The code is available
at https://github.com/LYQbyte/ASD-HNet.\"""" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ6> ;
            slr:question_id "RQ6" ;
            slr:source_id "S-090" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1204 ;
            slr:answer_text "yes — participant list — participant IDs of the final analysed sample are published in supplementary material | quote: \"To allow the reproducibility of the analysis, the identification numbers (IDs) of the participants selected in the final sample are reported in Additional file 1.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ6> ;
            slr:question_id "RQ6" ;
            slr:source_id "S-016" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1259 ;
            slr:answer_text "partly — exact N, pipeline, atlases and analysis code (GitHub) are reported, but the paper does not explain why 406/476 (rather than the full 539/573 ASD/TC release) were used, so the exact exclusion rule is not stated. | quote: \"The code for our framework is available at github.com/Lugges991/METAFormer\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ6> ;
            slr:question_id "RQ6" ;
            slr:source_id "S-074" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1180 ;
            slr:answer_text "partly — cohort is the published 871-subject ABIDE subset (403/468) with source code released, but no independent participant-ID list in this paper. | quote: \"source code available at https://github.com/sk1712/gcn_metric_learning\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ6> ;
            slr:question_id "RQ6" ;
            slr:source_id "S-024" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1262 ;
            slr:answer_text "partly — explicit inclusion/exclusion and motion-scrubbing rules are given, but no participant ID list or code repository link is found in the text." ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ6> ;
            slr:question_id "RQ6" ;
            slr:source_id "S-094" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1224 ;
            slr:answer_text """partly — the exact preprocessing variant (filter_noglobal) and the no-screening rule are stated, but no participant-ID list or ASD/TD breakdown is given. | quote: "We conduct experiments on all ABIDE I data (without any data screening), and obtain the mean 73.1%/73.4% accu-
racy on AAL/CC200 atlas\"""" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ6> ;
            slr:question_id "RQ6" ;
            slr:source_id "S-071" ] ;
    slr:question_id "RQ6" ;
    slr:question_text "Can the analysed cohort be reconstructed from released files (participant list or exact rules published)?" ;
    slr:theme "Reproducibility" .

<urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl1-cohort-definition-reported-inclusion-exclusion-rules-and> a slr:ResearchQuestion ;
