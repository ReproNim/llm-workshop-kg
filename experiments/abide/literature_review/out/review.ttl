        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "The Preprocessed Connectomes Project (PCP) is a publicly available preprocessed version of data from both the 1,000 Functional Connectomes Project (FCP) and the International Neuroimaging Data-Sharing Initiative (INDI)3. We used data from the FCP using the conﬁgurable pipeline, the Analysis of Connectomes (CPAC)." ] ;
            oa:hasTarget <https://doi.org/10.3389/fnins.2019.01325> ;
            slr:claim_label "Data were preprocessed via the Preprocessed Connectomes Project using CPAC." ;
            slr:relevance_score "0.85"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "As high as 60% accuracy was obtained for whole brain classiﬁcation, with the best accuracy from connections involving regions of the default mode network, parahippocampaland fusiform gyri, insula, Wernicke Area, and intraparietal sulcus." ] ;
            oa:hasTarget <https://doi.org/10.3389/fnhum.2013.00599> ;
            slr:claim_label "Best whole-brain classification accuracy was 60%, driven by default-mode, parahippocampal/fusiform, insula, Wernicke and intraparietal-sulcus connections." ;
            slr:relevance_score "1.0"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """A total of 10-fold cross validation strategy was used for evaluating classiﬁcation
performance.""" ] ;
            oa:hasTarget <https://doi.org/10.3389/fnhum.2021.687288> ;
            slr:claim_label "Classification performance was evaluated with 10-fold cross-validation." ;
            slr:relevance_score "0.6"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "We found that models trained using only site information achieved an accuracy of 66.0% on the ADHD data and 55.0% on the ABIDE data, while our models trained on MRI data achieved much higher accuracies: 67.4% and 64.3%, respectively." ] ;
            oa:hasTarget <https://doi.org/10.1371/journal.pone.0194856> ;
            slr:claim_label "A model using only site identity achieved just 55.0% accuracy on ABIDE, far below the 64.3% achieved using MRI-derived features, indicating the classifier is not simply exploiting site identity." ;
            slr:relevance_score "0.9"^^xsd:float ],
        [ a oa:Annotation ;
