        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1204 ;
            slr:answer_text "Partly | quote: \"We esti- mated the NeuroHarmonize model parameters on the entire cohort of control subjects, by specifying the age as a covariate, whose effect is to be preserved during the harmonization process. Finally, we applied the esti- mated model on the entire sample of subjects with ASD and TD controls.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl5-leakage-control-reported-feature-selection-scaling-harmo> ;
            slr:source_id "S-016" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1238 ;
            slr:answer_text "Yes | quote: \"All experiments were conducted with a 10-fold cross-validation to divide the dataset into training and test sets, with 10% of the training set randomly selected as the validation set. Ultimately, the training, validation, and test sets were non-overlapping.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl5-leakage-control-reported-feature-selection-scaling-harmo> ;
            slr:source_id "S-066" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1253 ;
            slr:answer_text "Yes — edges associated with motion or differing between sites were masked out before CPM modelling, and leave-one-out cross-validation rebuilds the model excluding the test participant at every iteration. | quote: \"a leave-one-out cross-validation to evaluate the potential of models to predict  14  an unseen participant’s score, where N-1 participants are used to build the predictive model\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl5-leakage-control-reported-feature-selection-scaling-harmo> ;
