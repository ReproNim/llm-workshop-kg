        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1244 ;
            slr:answer_text "SPM12-based preprocessing producing voxel-wise fALFF (functional) and GM volume (structural) maps; no atlas/parcellation used (voxel-wise, fused via MCCAR+jICA) | quote: \"SPM12, wherein the above steps are integrated into a unified model [39].\"" ;
