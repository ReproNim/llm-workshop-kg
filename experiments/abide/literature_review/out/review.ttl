        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1235 ;
            slr:answer_text "No — three sites pooled with no site covariate, harmonisation, or leave-site-out evaluation reported." ;
