    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Predictors" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "C-PAC pipeline and Harvard-Oxford atlas are described in detail, with Fisher z-transformed Pearson correlation connectivity features." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Outcome" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "ASD vs HC labels used without stating the diagnostic instrument/source." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Analysis" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Recursive feature elimination via a ridge classifier is described prior to the cross-validation section with no statement that it is confined to training folds; the population graph is built transductively using phenotypic data (including site) from all subjects before node classification; site is used as a graph-edge similarity feature rather than being held out or corrected for, and no leave-site-out evaluation is reported. The reported accuracy (96.91%) is far above both the baselines in this paper (best baseline 87.62%) and most published ABIDE benchmarks, consistent with a leakage-driven inflation." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Participants" ;
