            slr:source_id "S-058" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1257 ;
            slr:answer_text "No — no motion/FD-based QC threshold is reported; preprocessing includes rigid-body motion correction but no exclusion rule based on a motion metric." ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl2-motion-qc-rule-reported-metric-and-threshold-e-g-mean-fd> ;
            slr:source_id "S-023" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1252 ;
            slr:answer_text "No — no motion metric, threshold or QC rating is mentioned anywhere in the methods. | quote: \"The age range for both  datasets is between 5-64years.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl2-motion-qc-rule-reported-metric-and-threshold-e-g-mean-fd> ;
            slr:source_id "S-056" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1218 ;
            slr:answer_text "No — no motion metric or threshold reported; only standard CCS preprocessing steps (motion realignment) are listed in Table 3" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl2-motion-qc-rule-reported-metric-and-threshold-e-g-mean-fd> ;
            slr:source_id "S-054" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1229 ;
            slr:answer_text "No — no numeric motion/FD threshold is reported; only a consistently-zero-time-series exclusion rule and standard 24-parameter motion regression are described." ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl2-motion-qc-rule-reported-metric-and-threshold-e-g-mean-fd> ;
