        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "we ﬁrst applied a data-driven algorithm that maximized the p-values of the group diﬀerence of age, FIQ, and mean FD (using two-sample t-tests). Then, to exclude the inﬂuence of the site interaction eﬀect, we" ] ;
            oa:hasTarget <https://doi.org/10.3389/fnhum.2022.774921> ;
