        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1212 ;
            slr:answer_text """Random involuntary motor noise (NSR of head motion) is elevated in ASD vs TD across age groups, with non-uniform age-dependent shifts in ASD vs. a smooth downward trend with age in TD. | quote: "The results suggest that the levels of random involuntary
motor noise are elevated in autism across age groups.\"""" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ5> ;
            slr:question_id "RQ5" ;
            slr:source_id "S-088" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1164 ;
            slr:answer_text "GAT2 achieved the best classification performance among compared models: accuracy 68.02%, sensitivity 74.06%, F1 69.31%, MCC 0.3426 (HO atlas); 3 of the top 10 interpreted functional connections showed uncorrected significant group differences (p<0.05). | quote: \"The GAT2 model achieved the best results in accuracy, sensitivity, F1 score, and MCC  indicators using fivefold cross-validation, with the accuracy of 68.02%, sensitivity of  74.06%, F1 score of 69.31%, and MCC of 0.3426.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ5> ;
            slr:question_id "RQ5" ;
            slr:source_id "S-053" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1190 ;
            slr:answer_text "Significantly decreased signal complexity (fractal dimension) in ASD in amygdala, vermis, basal ganglia and hippocampus; no regions significantly increased. | quote: \"Overall, we found reduced signal complexity in the ASD subjects with respect to controls.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ5> ;
            slr:question_id "RQ5" ;
            slr:source_id "S-045" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1175 ;
            slr:answer_text "CNN achieved 70.22% accuracy (10-fold CV) with the CC400 atlas, outperforming SVM/KNN/RF baselines; in the leave-site-out evaluation, KKI, SDSU and USM sites achieved accuracies above 70%, with performance varying by site. | quote: \"We achieved an accuracy of 70.22 %, which is better than the rest of the reported works (Table 4).\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ5> ;
            slr:question_id "RQ5" ;
            slr:source_id "S-022" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1253 ;
            slr:answer_text """FC-based CPM significantly predicted inhibition (rs=.23, permutation p=0.037) and (at trend level) shifting (rs=.19, p=0.067) but not emotion control; inhibition networks were posterior (somato-motor/visual/cerebellar), shifting networks anterior (frontoparietal/dorsal attention). | quote: "Significant models were built using negative edges for inhibition (rs=.23, p=0.0001) and shifting 
2 
(rs=.19, p=0.001), using leave-one-out prediction (N-1 at every iteration).\"""" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ5> ;
            slr:question_id "RQ5" ;
            slr:source_id "S-092" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1167 ;
            slr:answer_text "70.8% accuracy / 79.1% specificity on the whole ABIDE-I dataset; outperformed comparators for 12/17 sites with 64.42% average per-site accuracy | quote: \"ASD-SAENet exhibits comparable accuracy (70.8%), and superior speciﬁcity (79.1%) for the whole dataset as compared to other methods.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ5> ;
            slr:question_id "RQ5" ;
            slr:source_id "S-028" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1235 ;
            slr:answer_text "Best accuracy 85.9% (DenseNet201 + KNN); 10-fold CV gave 86.5 +/- 2.4% accuracy. | quote: \"The best prediction results  are 85.9% accuracy achieved by extracted the features from DenseNet201 network and classified these features by  KNN classifier.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ5> ;
