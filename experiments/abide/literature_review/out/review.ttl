        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1251 ;
            slr:answer_text "Yes | quote: \"The current ABIDE II dataset encompasses 17 collections of unique independent datasets (i.e., from individuals whose data were not previously shared in ABIDE I) yielding 487 datasets classiﬁed as ASD and 557 as controls (Fig. 1a, Table 1).\"" ;
