        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1197 ;
            slr:answer_text "Partly — no feature selection was used (avoiding that leakage route) and the SVM C hyperparameter was fixed rather than tuned to avoid a nested-CV leak, but this is stated as a design choice rather than an explicit leakage-control procedure. | quote: \"to avoid running optimization of hyperparameters, which would have required and additional nested cross validation\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl5-leakage-control-reported-feature-selection-scaling-harmo> ;
