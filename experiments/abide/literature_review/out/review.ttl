        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1185 ;
            slr:answer_text "Yes | quote: \"The package CPAC v1.8.0 was used for fMRI pre-processing including head motion correction, scrubbing, and nuisance regression.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl3-preprocessing-pipeline-and-version-reported> ;
            slr:source_id "S-015" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1228 ;
            slr:answer_text "Yes | quote: \"from 17 international sites2. The ROIs fMRI series of all sites are downloaded from the pre-processed ABIDE dataset with a configurable pipeline for the analysis of connectomes (CPAC), band-pass filter- ing (0.01 −0.1Hz), and no global signal regression\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl3-preprocessing-pipeline-and-version-reported> ;
            slr:source_id "S-067" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1257 ;
            slr:answer_text "Partly — SPM8 and in-house MATLAB code are named (by reference to a prior paper's identical pipeline), but no CPAC/DPARSF-style named pipeline or version number is given. | quote: \"For preprocessing fMRI and MRI scans, we used SPM8 (http://www.fil.ion.ucl.ac.uk/spm/ software/spm8/) and our own in-house MATLAB code. Preprocessing was identical to that used in Ghiassian et al. [13].\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl3-preprocessing-pipeline-and-version-reported> ;
