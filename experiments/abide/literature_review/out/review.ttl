    slr:evidence_spans [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "We experimentally compared GAT2 model’s performance on the  ABIDE I database from 1035 subjects" ] ;
            oa:hasTarget <https://doi.org/10.1186/s12859-021-04295-1> ;
            slr:claim_label "Study analyses 1035 ABIDE I subjects." ;
            slr:relevance_score "0.9"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Compared with healthy controls, children with ASD showed decreased effective connectivity among some large- scale brain networks. These brain networks included VN, DMN, cerebellum, SMN, and FPN." ] ;
            oa:hasTarget <https://doi.org/10.3389/fnins.2022.987248> ;
            slr:claim_label "Main finding: ASD children showed decreased (hypo) effective connectivity involving VN, DMN, cerebellum, SMN and FPN relative to TC." ;
            slr:relevance_score "0.9"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "The original 3D fMRI data has 73 slices per volume according to the data description of ABIDE-I. In our experiments, from the 73 slices, we contemplated the last 50 slices because of the precise sketches of the brain images." ] ;
            oa:hasTarget <https://doi.org/10.3389/fninf.2021.635657> ;
            slr:claim_label "3D volumes were converted to 2D slices (last 50 of 73) for the CNN input." ;
            slr:relevance_score "0.6"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "This indicates that there were no regions where signal complexity signifi- cantly increased respect to controls among the ASD patients." ] ;
            oa:hasTarget <https://doi.org/10.1371/journal.pone.0190081> ;
            slr:claim_label "No brain regions showed significantly increased signal complexity in ASD relative to controls; changes were unidirectional (decreased)." ;
            slr:relevance_score "0.7"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """Data presented in this study underwent standard fMRI pre-
processing (i.e., realignment, normalization, and smoothing) 
implemented in SPM12b. Data were preprocessed according to 
standard SPM protocols including realignment, normalization 
to a study specific template using DARTEL, smoothing, band-
pass filtering (0.01–0.05 Hz), and scrubbing to account for head 
movements (63).""" ] ;
            oa:hasTarget <https://doi.org/10.3389/fpsyt.2016.00177> ;
            slr:claim_label "Data were preprocessed with SPM12 (realignment, DARTEL normalization, smoothing, band-pass filtering, motion scrubbing)." ;
            slr:relevance_score "0.85"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """stratified five-fold cross-
validation is conducted, where one fold is used for t""" ] ;
            oa:hasTarget <https://doi.org/10.1109/tmi.2023.3337362> ;
            slr:claim_label "Evaluation: stratified five-fold cross-validation with separate validation/test folds." ;
            slr:relevance_score "0.8"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """However, our experiments also show that the improvement due to topological features is not always statisti-
cally signiﬁcant. Therefore, we oﬀer a cautionary tale to the practitioners
regarding the limited discriminative power of topological features derived from
fMRI data for the classiﬁcation of autism.""" ] ;
            oa:hasTarget <https://doi.org/10.1007/978-3-030-32248-9_82> ;
            slr:claim_label "Main finding: topological-feature improvements over correlation-only features are not always statistically significant." ;
            slr:relevance_score "0.9"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "All Sites 109 342 190 137 51 816 Number of participants from each site for each age group as well as the overall number of participants in a site that were used for this study. Last row shows the total number of subjects in each age-range." ] ;
            oa:hasTarget <https://doi.org/10.3389/fnins.2018.01018> ;
            slr:claim_label "816 subjects across 22 sites were distributed into five age ranges (5-10, 10-15, 15-20, 20-30, 30-65 years: 109, 342, 190, 137, 51 subjects respectively)." ;
            slr:relevance_score "0.85"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """Collected dataset was organized in three groups: 
● 
ABIDE I 
● 
ABIDE II 
● 
ABIDE I+II """ ] ;
            oa:hasTarget <https://doi.org/10.1109/tce.2023.3328479> ;
            slr:claim_label "The collected dataset was organized into three groups: ABIDE I, ABIDE II, and ABIDE I+II." ;
            slr:relevance_score "0.7"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """We have used the brain Automated anatomical labelling (AAL) template which divides the brain
into 90 regions.""" ] ;
            oa:hasTarget <https://doi.org/10.3390/brainsci10100754> ;
            slr:claim_label "Used the AAL atlas (first 90 regions) to construct 90x90 functional connectivity matrices." ;
            slr:relevance_score "0.8"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "The code used of all the experiments performed is available on GitHub1." ] ;
            oa:hasTarget <https://doi.org/10.3389/fpsyt.2020.00440> ;
            slr:claim_label "All experiment code is publicly released on GitHub." ;
            slr:relevance_score "0.6"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Only subjects with FIQ within 2 SD + mean across all the Autism Brain Imaging Data Exchange (ABIDE) samples and with mean framewise displacement (FD) below 2 SD + mean were included." ] ;
            oa:hasTarget <https://doi.org/10.3389/fnhum.2022.774921> ;
            slr:claim_label "QC rule: FIQ and mean framewise displacement each within 2 SD of the sample mean." ;
            slr:relevance_score "0.8"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """we also found signiﬁcant negative correlation
between the strength of the effective connectivity from right angular
gyrus (ANG_R) of DMN to left precentral gyrus (PreCG_L) of SMN and""" ] ;
            oa:hasTarget <https://doi.org/10.3389/fnins.2022.987248> ;
            slr:claim_label "Effective connectivity from DMN (ANG_R) to SMN (PreCG_L) negatively correlated with a clinical ADOS score." ;
            slr:relevance_score "0.7"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """procedures resulted in a total of 297 par-
ticipants (151 ASD and 146 TD) from 4 different sites (i.e., New York University Langone
Medical Center [NYU], University of Pittsburgh, School of Medicine [PITT], University of
Utah, School of Medicine [USM], and Trinity Centre for Health Sciences [TCD]) in ABIDE.""" ] ;
            oa:hasTarget <https://doi.org/10.1371/journal.pbio.3001627> ;
            slr:claim_label "Final ABIDE sample: 297 participants (151 ASD, 146 TD) from 4 sites (NYU, PITT, USM, TCD)." ;
            slr:relevance_score "1.0"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "In this study, we used multiscale functional brain parcels. Brain parcels were created using a method known as the bootstrap analysis of stable clusters called BASC [32]. Scales were selected using a data- based method called MSTEPS [33]. There are different scales in this method. In this study, the scale is set to 122." ] ;
            oa:hasTarget <https://doi.org/10.35377/saucis.04.01.879735> ;
            slr:claim_label "Parcellation used the BASC atlas at scale 122, selected via MSTEPS." ;
            slr:relevance_score "0.8"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "We applied scrubbing so that we kept 125 volumes with lowest framewise displacem" ] ;
            oa:hasTarget <https://doi.org/10.1002/hbm.23084> ;
            slr:claim_label "Motion control for the ABIDE replication used framewise-displacement-based scrubbing, retaining the 125 lowest-motion volumes per subject." ;
            slr:relevance_score "0.6"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "The code for our framework is available at github.com/Lugges991/METAFormer" ] ;
            oa:hasTarget <https://doi.org/10.1007/978-3-031-44858-4_12> ;
            slr:claim_label "Analysis code publicly released on GitHub." ;
            slr:relevance_score "0.6"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """We successfully downloaded a dataset 
of 1102 subjects from the Preprocessed Connectomes Project, 
and then excluded subjects whose imaging data shows some miss-
ing. Finally, data of 506 ASD individuals and 548 controls was 
included in our study.""" ] ;
            oa:hasTarget <https://doi.org/10.5607/en.2020.29.1.27> ;
            slr:claim_label "Cohort was 506 ASD and 548 control subjects retained after excluding subjects with missing imaging data from the 1102-subject ABIDE Preprocessed Connectomes Project download." ;
            slr:relevance_score "0.95"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "network nodes were defined as 512 regions of interest with uniform areas obtained from a random parcellation (38)" ] ;
            oa:hasTarget <https://doi.org/10.1016/j.biopsych.2021.12.004> ;
            slr:claim_label "Dynamic connectomes used a 512-node random parcellation." ;
            slr:relevance_score "0.7"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "3 rsFCs (the connection 4, 5, and 7) were statistically significant (p < 0.05)  between the ASD and HC groups." ] ;
            oa:hasTarget <https://doi.org/10.1186/s12859-021-04295-1> ;
            slr:claim_label "Post-hoc interpretation identified 3 of 10 top connections with uncorrected group differences (p<0.05)." ;
            slr:relevance_score "0.6"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """we conducted the experiment on the publicly available ABIDE-I
dataset, including rs-fMRI and phenotypic data of 1112 sub-
jects from 17 different sites (Di Martino et al., 2014; Crad-
dock et al., 2013). In current study, we utilized rs-fMRI data
from 848 subjects, including 396 patients with ASD and 452
health controls (HCs).""" ] ;
            oa:hasTarget <https://doi.org/10.1016/j.neunet.2025.107450> ;
            slr:claim_label "Of the 1112-subject ABIDE-I release across 17 sites, 848 subjects (396 ASD, 452 HC) were used." ;
            slr:relevance_score "1.0"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """we selected a 
subgroup of 190 subjects (102 with ASD and 88 TD) according to the following criteria: male 
children (age range: 6.5–13 years); rs-fMRI data acquired with open eyes; data from the 
University sites that provided the largest number of scans (KKI, NYU, UCLA, UM).""" ] ;
            oa:hasTarget <https://doi.org/10.3389/fpsyt.2019.00620> ;
            slr:claim_label "Cohort was a 190-subject (102 ASD, 88 TD) subset of ABIDE I selected by age, sex, eye status and site." ;
            slr:relevance_score "1.0"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """After matching, we ended up with 290 participants (145 participants per group)
in ABIDE and 126 (63 participants per group) in HBN, which were used subsequently for the
classification of ASD versus TD in both datasets.""" ] ;
            oa:hasTarget <https://doi.org/10.1371/journal.pbio.3001627> ;
            slr:claim_label "After propensity-score matching on age, sex and site, 290 ABIDE participants (145 per group) were used for classification." ;
            slr:relevance_score "0.85"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "mean FD scores were included as a nuisance covariate in t-tests. In addition, FSIQ and imaging sites were included as nuisance covariates. Bonferroni correction was performed for multiple comparisons (p = 0.004)." ] ;
            oa:hasTarget <https://doi.org/10.3389/fnhum.2018.00454> ;
            slr:claim_label "Site and motion were handled as covariates; multiple comparisons corrected by Bonferroni in the replication analysis." ;
            slr:relevance_score "0.8"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "We used the resting-state fMRI data from 1035 subjects in the ABIDE I initiative [20]  for this study. The dataset includes 505 individuals diagnosed as having ASD and 530  HC." ] ;
            oa:hasTarget <https://doi.org/10.1186/s12859-021-04295-1> ;
            slr:claim_label "Final analysed cohort: 505 ASD, 530 HC from ABIDE I." ;
            slr:relevance_score "1.0"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Our results have demonstrated the advantage of using a fed- erated framework to utilize multi-site data without data shar- ing compared to alternative methods." ] ;
            oa:hasTarget <https://doi.org/10.1016/j.media.2020.101765> ;
            slr:claim_label "The federated framework used multi-site data without data sharing and outperformed alternative (non-federated) training strategies." ;
            slr:relevance_score "0.8"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "This yielded 27 subjects with IDs: 51457, 51464, 51468,  51474, 50642, 50643, 50645, 50646, 50647, 50649, 50651, 50652, 50653, 50655, 50002,  50003, 50004, 50006, 50007, 50012, 50016, 50019, 50022, 50024, 50025, 50053, 50056." ] ;
            oa:hasTarget <https://doi.org/10.1002/hbm.23084> ;
            slr:claim_label "Final 27-subject ABIDE cohort is given as an explicit participant-ID list." ;
            slr:relevance_score "0.9"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "We used the KKI dataset in this study. The KKI dataset collected from 211 children aged 8 to 13 years, including 56 children with ASD and 155 children in the typical controls (TC) group." ] ;
            oa:hasTarget <https://doi.org/10.3389/fnins.2022.987248> ;
            slr:claim_label "Source was the KKI site of ABIDE II, originally 211 children (56 ASD/155 TC) before exclusions." ;
            slr:relevance_score "0.8"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "We incorporated data from 529 ASD individuals and 573 typical controls (TC) for each pipeline, which is comprised of 17 different imaging sites." ] ;
            oa:hasTarget <https://doi.org/10.1109/jbhi.2020.2998603> ;
            slr:claim_label "Cohort: 529 ASD and 573 typical control individuals from 17 ABIDE sites, processed with each of four pipelines." ;
            slr:relevance_score "0.9"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """The results indicated that the biomarkers 
generated from the default mode and executive control networks significantly differed between the 
participants with ASD and TD. In particular, the biomarkers derived from the default mode network 
were negatively correlated with the raw scores and model factors of the SRS.""" ] ;
            oa:hasTarget <https://doi.org/10.1038/s41598-019-45465-9> ;
            slr:claim_label "DMN- and executive-control-network-derived biomarkers differed between ASD and TD and correlated negatively with SRS severity scores." ;
            slr:relevance_score "1.0"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "The data used in the current study were provided by ABIDE I ( http://fcon_1000.projects.nitrc.org/indi/abide/), and we use all 1102 subjects (ﬁlter_noglobal) processed by the Conﬁgurable Pipeline for the Analysis of Connectomes (CPAC) [22] for experiments." ] ;
            oa:hasTarget <https://doi.org/10.1109/tnsre.2022.3233656> ;
            slr:claim_label "All 1102 ABIDE I subjects (CPAC filter_noglobal preprocessing) were used." ;
            slr:relevance_score "1.0"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "we apply Forman–Ricci and Ollivier–Ricci curvatures to compare  networks of ASD and typically developing individuals (N = 1112) from the Autism Brain Imaging  Data Exchange I (ABIDE-I) dataset." ] ;
            oa:hasTarget <https://doi.org/10.1038/s41598-022-12171-y> ;
            slr:claim_label "Study compares ASD and TD networks from ABIDE-I (starting N=1112 before QC)." ;
            slr:relevance_score "0.8"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """ABIDE I and II: Data are freely accessible in the publicly available Autism Brain 
Imaging Data Exchange repository (http://fcon_1000.projects.nitrc.org/indi/
abide).""" ] ;
            oa:hasTarget <https://doi.org/10.1186/s13229-021-00415-z> ;
            slr:claim_label "ABIDE I and II data are freely accessible via the public ABIDE/FCP-INDI repository." ;
            slr:relevance_score "0.6"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "A functionally defined atlas, consisting of 268 cortical and subcortical regions-of-interest (‘nodes’)" ] ;
            oa:hasTarget <https://doi.org/10.1016/j.dcn.2019.100747> ;
            slr:claim_label "Used the Shen 268-node functional atlas for connectivity nodes." ;
            slr:relevance_score "0.8"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """Data Availability
The datasets generated during and/or analyzed during the current study are available from the corresponding 
author on reasonable request.""" ] ;
            oa:hasTarget <https://doi.org/10.1038/s41598-019-45465-9> ;
            slr:claim_label "Underlying datasets (including the local KMUH cohort) are available only on reasonable request, not as an open participant list." ;
            slr:relevance_score "0.5"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "In our experiments, the highest accuracy for glass brain images is up to 85% belongs to several data sites and for stat map images the accuracy is up to 84% for several data sites as shown in the table." ] ;
            oa:hasTarget <https://doi.org/10.1109/jbhi.2020.2998603> ;
            slr:claim_label "Unit-site classification reached up to 85% accuracy (glass-brain images) and 84% (stat-map images) for some individual sites." ;
            slr:relevance_score "1.0"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "In this study, we used the fMRI data of 816 individuals enrolled in the Autism Brain Imaging Data Exchange (ABIDE) to introduce a new biomarker extraction pipeline for ASD that relies on the use of graph theoretical metrics of fMRI-based functional connectivity to inform a support vector machine (SVM)." ] ;
            oa:hasTarget <https://doi.org/10.3389/fnins.2018.01018> ;
            slr:claim_label "The study used fMRI data of 816 ABIDE individuals, extracting graph-theoretical metrics of functional connectivity to inform an SVM classifier." ;
            slr:relevance_score "0.9"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """For ASD, the ROIs of the dataset can be divided into
eight functional subnetworks: cerebellum and subcortical
structure (CB), visual network (VN), somatic motor network
(SMN), dorsal attention network (DAN), ventral attention
network (VAN), edge network (LN), frontoparietal network
(FPN), and default mode network (DMN).""" ] ;
            oa:hasTarget <https://doi.org/10.1109/tpami.2024.3442811> ;
            slr:claim_label "The ABIDE ROIs analysed for ASD are grouped into eight functional subnetworks." ;
            slr:relevance_score "0.8"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Our experiments suggest that an accuracy of approx. 70% could be an intrinsic limitation of the whole dataset." ] ;
            oa:hasTarget <https://doi.org/10.1016/j.media.2018.06.001> ;
            slr:claim_label "Authors interpret the ~70% accuracy ceiling as a possible intrinsic limitation of the heterogeneous multi-site ABIDE dataset." ;
            slr:relevance_score "0.6"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """For ABIDE, we considered data from all acquisition sites with at least 10 participants per
group and with both children and adults. After detailed quality control, only cases with accept-
able T1-weighted (T1w) MRI, surface extraction, and head motion in rs-fMRI were included.""" ] ;
            oa:hasTarget <https://doi.org/10.1371/journal.pbio.3001627> ;
            slr:claim_label "ABIDE sites required at least 10 participants per group and both children and adults; QC required acceptable T1w MRI, surface extraction, and acceptable head motion in rs-fMRI." ;
            slr:relevance_score "0.9"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "The raw dataset encompasses a total of 1112 subjects, 539 of which are diagnosed with ASD and 573 are TC." ] ;
            oa:hasTarget <https://doi.org/10.1007/978-3-031-44858-4_12> ;
            slr:claim_label "Full ABIDE I release referenced for context: 1112 subjects, 539 ASD, 573 TC." ;
            slr:relevance_score "0.5"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """The data is preprocessed using the Conﬁgurable Pipeline for
the Analysis of Connectomes (CPAC) pipeline, which includes
essential steps such as slice timing correction, voxel intensity
normalization, motion correction, nuisance signal removal, global
signal regression, band-pass ﬁltering, and spatial registration.""" ] ;
            oa:hasTarget <https://doi.org/10.3389/frai.2025.1594372> ;
            slr:claim_label "Preprocessing used the CPAC pipeline with standard steps including motion correction." ;
            slr:relevance_score "0.9"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Since manual QA was not yet available for ABIDE-II, we per- formed an automatic quality control by selecting those subjects that retained at least 100 frames or 4 minutes of fMRI scans after motion scrubbing [19]. Motion scrubbing was performed based on Framewise Displacement (FD), dis- carding one volume before and two volumes after the frame with FD exceeding 0.5mm [15]. This step yielded a ﬁnal ABIDE-II sample size of 163 individuals with ASD and 230 healthy controls." ] ;
            oa:hasTarget <https://doi.org/10.1007/978-3-030-00889-5_16> ;
            slr:claim_label "ABIDE-II held-out test subset (163 ASD, 230 TD) defined by an automatic motion-scrubbing QC rule (FD > 0.5mm, minimum 100 retained frames)." ;
            slr:relevance_score "0.95"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Tests on the ABIDE I data set were carried out using the 10-fold cross-validation method. The main purpose of this process is to use each data for both training and testing." ] ;
            oa:hasTarget <https://doi.org/10.35377/saucis.04.01.879735> ;
            slr:claim_label "Evaluation used 10-fold cross-validation (no site-based split mentioned)." ;
            slr:relevance_score "0.8"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "The  automated anatomical labelling (AAL) is selected as the standard brain atlas to divide the brain into 116 regions of  interest (ROIs)" ] ;
            oa:hasTarget <https://doi.org/10.30880/ijie.2021.13.05.006> ;
            slr:claim_label "Used the AAL atlas (116 ROIs), with 22 DMN ROIs selected for analysis." ;
            slr:relevance_score "0.8"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "in this work, ﬁrstly, we design an image genera- tor to generate single volume brain images from the whole-brain image of each subject." ] ;
            oa:hasTarget <https://doi.org/10.1109/jbhi.2020.2998603> ;
            slr:claim_label "Features are single-volume whole-brain images generated per subject, rather than ROI-based connectivity matrices." ;
            slr:relevance_score "0.7"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """All ABIDE II datasets can be accessed, after establishing a login and user password, through FCP/INDI
at the Neuroimaging Informatics Tools and Resources Clearinghouse (NITRC; http://fcon_1000.projects.
nitrc.org/indi/abide/). The datasets are organized by data collection and stored in.tar ﬁles, each
containing imaging and phenotypic data.""" ] ;
            oa:hasTarget <https://doi.org/10.1038/sdata.2017.10> ;
            slr:claim_label "ABIDE II data (imaging and phenotypic) are openly accessible via NITRC after registration." ;
            slr:relevance_score "0.8"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "the analysis based on empirical Bayes normalized connectivity metrics shows signiﬁcant connectivity diﬀerences between the ASD and TC groups , and 44 connectivity features have fdr q- values less than 0.1." ] ;
            oa:hasTarget <https://doi.org/10.3389/fnins.2015.00316> ;
            slr:claim_label "After empirical-Bayes normalization, 44 connectivity features differed significantly between ASD and TC (fdr q<0.1), whereas raw correlations found none." ;
            slr:relevance_score "0.9"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "For the leave-site-out CV procedure, we selected ﬁve sites with the highest number of total subjects (ASD/total), namely New York University (NYU) (90/159), Kennedy Krieger Institute - 1 (KKI-I) (88/114), University of Miami - 1 (UM-I) (50/96), University of California, Los Angeles (UCLA)-I (28/69), Oregon Health & Science University (OHSU)-I (42/64)." ] ;
            oa:hasTarget <https://doi.org/10.3389/fpsyt.2020.00440> ;
            slr:claim_label "The leave-site-out evaluation used the five largest sites (NYU, KKI-I, UM-I, UCLA-I, OHSU-I) with each held out as the test set in turn." ;
            slr:relevance_score "0.9"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "the remaining volumes are processed by a well- accepted pipeline with the Data Processing Assistant for Resting- State fMRI toolbox (DPARSF) (Yan et al., 2016)." ] ;
            oa:hasTarget <https://doi.org/10.3389/fninf.2021.802305> ;
            slr:claim_label "Preprocessing pipeline: DPARSF." ;
            slr:relevance_score "0.8"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "All the preprocessing of resting state-fMRI was performed using the Statistical Parameter Mapping 8 (SPM8)" ] ;
            oa:hasTarget <https://doi.org/10.3389/fnhum.2022.774921> ;
            slr:claim_label "Preprocessing pipeline: SPM8 and DPARSF." ;
            slr:relevance_score "0.7"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """The rs-fMRI data utilized in this study was preprocessed with 
the Configurable Pipeline for the Analysis of Conenectomes (C-
PAC). The preprocessing procedure covers the operation of slice 
time and motion corrected, as well as voxel intensity normalized.""" ] ;
            oa:hasTarget <https://doi.org/10.5607/en.2020.29.1.27> ;
            slr:claim_label "Data were preprocessed with the C-PAC pipeline (slice timing, motion correction, intensity normalization, nuisance regression, band-pass filtering, ANTs normalization to MNI152)." ;
            slr:relevance_score "0.85"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """ComBat (36) was used to remove the confounding 
