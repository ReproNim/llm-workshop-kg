        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1166 ;
            slr:answer_text "Yes | quote: \"Using automated anatomical labeling (AAL), we then used the ﬁrst 90 regions of interest (ROIs) as nodes\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
            slr:source_id "S-078" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1211 ;
            slr:answer_text "Yes — Schaefer 200-parcel atlas. | quote: \"Subsequently, 200 regions of interest (ROIs)  or nodes were defined in the brain using the Schaefer atlas\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
            slr:source_id "S-093" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1242 ;
            slr:answer_text "Yes — AAL atlas, 90 ROIs. | quote: \"fMRI image could be divided into 90 regions based on the Automatic Anatomical Labeling (AAL) (Tzourio-Mazoyer et al., 2002) atlas. We make these regions as the nodes of brain network, so there are 90 nodes. An average of the time series of a region’s all voxels can be used to capture the mean time series of this region (Khazaee et al., 2016). The average time series of every two brain regions can be employed to calculate the Pearson correlation coeﬃcient which is made as the link of the brain network (Khazaee et al., 2015), so there are 4,005 (90∗89/2) weighted edges.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
            slr:source_id "S-027" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1244 ;
            slr:answer_text "No" ;
