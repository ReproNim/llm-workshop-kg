            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1195 ;
            slr:answer_text "No — the GLM covariates were limited to age and sex; no site covariate, harmonisation, or leave-site-out evaluation is reported despite pooling multiple ABIDE sites | quote: \"2-tailed t-test design with two covariates of age and sex was used to compute the statistical signiﬁcance of the FCD diﬀerences between the two groups. Statistical signiﬁcance was based on the false discovery rate corrected P < 0.05 together with requiring 20 voxels for the minimum continuous voxel size within a cluster (corrected P < 0.05).\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl6-site-handling-reported-site-covariate-harmonisation-e-g> ;
            slr:source_id "S-041" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1225 ;
            slr:answer_text "No — no site covariate, harmonisation, or leave-site-out evaluation is reported." ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl6-site-handling-reported-site-covariate-harmonisation-e-g> ;
