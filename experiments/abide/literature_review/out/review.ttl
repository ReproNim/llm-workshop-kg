        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1257 ;
            slr:answer_text "SPM8 plus in-house MATLAB code (preprocessing identical to a prior published pipeline); no named ROI atlas — functional features come from subject-level spatial ICA components rather than an ROI parcellation. | quote: \"For preprocessing fMRI and MRI scans, we used SPM8 (http://www.fil.ion.ucl.ac.uk/spm/ software/spm8/) and our own in-house MATLAB code. Preprocessing was identical to that used in Ghiassian et al. [13].\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
