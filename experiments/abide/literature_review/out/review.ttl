        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1209 ;
            slr:answer_text "uses-data | quote: \"This dataset is comprised of resting state fMRI and T1-weighted structural MRI scans from 1112 subjects, including patients with autism and healthy controls. ABIDE participant data was col- lected at 17 different institutions in North America and Europe.\"" ;
