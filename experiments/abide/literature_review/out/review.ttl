        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1193 ;
            slr:answer_text "Widespread CD reductions in ASD, peak effect in limbic network (Cohen's d=-0.159); positive correlation of CD to IQ, no significant correlation with age or ADOS. | quote: \"peak reductions in CD in  the limbic network (Cohen’s d=-0.159, Fig.  3A)\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ5> ;
            slr:question_id "RQ5" ;
            slr:source_id "S-080" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1252 ;
            slr:answer_text "ResNet-50 achieved the best test accuracy of 87.0% versus VGG-16's 63.4%; no AUC or confidence interval reported. | quote: \"The best CNN model in this project was  achieved by ResNet50, with an accuracy of 87.0%.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ5> ;
