        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1243 ;
            slr:answer_text """Yes | quote: "the mean timeseries for a set
of cortical and subcortical regions of interest (ROIs) extracted
from the Har\"""" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
            slr:source_id "S-077" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1251 ;
            slr:answer_text "No" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
