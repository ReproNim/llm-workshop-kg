        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1188 ;
            slr:answer_text "Partly — N by diagnosis given (505/530) and a post-QC total (1,035) stated, but no explicit inclusion/exclusion criteria text. | quote: \"The rs-fMRI data used in this study were sourced from the ABIDE I dataset, comprising 505 autistic individuals and 530 typical controls (TCs).\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl1-cohort-definition-reported-inclusion-exclusion-rules-and> ;
