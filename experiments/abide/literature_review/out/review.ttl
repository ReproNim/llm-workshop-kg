        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1250 ;
            slr:answer_text "No — no statement that graph-construction or feature steps were confined to training folds. | quote: \"a 10-fold cross-validation schema that mixes data from all 17 sites while keeping\"" ;
