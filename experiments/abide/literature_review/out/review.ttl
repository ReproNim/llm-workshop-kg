        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1188 ;
            slr:answer_text "Yes — three named atlases (AAL, CC, EZ). | quote: \"Functional connectivity matrices are derived from three brain atlases (AAL, CC, EZ) using Pearson correlation coeﬃcients\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
            slr:source_id "S-064" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1248 ;
            slr:answer_text """Yes — AAL atlas, 90 regions. | quote: "We have used the brain Automated anatomical labelling (AAL) template which divides the brain
into 90 regions.\"""" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
