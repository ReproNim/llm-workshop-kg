        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1219 ;
            slr:answer_text """No | quote: "Five-fold 
cross-validation is used to evaluate the performance of the 
model.\"""" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl5-leakage-control-reported-feature-selection-scaling-harmo> ;
            slr:source_id "S-049" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1236 ;
            slr:answer_text "Partly — the CNN architecture/hyperparameters were fixed across folds, but baseline hyperparameters were chosen by maximising cross-validation accuracy itself, which the authors state is optimistic. | quote: \"We test 10 linearly spaced values for the hyper-parameter α in the range [0.1,10] and report the highest cross-validation accuracy. Thus this baseline result reﬂects an optimistic estimate of performance.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl5-leakage-control-reported-feature-selection-scaling-harmo> ;
            slr:source_id "S-006" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1240 ;
            slr:answer_text "No — not applicable, this is a group-difference GLM/replication design, not a predictive train/test model" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl5-leakage-control-reported-feature-selection-scaling-harmo> ;
            slr:source_id "S-012" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1187 ;
            slr:answer_text "Unclear | quote: \"a leave-one-out classiﬁer was used to generate a classiﬁcation score for each of the 964 subjects, leaving out one subject at a time\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl5-leakage-control-reported-feature-selection-scaling-harmo> ;
