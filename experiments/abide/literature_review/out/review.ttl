        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1176 ;
            slr:answer_text "Yes | quote: \"In the current study, ABIDE sites were included that (i) deposited raw  resting-state functional Magnetic Resonance Imaging (MRI) scans (i.e., no motion correction or “scru\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl2-motion-qc-rule-reported-metric-and-threshold-e-g-mean-fd> ;
            slr:source_id "S-047" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1193 ;
            slr:answer_text "Yes — two explicit FD-based exclusion thresholds given. | quote: \"Subjects with a mean framewise displacement  (FD) > 0.3 mm in rs-fMRI (two SD from the mean across  all subjects) were excluded (n = 9).\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl2-motion-qc-rule-reported-metric-and-threshold-e-g-mean-fd> ;
