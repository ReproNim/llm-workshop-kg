            slr:relevance_score "0.7"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "the ASD group showed a higher mean value (Cohen’s d = .18, p = .007) and a lower standard deviation (Cohen’s d = -.19, p = .004) in whole-brain modular variability than the HC group" ] ;
