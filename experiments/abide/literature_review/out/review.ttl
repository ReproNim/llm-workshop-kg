<urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> a slr:ResearchQuestion ;
    dcterms:title "CL4 Atlas/parcellation reported" ;
    slr:has_answer [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1240 ;
            slr:answer_text "No — cortical ROIs used but no named standard atlas/parcellation is specified in the extracted text" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
            slr:source_id "S-012" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1190 ;
            slr:answer_text "Yes | quote: \"The 240 regions of interest (ROIs) defined for this study were extracted from the TT_Daemon human brain atlas [43] provided with the AFNI package [44].\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
            slr:source_id "S-045" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1226 ;
            slr:answer_text "Yes — AAL, Craddock 200 (CC), and Eickhoff-Zilles (EZ) atlases | quote: \"The Automated Anatomical Labelling (AAL) atlas, with 116 ROIs, is widely used in ASD diagnosis studies [16, 35, 36, 37] due to its ability to provide precise anatomical lo- cations essential for identifying structural abnormalities caused by ASD. The Craddock 200 atlas [38], with 200 ROIs, is based on functional connectivity and is particularly useful for analysing resting-state fMRI data [39, 9, 36, 37], as it clusters the brain into functionally homogeneous regions. Recent studies have leveraged multiple atlases to capture diverse patterns related to ASD. For instance, Mahler et al. [37] proposed a multi-atlas framework for ASD classification using resting-state fMRI data, employing three atlases, including AAL and Craddock 200. Similarly, Deng et al. [9] utilised the AAL, Craddock 200 and Craddock 400 atlases. Their experiment in- dicates that Craddock 200 can outperform Craddock 400 in fMRI-based ASD diagnosis. Hence, we selected the Craddock 200 atlas, hereinafter referred to as the CC atlas. To further enhance the analysis, we leverage the Eickhoff-Zilles (EZ) atlas with 116 ROIs, which has also been utilised in recent ASD diagnosis studies [40, 41]. Derived from cytoarchi- tectonic mapping, the EZ atlas combines anatomical and functional data, offering a nuanced view that bridges structural and functional aspects of brain regions\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
            slr:source_id "S-014" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1180 ;
            slr:answer_text "Yes | quote: \"the Harvard Oxford (HO) atlas comprising R = 110 cortical and subcortical ROIs\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
            slr:source_id "S-024" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1215 ;
            slr:answer_text "No | quote: \"in this work, ﬁrstly, we design an image genera- tor to generate single volume brain images from the whole-brain image of each subject.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
            slr:source_id "S-036" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1206 ;
            slr:answer_text "Yes | quote: \"by partitioning the brain into multiple ROIs using two atlases, i.e., Automated Anatomical Labeling (AAL) (Tzourio-Mazoyer et al., 2002) atlas with 116 ROIs and Craddock200 (CC200) (Craddock et al., 2012) atlas with 200 ROIs.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
            slr:source_id "S-059" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1241 ;
            slr:answer_text "Yes | quote: \"the mean time series for a set of regions extracted from the Harvard Oxford (HO) atlas (Desikan et al., 2006) were computed\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
            slr:source_id "S-019" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1233 ;
            slr:answer_text "Yes | quote: \"Seed ROIs in the cerebellum were created using the probabilistic MR Atlas of the human cerebellum\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
            slr:source_id "S-043" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1187 ;
            slr:answer_text "Partly | quote: \"we obtained pairwise functional connectivity measurements from a lattice of 7266 regions of interest covering the gray matter\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
            slr:source_id "S-021" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1261 ;
            slr:answer_text """Yes | quote: "Schaefer parcellation to divide the cortex of each participant into 400 functional regions of 
interest (ROIs) (37), combined with 15 subcortical ROIs from the Harvard-Oxford subcortical 
atlas (38)\"""" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
