        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1207 ;
            slr:answer_text "Yes — AAL standard brain template used to define 24 ROIs. | quote: \"Then 24 ROIs corresponding to 7 brain networks were selected using the AAL standard brain template provided by the Montreal Neurological Institute (MNI).\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
