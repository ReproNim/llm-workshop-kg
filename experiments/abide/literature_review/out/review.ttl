        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1262 ;
            slr:answer_text "Custom FSL-based pipeline (MCFLIRT motion correction, FLIRT registration, scrubbing, 0.01-0.1Hz band-pass, nuisance regression); Power et al. (2011) 264-ROI atlas organized into 11 RSNs. | quote: \"ROIs were deﬁned as 10 mm diameter spheres whose center coordinates are given in MNI atlas space (Power et al., 2011).\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-094" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1258 ;
            slr:answer_text """Connectome Computation System (CCS) pipeline; Craddock 200 (CC200) atlas (200 ROIs). | quote: "The resting state fMRI data was then parcellated into
200 regions of interest (ROIs) using a spatially constrained
spectral clustering algorithm based on functional parcellations by
Cameron Craddock (Craddock et al., 2012).\"""" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-098" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1211 ;
            slr:answer_text "CONN toolbox pipeline (motion correction, slice-timing correction, outlier detection, segmentation/normalization, denoising, 0.008Hz high-pass filter); Schaefer 200-parcel atlas. | quote: \"We used the CONN functional connectivity ​toolbox69 to process the rs- fMRI data from ABIDE-I.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-093" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1213 ;
            slr:answer_text "fMRIPrep v1.3.1 pipeline; no parcellation/atlas used (whole-thalamus seed-based voxelwise GLM, not a parcellation-based connectome) | quote: \"Func- tional data from both the HFASD and ABIDE cohorts were preprocessed identically using fMRIPrep v1.3.152, a pipeline that uses a combination of tools from existing neuroimaging software packages.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-007" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1187 ;
            slr:answer_text "Custom SPM8 pipeline (not C-PAC/DPARSF/NIAK); 7266-ROI whole-brain gray-matter lattice (no named cortical atlas). | quote: \"Preprocessing was performed in MATLAB (Mathworks, Natick, MA) using SPM8 (Wellcome Trust, London) software.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-021" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1209 ;
            slr:answer_text "Custom SPM8 + in-house MATLAB preprocessing pipeline (motion correction, co-registration, MNI normalization); no atlas/parcellation — features are 3D-HOG voxel-based image-texture descriptors, not ROI connectivity | quote: \"For preprocessing, we used SPM8, a software package designed for analyzing brain imaging data and also for preprocessing fMRI data [27, 28] and our own in-house MATLAB code.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-032" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1249 ;
            slr:answer_text "Custom FSL-based pipeline (not C-PAC/DPARSF/NIAK/CCS); no named cortical atlas — voxelwise 6mm-isotropic lattice. | quote: \"We applied scrubbing so that we kept 125 volumes with lowest framewise displacem\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-038" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1195 ;
            slr:answer_text "Custom SPM8 preprocessing pipeline (realignment, coregistration, MNI normalization, smoothing, nuisance regression, band-pass filter); no ROI atlas/parcellation — whole-brain voxel-wise functional connectivity density mapping | quote: \"Datasets were preprocessed with SPM8 (http://www.ﬁl.ion.ucl. ac.uk/spm/software/spm8/). The ﬁrst step was realignment for head motion correction. Images were realigned to the ﬁrst image and a mean echo planar image (EPI) was created during this step. Subsequently, structural T1 images were coregistered to their mean EPI data. Registered EPI data of each subject were normalized to Montreal Neurological Institute (MNI) template and spatially smoothed with 8 mm of full-width at half- maximum. Then, in the temporal domain, the linearly increasing trend due to heat absorption was removed at each voxel, and the eﬀects of the head motion, white matter, cerebrospinal ﬂuid, and global signal were regressed out. Lastly, temporal band-pass ﬁltering was applied (0.01–0.08 Hz).\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-041" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1248 ;
            slr:answer_text """C-PAC pipeline (structural: skull stripping, tissue segmentation, MNI normalization; functional: slice-time correction, motion correction, band-pass filtering, registration); AAL atlas, 90 regions, 90x90 connectivity matrix. | quote: "We have used the brain Automated anatomical labelling (AAL) template which divides the brain
into 90 regions.\"""" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-099" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1227 ;
            slr:answer_text "Preprocessed Connectomes Project CPAC pipeline; CC200 atlas, 200-region parcellation. | quote: \"We extracted rsfMRI time series using a 200-region parcellation CC200[?], estimated subject-wise time-resolved connectivity matrices with windows lengths ranging from 10 to 20 volumes (20-40s) and calculated node variability.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-072" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1183 ;
            slr:answer_text """C-PAC pipeline; group-ICA-derived brain functional networks (no ROI atlas, data-driven ICA parcellation) with dual regression | quote: "We preprocessed the data using a widely adopted pipeline called
Conﬁgurable Pipeline for the Analysis of Connectomes (C-PAC)
(Craddock et al., 2013)\"""" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-060" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1222 ;
            slr:answer_text "C-PAC (Configurable Pipeline for the Analysis of Connectomes), following a Preprocessed Connectomes Project strategy chosen for replicability; no ROI atlas used — voxel-wise summary-measure volumes (e.g. ReHo, ALFF) are fed directly into a 3D-CNN. | quote: \"The preprocessing was done using the Conﬁgurable Pipeline for the Analysis of Connectomes (C-PAC, (12). We followed a preprocessing strategy adopted by the Preprocessed Connectome Project initiative3. This will allow others to replicate and extend the ﬁndings in this paper.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-030" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1242 ;
            slr:answer_text "DPARSF preprocessing (DICOM-to-NIFTI, removal of first 10 volumes, slice timing, realignment, EPI-template normalisation, smoothing, linear-trend removal, temporal filtering, covariate removal); AAL atlas (90 ROIs, 4,005 pairwise connectivity edges) plus graph-theory metrics. | quote: \"all the fMRI images are preprocessed by the Data Processing Assistant for Resting- State fMRI (DPARSF) software (Cui et al., 2015) (http://d.rnet. co/DPABI/DPABI_V2.3_170105.zip). The whole preprocessing procedures include:(1) Converting DICOM to NIFTI, (2) Removing the ﬁrst 10 time points, (3) Slicing timing, (4) Realigning, (5) Normalizing with the echo-planar imaging (EPI) template, (6) Smoothing, (7) Removing the linear trend, (8) Temporal ﬁltering, (9) Removing covariates.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-027" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1239 ;
            slr:answer_text "CCS (Connectome Computation System) pipeline (slice timing, motion realignment, global intensity normalisation, global signal regression + bandpass filter strategy); ReHo derivative used, no ROI atlas (voxel-wise) | quote: \"we downloaded fMRI data (derivatives) pro- cessed with the Connectome Computation System (CCS) pipeline [9] which performs slice timing correction, motion realignment and global intensity normalisation.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-063" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1166 ;
            slr:answer_text "C-PAC pipeline; AAL atlas, first 90 ROIs as network nodes | quote: \"Using automated anatomical labeling (AAL), we then used the ﬁrst 90 regions of interest (ROIs) as nodes\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-078" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1215 ;
            slr:answer_text "Four Preprocessed Connectomes Project pipelines compared: CCS, C-PAC, DPARSF, NIAK; no ROI atlas used (whole-volume images rather than ROI connectivity). | quote: \"Selected strategies are Connectome Computation System (CCS), Conﬁgurable Pipeline for the Analysis of Con- nectomes (CPAC), Data Processing Assistant for Resting-State fMRI (DPARSF) and Neuroimaging Analysis Kit (NIAK).\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-036" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1169 ;
            slr:answer_text "C-PAC pipeline (Preprocessed Connectomes Project) for rs-fMRI; FreeSurfer for structural; 100-region Schaefer-Yeo cortical parcellation atlas for connectivity | quote: \"For the resting-state functional brain scans in ABIDE, we built on data previously made available by the Preprocessed Connectomes initiative (http://preprocessed-connectomes- project.org/abide). The preprocessing was performed with C-PAC (https://fcp-indi.github.io) and included slice time correction, head motion correction, skull stripping, and intensity nor- malization. The rs-fMRI data were detrended and adjusted for common nuisance effects related to head motion, white matter, and cerebrospinal fluid signals using CompCor [58], fol- lowed by band-pass filtering (0.01 to 0.1 Hz).\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-011" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1180 ;
            slr:answer_text "C-PAC pipeline; Harvard-Oxford atlas (110 ROIs). | quote: \"We, subsequently, extract the mean time series for a set of regions from the Harvard Oxford (HO) atlas comprising R = 110 cortical and subcortical ROIs\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-024" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1165 ;
            slr:answer_text "Custom preprocessing pipeline (slice-timing, 24-parameter motion regression, CompCor, detrending, band-pass filter, FSL BBR + ANTs registration); Harvard-Oxford atlas for cluster labelling; ComBat used for site harmonisation across ABIDE I/II collections | quote: \"R-fMRI image pre-processing steps included: slice time correction, 24 motion param- eters regression [57], component-based noise reduction (CompCor) [58], removal of linear and quadratic trends, and band-pass filtering (0.01–0.1 Hz, for all metrics but fALFF).\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-008" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1188 ;
            slr:answer_text "CPAC pipeline (slice timing, motion correction, nuisance regression, band-pass filtering); three atlases (AAL, CC, EZ) used to build Pearson-correlation connectivity matrices. | quote: \"The data is preprocessed using the Conﬁgurable Pipeline for the Analysis of Connectomes (CPAC) pipeline, which includes essential steps such as slice timing correction, voxel intensity normalization, motion correction, nuisance signal removal, global signal regression, band-pass ﬁltering, and spatial registration.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-064" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1168 ;
            slr:answer_text "SPM8 and DPARSF pipeline; AAL atlas. | quote: \"it was based on the automated anatomical labeling (AAL) template extract the averaged fMRI time series\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-044" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1251 ;
            slr:answer_text "Not applicable — raw/minimally processed data release, no connectivity pipeline or atlas applied by this paper" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-001" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1176 ;
            slr:answer_text "No connectivity pipeline/atlas used; SPM8 realignment applied to raw scans to extract 6 rigid-body head-motion parameters, which are themselves the analysed signal. | quote: \"The output with the six motion parameters (3 translations in x, y, z directions,  and 3 rotations: pitch (about x-axis), roll (about y-axis), and yaw (about z-axis)) is recor\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-047" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1175 ;
            slr:answer_text "Preprocessed Connectomes Project, CPAC pipeline (slice timing correction, motion correction, voxel intensity normalisation, nuisance regression with 24 motion parameters, CompCor, band-pass filter 0.01-10Hz); CC400 functional parcellation atlas. | quote: \"The Preprocessed Connectomes Project (PCP) is a publicly available preprocessed version of data from both the 1,000 Functional Connectomes Project (FCP) and the International Neuroimaging Data-Sharing Initiative (INDI)3. We used data from the FCP using the conﬁgurable pipeline, the Analysis of Connectomes (CPAC).\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
            slr:question_id "RQ2" ;
            slr:source_id "S-022" ] ;
    slr:question_id "RQ2" ;
    slr:question_text "Which preprocessing pipeline (e.g. Preprocessed Connectomes Project CPAC/DPARSF/NIAK/CCS, strategy) and atlas/parcellation were used?" ;
    slr:theme "Processing" .

