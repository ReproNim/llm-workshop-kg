            slr:source_id "S-072" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1219 ;
            slr:answer_text """Partly — eight functional subnetworks (CB, VN, SMN, DAN, VAN, LN, FPN, DMN) named for the ASD analysis, but the specific ROI atlas is not stated for ABIDE | quote: "For ASD, the ROIs of the dataset can be divided into
eight functional subnetworks: cerebellum and subcortical
structure (CB), visual network (VN), somatic motor network
(SMN), dorsal attention network (DAN), ventral attention
network (VAN), edge network (LN), frontoparietal network
(FPN), and default mode network (DMN).\"""" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
            slr:source_id "S-049" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1253 ;
            slr:answer_text "Yes — Shen 268-node functional atlas. | quote: \"A functionally defined atlas, consisting of 268 cortical and subcortical regions-of-interest (‘nodes’)\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl4-atlas-parcellation-reported> ;
