        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1235 ;
            slr:answer_text "Yes — AAL atlas (116 ROIs; 22 DMN ROIs used). | quote: \"The  automated anatomical labelling (AAL) is selected as the standard brain atlas to divide the brain into 116 regions of  interest (ROIs)\"" ;
