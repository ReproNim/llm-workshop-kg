        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1176 ;
            slr:answer_text "Yes | quote: \"Note that these group differences held independently for NYU, UCLA_1,  OLIN, and PITT sites and are presented for both linear speed (LS) and angular speed (AS) micro-movements\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl6-site-handling-reported-site-covariate-harmonisation-e-g> ;
