        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1227 ;
            slr:answer_text "Yes — CC200, 200-region parcellation. | quote: \"We extracted rsfMRI time series using a 200-region parcellation CC200[?]\"" ;
