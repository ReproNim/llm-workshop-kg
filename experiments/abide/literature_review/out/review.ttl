            slr:source_id "S-039" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1242 ;
            slr:answer_text "ABIDE I — subjects selected by matching one specific MRI acquisition protocol (3.0T Siemens, TR=3000ms, TE=28ms) across the database (61 ASD/46 TC met the protocol); after excluding 7 TC and 16 ASD for motion >2mm translation or >2deg rotation, the final analysed sample was 45 ASD/39 TC (n=84). | quote: \"TABLE 1 | Basic information of ASD and TC. Variables (Mean ± SD) Autism (n = 45) TC (n = 39) P value Gender (M/F) 41/4 33/6 0.359 Age (years) 13.4 ± 2.4 12.9 ± 1.7 0.278 ASD, Autism spectrum disorder; TC, typical controls.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ1> ;
            slr:question_id "RQ1" ;
            slr:source_id "S-027" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1188 ;
            slr:answer_text "ABIDE I, 505 autistic individuals and 530 typical controls; after preprocessing and quality control the final analysed dataset was 1,035 samples; no explicit exclusion-rule text beyond mentioning QC. | quote: \"The rs-fMRI data used in this study were sourced from the ABIDE I dataset, comprising 505 autistic individuals and 530 typical controls (TCs).\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ1> ;
            slr:question_id "RQ1" ;
            slr:source_id "S-064" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1253 ;
            slr:answer_text """ABIDE-II, two sites (GU n=82, KK n=194 before exclusion); final combined n=276 (85 ASD/191 TD), ages 8-13; excluded for missing behavioral data (n=9), behavioral outliers (>3SD) or inconsistency (>7), and >4mm maximum absolute head-motion displacement (26 participants). | quote: "Twenty-six participants had excessive head motion on their fMRI scan (>4 mm maximum absolute 
20 
displacement).\"""" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ1> ;
