            slr:relevance_score "0.5"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "The dataset brings together 1,112 subjects (539 ASD patients and 573 TCs) from 17 sites around worldwide" ] ;
