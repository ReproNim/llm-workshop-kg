        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1260 ;
            slr:answer_text "No pipeline or atlas/parcellation reported; the paper uses MRI-derived images/heat maps directly as CNN/transfer-learning input with no stated connectivity feature extraction" ;
