        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "The original ABIDE dataset claimed to have 1112 subjects consisting of 539 ASD and 573 Healthy controls subjects. However, after removing subjects with missing information we have a total of 1035 subjects which is" ] ;
