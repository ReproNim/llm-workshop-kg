        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1199 ;
            slr:answer_text "Slice-time and motion correction, MNI registration, bandpass filter (0.009-0.08Hz), 6mm FWHM smoothing (no named pipeline/version given); first 90 AAL ROIs as nodes. | quote: \"We then use the ﬁrst 90 AAL ROIs as nodes, and take the average of all voxels’ temporal proﬁles within each ROI as region level signal for all subjects\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ2> ;
