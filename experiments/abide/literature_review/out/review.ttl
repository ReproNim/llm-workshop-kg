        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1195 ;
            slr:answer_text "Hypoconnectivity: decreased inter- and intra-hemispheric FCD in ASD vs TDC in posterior cingulate cortex, lingual/parahippocampal gyrus, and postcentral gyrus; ADOS-RRB scores negatively correlated with FCD in these regions" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:RQ5> ;
