        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1200 ;
            slr:answer_text "Partly — 5-fold stratified cross-validation and permutation significance testing are used, but no explicit statement that feature/hyperparameter selection (grid search) was confined strictly within training folds only. | quote: \"For both models, parameter estimation is done using grid search.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl5-leakage-control-reported-feature-selection-scaling-harmo> ;
