        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "To allow the reproducibility of the analysis, the identification numbers (IDs) of the participants selected in the final sample are reported in Additional file 1." ] ;
            oa:hasTarget <https://doi.org/10.1186/s40708-023-00217-4> ;
            slr:claim_label "Participant IDs of the final sample are published in supplementary material for reproducibility." ;
            slr:relevance_score "0.9"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "we used a leave-site-out approach for our proposed CNN, SVM, KNN, and RF classiﬁers (Heinsfeld et al., 2018). In this method, each site is taken as one fold in the dataset, and we applied a cross-validation approach on the remaining sites instead of diﬀerent folds. Therefore, each time, one site out of 17 is used to test, and the other sites are used for training." ] ;
            oa:hasTarget <https://doi.org/10.3389/fnins.2019.01325> ;
            slr:claim_label "Performance was also evaluated using a leave-site-out approach across the 17 ABIDE I sites." ;
            slr:relevance_score "0.9"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "We report 5-fold cross validation mean F1-score and accuracy for the experiments in Table 1." ] ;
            oa:hasTarget <https://doi.org/10.1007/978-3-030-32695-1_11> ;
            slr:claim_label "Evaluation uses 5-fold cross-validation (no leave-site-out scheme described)." ;
            slr:relevance_score "0.7"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "When repeating the intersubject similarity analysis for the 27 ABIDE participants, we  obtained similar results as those for the within ASD group i.e. only the VTL subnetwork  showed significant correlation between subnetwork intersubject similarity and joint ADI- R/ADOS score similarity (p=0.0287) with moderate effect size (r = 0.17, Figure S4)." ] ;
            oa:hasTarget <https://doi.org/10.1002/hbm.23084> ;
            slr:claim_label "In the ABIDE replication cohort, ventro-temporal-limbic (VTL) subnetwork similarity between ASD subject pairs significantly correlated with ADI-R/ADOS symptom-severity similarity (p=0.0287, r=0.17)." ;
            slr:relevance_score "1.0"^^xsd:float ],
