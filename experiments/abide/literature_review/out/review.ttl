        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1164 ;
            slr:answer_text "Yes | quote: \"We use the Harvard Oxford (HO) atlas [23], so we  have N = 110 nodes.\"" ;
