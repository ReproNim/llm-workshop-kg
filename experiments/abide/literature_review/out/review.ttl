                            slr:justification "Relies on ABIDE's own site-level clinical ASD diagnosis; no additional instrument or validation criterion stated in this paper." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "some" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "CL5 Leakage control reported?" ;
