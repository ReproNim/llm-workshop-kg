        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1209 ;
            slr:answer_text "Yes — SPM8 plus in-house MATLAB pipeline | quote: \"For preprocessing, we used SPM8, a software package designed for analyzing brain imaging data and also for preprocessing fMRI data [27, 28] and our own in-house MATLAB code.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl3-preprocessing-pipeline-and-version-reported> ;
            slr:source_id "S-032" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1188 ;
            slr:answer_text "Yes — CPAC pipeline with its processing steps named. | quote: \"The data is preprocessed using the Conﬁgurable Pipeline for the Analysis of Connectomes (CPAC) pipeline\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl3-preprocessing-pipeline-and-version-reported> ;
            slr:source_id "S-064" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1233 ;
            slr:answer_text "Yes | quote: \"All analyses were performed using the CONN toolbox2 and the Statistical Parametric Mapping 12 software.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl3-preprocessing-pipeline-and-version-reported> ;
            slr:source_id "S-043" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1208 ;
            slr:answer_text "Yes | quote: \"We preprocessed the data with the Conﬁgurable Pipeline for the Analysis of Connectomes (C-PAC) and the fMRI volumes are downsampled to 4 mm in MNI.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl3-preprocessing-pipeline-and-version-reported> ;
            slr:source_id "S-058" ],
        [ a slr:ChartingQuestionAnswer ;
            slr:about_source _:n8cdf5207cb25495c891b44af156133bfb1256 ;
            slr:answer_text "Yes — the open-source fconn1000 pipeline is named with a link to the exact code version used. | quote: \"The IMPAC fMRI and sMRI were processed using the fconn1000 ­pipeline41. For the fMRI connectivity features, the TSE connectivity metric was fit on either the training data alone (IMPAC models) or the entire IMPAC dataset (ABIDE 1 and 2 datasets), and the TSE values per-ROI timeseries for the ABIDE dataset were calculated.\"" ;
            slr:answers_question <urn:synthscholar:review:review_local_20261015_abide_rsfmri:question:cl3-preprocessing-pipeline-and-version-reported> ;
