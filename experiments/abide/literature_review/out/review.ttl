            slr:claim_label "ABIDE and ADHD-200 datasets used are both publicly available online." ;
            slr:relevance_score "0.6"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """We subsequently applied 
dual-regression analysis18 by using the FSL general linear model (GLM) and the 10-brain resting-state networks 
(RSN10), “PNAS_Smith09_rsn10.nii.gz,” provided by Smith et. al.19,20 as a reference.""" ] ;
            oa:hasTarget <https://doi.org/10.1038/s41598-019-45465-9> ;
