            slr:claim_label "DeepASD is evaluated on ABIDE data with four modalities." ;
            slr:relevance_score "0.7"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value """Site-speciﬁc analysis was applied on the ADHD dataset. We
