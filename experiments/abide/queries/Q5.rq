PREFIX ex: <urn:repronim:abide:>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX nidm: <http://purl.org/nidash/nidm#>
PREFIX ndar: <https://ndar.nih.gov/api/datadictionary/v2/dataelement/>
SELECT ?kind (COUNT(DISTINCT ?e) AS ?nFlagged) WHERE { GRAPH <urn:repronim:abide:graph/core> {
  VALUES ?kind { ex:Result ex:Claim ex:EvidenceAssessment }
  ?act a prov:Activity . ?e ex:flaggedForReassessmentBy ?act ; a ?kind .
} } GROUP BY ?kind