PREFIX ex: <urn:repronim:abide:>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX nidm: <http://purl.org/nidash/nidm#>
PREFIX ndar: <https://ndar.nih.gov/api/datadictionary/v2/dataelement/>
SELECT ?scope ?level ?consent ?egress ?lake ?policy WHERE { GRAPH <urn:repronim:abide:graph/scope> { ex:participantRecords ex:knowledgeScope ?scope ;
        ex:pondLevel ?level ; ex:hasSensitivityProfile ?p ; ex:lakeCopy ?lake ; ex:promotionPolicy ?policy . ?p ex:consentScope ?consent ; ex:egressPermitted ?egress } }