PREFIX ex: <urn:repronim:abide:>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX nidm: <http://purl.org/nidash/nidm#>
PREFIX ndar: <https://ndar.nih.gov/api/datadictionary/v2/dataelement/>
SELECT ?fid ?site ?dx ?sex ?var ?value ?thick ?conn WHERE {
  GRAPH <urn:repronim:abide:graph/core> { <urn:repronim:abide:cohort/B_v1> prov:hadMember ?p . ?p rdfs:label ?fid . }
  GRAPH <urn:repronim:abide:graph/view/phenotype_matrix> { ?p ex:site ?site ; <urn:repronim:abide:variable/DX_GROUP> ?dx ; <urn:repronim:abide:variable/SEX> ?sex .
    OPTIONAL { VALUES ?var { <urn:repronim:abide:variable/AGE_AT_SCAN> <urn:repronim:abide:variable/FIQ> <urn:repronim:abide:variable/VIQ>
                               <urn:repronim:abide:variable/PIQ> <urn:repronim:abide:variable/SRS_RAW_TOTAL> } ?p ?var ?value } }
  OPTIONAL { GRAPH <urn:repronim:abide:graph/core> { ?idp ex:participant ?p ; ex:meanCorticalThickness ?thick } }
  OPTIONAL { GRAPH <urn:repronim:abide:graph/core> { ?c ex:participant ?p ; ex:meanFisherZ ?conn } }
}