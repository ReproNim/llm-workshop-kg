PREFIX ex: <urn:repronim:abide:>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX nidm: <http://purl.org/nidash/nidm#>
PREFIX ndar: <https://ndar.nih.gov/api/datadictionary/v2/dataelement/>
CONSTRUCT { ?s ?p ?o } WHERE { GRAPH <urn:repronim:abide:graph/core> {
  { BIND(<urn:repronim:abide:participant/MaxMun_c_0051332> AS ?s) ?s ?p ?o }
  UNION { ?s ex:participant <urn:repronim:abide:participant/MaxMun_c_0051332> ; ?p ?o }
  UNION { ?s prov:hadMember <urn:repronim:abide:participant/MaxMun_c_0051332> ; ?p ?o FILTER (?p != prov:hadMember) }
  UNION { ?a prov:qualifiedAssociation ?as . ?as prov:agent <urn:repronim:abide:participant/MaxMun_c_0051332> . BIND(?a AS ?s) ?s ?p ?o FILTER (?p != prov:used) }
  UNION { ?c ex:participant <urn:repronim:abide:participant/MaxMun_c_0051332> . ?s ex:testedOn ?c ; ?p ?o FILTER (?p NOT IN (ex:testedOn, ex:trainedOn)) }
} }