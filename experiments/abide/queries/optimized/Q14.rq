# base
PREFIX ex: <urn:repronim:abide:>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX nidm: <http://purl.org/nidash/nidm#>
PREFIX ndar: <https://ndar.nih.gov/api/datadictionary/v2/dataelement/>
SELECT ?p ?site ?dx WHERE { GRAPH <urn:repronim:abide:graph/core> { ?rec a nidm:AcquisitionObject ; ex:participant ?p ; <urn:repronim:abide:variable/DX_GROUP> ?dx . ?p ex:site ?site } }

# AGE_AT_SCAN
PREFIX ex: <urn:repronim:abide:>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX nidm: <http://purl.org/nidash/nidm#>
PREFIX ndar: <https://ndar.nih.gov/api/datadictionary/v2/dataelement/>
SELECT DISTINCT ?p WHERE { GRAPH <urn:repronim:abide:graph/core> { ?rec <urn:repronim:abide:variable/AGE_AT_SCAN> ?x ; ex:participant ?p } }

