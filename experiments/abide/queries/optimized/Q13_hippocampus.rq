PREFIX ex: <urn:repronim:abide:>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX nidm: <http://purl.org/nidash/nidm#>
PREFIX ndar: <https://ndar.nih.gov/api/datadictionary/v2/dataelement/>
SELECT ?tool ?v WHERE { GRAPH <urn:repronim:abide:graph/view/volumes> { ?o ex:participant <urn:repronim:abide:participant/MaxMun_c_0051332> ; ex:tool ?tool ; ex:region <http://purl.obolibrary.org/obo/UBERON_0001954> ;
        ex:side ?side ; ex:volume ?v . FILTER (STRENDS(STR(?side), "Left")) } }