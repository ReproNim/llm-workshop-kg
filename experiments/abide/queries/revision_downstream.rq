PREFIX ex: <urn:repronim:abide:>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dct: <http://purl.org/dc/terms/>

SELECT DISTINCT ?entity ?kind WHERE { GRAPH <urn:repronim:abide:graph/core_v1> {
  ?new prov:wasRevisionOf ?old .
  ?sel prov:used ?old . ?cohort prov:wasGeneratedBy ?sel .
  {
    ?analysis prov:used ?cohort .
    { ?entity prov:wasGeneratedBy ?analysis . BIND("result" AS ?kind) }
    UNION { ?fold dct:isPartOf ?analysis . ?entity prov:wasGeneratedBy ?fold . BIND("fold_result" AS ?kind) }
    UNION { ?fold dct:isPartOf ?analysis . ?r prov:wasGeneratedBy ?fold . ?entity prov:wasDerivedFrom ?r . BIND("pooled_result" AS ?kind) }
  }
  UNION
  {
    ?analysis prov:used ?cohort .
    { ?r prov:wasGeneratedBy ?analysis } UNION { ?fold dct:isPartOf ?analysis . ?fr prov:wasGeneratedBy ?fold . ?r prov:wasDerivedFrom ?fr }
    ?entity prov:wasDerivedFrom+ ?r .
    ?entity a ?t . FILTER (?t IN (ex:Claim, ex:EvidenceAssessment))
    BIND("claim_or_review" AS ?kind)
  }
  UNION
  { ?entity prov:wasDerivedFrom ?cohort . BIND("result" AS ?kind) }
} }