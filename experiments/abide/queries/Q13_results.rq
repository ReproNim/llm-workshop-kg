PREFIX ex: <urn:repronim:abide:>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX nidm: <http://purl.org/nidash/nidm#>
PREFIX ndar: <https://ndar.nih.gov/api/datadictionary/v2/dataelement/>
SELECT DISTINCT ?result ?label WHERE { GRAPH <urn:repronim:abide:graph/core> { ?c ex:participant <urn:repronim:abide:participant/MaxMun_c_0051332> ; a nidm:DerivativeObject .
        { ?an prov:used ?c . ?result prov:wasGeneratedBy ?an } UNION { ?f ex:testedOn ?c . ?result prov:wasGeneratedBy ?f }
        OPTIONAL { ?result rdfs:label ?label } } }